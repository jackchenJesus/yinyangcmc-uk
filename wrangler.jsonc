{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yinyangcmc-uk",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-17",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  }
}
