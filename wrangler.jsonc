{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yinyangcmc-uk",
  "compatibility_date": "2026-08-17",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "yinyangcmc.uk",
      "zone_name": "yinyangcmc.uk",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
