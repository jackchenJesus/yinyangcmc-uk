---
import { clinics, site } from "../data/site";
---
<footer class="site-footer">
  <div class="wrap foot-grid">
    <div>
      <h3>Yin Yang CMC</h3>
      <p>Modern TCM & Wellness Centre. Hong Kong clinical standards in Wimbledon and Reading.</p>
      <p><a href={`mailto:${site.email}`}>{site.email}</a><br />
      <a href={`tel:${site.phoneIntl}`}>+44 {site.phoneDisplay}</a></p>
    </div>
    <div>
      <h4>Reading</h4>
      <p>{clinics.reading.address}<br />{clinics.reading.hours}</p>
    </div>
    <div>
      <h4>Wimbledon</h4>
      <p>{clinics.wimbledon.address}<br />{clinics.wimbledon.hours}</p>
    </div>
  </div>
  <div class="wrap legal">
    <span>© {site.year}. Yin Yang CMC All rights reserved.</span>
    <a href="/privacy-terms-and-conditions">Privacy | Terms and Conditions</a>
  </div>
</footer>
