---
import { site } from "../data/site";
import { liveConditions } from "../data/conditions";
---
<footer class="site-footer">
  <div class="wrap">
    <div class="foot-grid">

      <!-- Col 1: Brand -->
      <div class="foot-brand">
        <img src="/images/ming_logo-full-7UbV6e2W5oyjr2Ir.png" alt="Yin Yang CMC" />
        <p class="foot-tagline">Professional Chinese Medicine<br />in Wimbledon &amp; Reading</p>
        <nav class="foot-contact" aria-label="Contact">
          <a href={`tel:${site.phoneIntl}`}>{site.phoneDisplay}</a>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </nav>
      </div>

      <!-- Col 2: Services -->
      <div>
        <h5>Services</h5>
        <nav class="foot-links" aria-label="Footer services">
          <a href="/clinical-services">All Clinical Services</a>
          <a href="/acupuncture">Acupuncture</a>
          <a href="/tui-na-massage">Tui Na Massage</a>
          <a href="/bone-setting">Bone Setting</a>
          <a href="/herbal-consultation">Herbal Medicine</a>
        </nav>
      </div>

      <!-- Col 3: Conditions -->
      <div>
        <h5>Conditions</h5>
        <nav class="foot-links" aria-label="Footer conditions">
          {liveConditions.map((c) => (
            <a href={c.href}>{c.label}</a>
          ))}
          <a href="/conditions">All Conditions</a>
        </nav>
      </div>

      <!-- Col 4: Clinics & Info -->
      <div>
        <h5>Clinics</h5>
        <nav class="foot-links" aria-label="Footer clinics">
          <a href="/reading-clinic">Reading Clinic</a>
          <a href="/wimbledon-clinic">Wimbledon Clinic</a>
          <a href="/our-practitioners">Our Practitioners</a>
          <a href="/pricing-and-insurance">Pricing &amp; Insurance</a>
          <a href="/contact">Contact Us</a>
          <a href="/locations">All Locations</a>
        </nav>
      </div>

    </div>

    <div class="foot-legal">
      <span>© {site.year} Yin Yang CMC · All rights reserved.</span>
      <a href="/privacy-terms-and-conditions">Privacy &amp; Terms</a>
    </div>
  </div>
</footer>
