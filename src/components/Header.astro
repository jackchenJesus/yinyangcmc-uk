---
import { nav } from "../data/site";
import { conditionCategories, conditionsInCategory } from "../data/conditions";
---
<header class="site-header" id="siteHeader">
  <div class="wrap header-inner">

    <!-- Brand -->
    <a class="brand" href="/">
      <img src="/images/yin-yang-cmc-logo.png" alt="Yin Yang CMC" width="640" height="266" />
    </a>

    <!-- Desktop navigation -->
    <nav aria-label="Main navigation">
      <ul class="main-nav">
        <li class="drop-wrap">
          <button class="nav-btn" aria-expanded="false" aria-haspopup="true">
            Clinical Services
            <svg class="drop-svg" viewBox="0 0 10 6" aria-hidden="true"><polyline points="1 1 5 5 9 1"/></svg>
          </button>
          <div class="drop-menu" role="menu">
            <a class="drop-top" href="/clinical-services" role="menuitem">All Clinical Services</a>
            {nav.services.map((i) => <a href={i.href} role="menuitem">{i.label}</a>)}
          </div>
        </li>
        <li class="drop-wrap mega-wrap">
          <button class="nav-btn" aria-expanded="false" aria-haspopup="true">
            Conditions
            <svg class="drop-svg" viewBox="0 0 10 6" aria-hidden="true"><polyline points="1 1 5 5 9 1"/></svg>
          </button>
          <div class="drop-menu mega-menu" role="menu">
            <div class="mega-cols">
              {conditionCategories.map((cat) => {
                const items = conditionsInCategory(cat.id);
                const split = cat.id === "pain-msk" && items.length > 8;
                const mid = Math.ceil(items.length / 2);
                return (
                  <div class={split ? "mega-col mega-col-wide" : "mega-col"}>
                    <a class="mega-col-label" href={`/conditions#${cat.id}`}>{cat.short}</a>
                    {split ? (
                      <div class="mega-split">
                        <div class="mega-subcol">
                          {items.slice(0, mid).map((i) => (
                            <a href={i.href} role="menuitem">{i.label}</a>
                          ))}
                        </div>
                        <div class="mega-subcol">
                          {items.slice(mid).map((i) => (
                            <a href={i.href} role="menuitem">{i.label}</a>
                          ))}
                        </div>
                      </div>
                    ) : (
                      items.map((i) => (
                        <a href={i.href} role="menuitem">{i.label}</a>
                      ))
                    )}
                  </div>
                );
              })}
            </div>
            <a class="mega-foot" href="/conditions" role="menuitem">All Conditions →</a>
          </div>
        </li>
        <li class="drop-wrap">
          <button class="nav-btn" aria-expanded="false" aria-haspopup="true">
            Our Locations
            <svg class="drop-svg" viewBox="0 0 10 6" aria-hidden="true"><polyline points="1 1 5 5 9 1"/></svg>
          </button>
          <div class="drop-menu" role="menu">
            <a class="drop-top" href="/locations" role="menuitem">All Locations</a>
            {nav.locations.map((i) => <a href={i.href} role="menuitem">{i.label}</a>)}
          </div>
        </li>
        <li><a class="nav-link" href="/our-practitioners">Practitioners</a></li>
        <li><a class="nav-link" href="/pricing-and-insurance">Pricing &amp; Insurance</a></li>
        <li><a class="nav-link" href="/course">Course</a></li>
        <li><a class="nav-link" href="/contact">Contact</a></li>
      </ul>
    </nav>

    <!-- Desktop CTA -->
    <div class="header-right">
      <a class="btn btn-gold btn-sm" href="https://wa.me/447301949686" target="_blank" rel="noreferrer">Book Now</a>
    </div>

    <!-- Burger -->
    <button class="burger" id="burgerBtn" aria-label="Open menu" aria-expanded="false" aria-controls="mobileNav">
      <span></span><span></span><span></span>
    </button>

  </div>
</header>

<!-- Mobile navigation overlay -->
<nav class="mobile-nav" id="mobileNav" aria-label="Mobile navigation" aria-hidden="true">
  <div class="mob-group">
    <span class="mob-label">Clinical Services</span>
    <a href="/clinical-services">All Clinical Services</a>
    {nav.services.map((i) => <a href={i.href}>{i.label}</a>)}
  </div>
  <div class="mob-group">
    <span class="mob-label">Conditions</span>
    <a href="/conditions">All Conditions</a>
    {conditionCategories.map((cat) => (
      <>
        <span class="mob-sublabel">{cat.short}</span>
        {conditionsInCategory(cat.id).map((i) => <a href={i.href}>{i.label}</a>)}
      </>
    ))}
  </div>
  <div class="mob-group">
    <span class="mob-label">Our Locations</span>
    <a href="/locations">All Locations</a>
    {nav.locations.map((i) => <a href={i.href}>{i.label}</a>)}
  </div>
  <div class="mob-group">
    <span class="mob-label">More</span>
    <a href="/our-practitioners">Our Practitioners</a>
    <a href="/pricing-and-insurance">Pricing &amp; Insurance</a>
    <a href="/course">Course</a>
    <a href="/contact">Contact</a>
  </div>
  <div class="mob-ctas">
    <a class="btn btn-gold" href="https://wa.me/447301949686" target="_blank" rel="noreferrer">Book Now on WhatsApp</a>
  </div>
</nav>

<script>
  // Scroll shadow
  const header = document.getElementById("siteHeader")!;
  window.addEventListener("scroll", () => {
    header.classList.toggle("scrolled", window.scrollY > 10);
  }, { passive: true });

  // Burger / mobile menu
  const burger    = document.getElementById("burgerBtn")!;
  const mobileNav = document.getElementById("mobileNav")!;
  burger.addEventListener("click", () => {
    const open = mobileNav.classList.toggle("open");
    burger.setAttribute("aria-expanded", String(open));
    mobileNav.setAttribute("aria-hidden",  String(!open));
    document.body.style.overflow = open ? "hidden" : "";
  });
  mobileNav.querySelectorAll("a").forEach((a) =>
    a.addEventListener("click", () => {
      mobileNav.classList.remove("open");
      burger.setAttribute("aria-expanded", "false");
      mobileNav.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
    })
  );

  // Desktop dropdown toggle (button click)
  document.querySelectorAll<HTMLElement>(".drop-wrap").forEach((wrap) => {
    const btn = wrap.querySelector("button");
    if (!btn) return;
    btn.addEventListener("click", (e) => {
      e.stopPropagation();
      const isOpen = wrap.classList.toggle("open");
      btn.setAttribute("aria-expanded", String(isOpen));
      // Close siblings
      document.querySelectorAll<HTMLElement>(".drop-wrap.open").forEach((other) => {
        if (other !== wrap) {
          other.classList.remove("open");
          other.querySelector("button")?.setAttribute("aria-expanded", "false");
        }
      });
    });
  });

  // Close dropdowns when clicking outside
  document.addEventListener("click", () => {
    document.querySelectorAll<HTMLElement>(".drop-wrap.open").forEach((wrap) => {
      wrap.classList.remove("open");
      wrap.querySelector("button")?.setAttribute("aria-expanded", "false");
    });
  });

  // Keyboard: close on Escape
  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape") return;
    document.querySelectorAll<HTMLElement>(".drop-wrap.open").forEach((w) => {
      w.classList.remove("open");
      w.querySelector("button")?.setAttribute("aria-expanded", "false");
    });
    if (mobileNav.classList.contains("open")) {
      mobileNav.classList.remove("open");
      burger.setAttribute("aria-expanded", "false");
      mobileNav.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
    }
  });
</script>
