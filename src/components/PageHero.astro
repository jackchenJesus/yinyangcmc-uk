---
interface Props {
  title: string;
  lede?: string;
  eyebrow?: string;
  bgImage?: string;
  ctaLabel?: string;
  ctaHref?: string;
  ctaSecLabel?: string;
  ctaSecHref?: string;
}
const {
  title,
  lede,
  eyebrow    = "Yin Yang CMC · UK",
  bgImage    = "/images/acupuncture-back-treatment.webp",
  ctaLabel   = "Book a Consultation",
  ctaHref    = "https://wa.me/447301949686",
  ctaSecLabel,
  ctaSecHref,
} = Astro.props;
---
<section class="page-hero">
  <img class="page-hero-bg" src={bgImage} alt="" width="1600" height="1067" loading="eager" fetchpriority="high" />
  <div class="wrap">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    {lede && <p class="lede">{lede}</p>}
    <div class="actions" style="margin-top:1.4rem">
      <a
        class="btn btn-gold"
        href={ctaHref}
        target={ctaHref.startsWith("http") ? "_blank" : undefined}
        rel={ctaHref.startsWith("http") ? "noreferrer" : undefined}
      >{ctaLabel}</a>
      {ctaSecLabel && ctaSecHref && (
        <a class="btn btn-ghost" href={ctaSecHref}>{ctaSecLabel}</a>
      )}
    </div>
  </div>
</section>
