---
interface FAQItem {
  q: string;
  a: string;
}
interface Props {
  items: FAQItem[];
  includeSchema?: boolean;
}
const { items, includeSchema = true } = Astro.props;
---
<div class="faq-list" itemscope={includeSchema ? true : undefined} itemtype={includeSchema ? "https://schema.org/FAQPage" : undefined}>
  {items.map(({ q, a }) => (
    <details
      class="faq-item"
      itemscope={includeSchema ? true : undefined}
      itemprop={includeSchema ? "mainEntity" : undefined}
      itemtype={includeSchema ? "https://schema.org/Question" : undefined}
    >
      <summary>
        <span itemprop={includeSchema ? "name" : undefined}>{q}</span>
        <em class="faq-chevron" aria-hidden="true">+</em>
      </summary>
      <div
        class="faq-answer"
        itemscope={includeSchema ? true : undefined}
        itemprop={includeSchema ? "acceptedAnswer" : undefined}
        itemtype={includeSchema ? "https://schema.org/Answer" : undefined}
      >
        <p itemprop={includeSchema ? "text" : undefined} set:html={a} />
      </div>
    </details>
  ))}
</div>

<script>
  document.querySelectorAll<HTMLDetailsElement>(".faq-item").forEach((item) => {
    item.addEventListener("toggle", () => {
      const chevron = item.querySelector<HTMLElement>(".faq-chevron");
      if (chevron) chevron.textContent = item.open ? "−" : "+";
    });
  });
</script>
