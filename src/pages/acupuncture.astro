---
import Base from "../layouts/Base.astro";
import FAQAccordion from "../components/FAQAccordion.astro";
import CTASection from "../components/CTASection.astro";

const faqItems = [
  {
    q: "Is acupuncture painful?",
    a: "The needles used are extremely fine — typically 0.25 mm diameter, far thinner than a hypodermic needle. Most patients describe a mild aching or warmth at the insertion point rather than pain. All sessions are conducted by a British Acupuncture Council registered practitioner throughout.",
  },
  {
    q: "How many sessions will I need?",
    a: "This depends on the condition, how long symptoms have been present, and your individual response. Acute conditions may show improvement within 2–4 sessions. Chronic or regulatory conditions are typically assessed over a 6–8 session course. Your practitioner will discuss a realistic timeline at your initial assessment and will not prescribe a fixed number of sessions in advance.",
  },
  {
    q: "Are your practitioners registered in the UK?",
    a: "Yes. Both practitioners are registered members of the British Acupuncture Council (MBAcC), which is listed on the Professional Standards Authority's Accredited Register — providing independent assurance of professional standards in health and care. They are also registered with the Association of Traditional Chinese Medicine & Acupuncture (ATCM). Member nos: 963087 & 963093.",
  },
  {
    q: "Do you accept health insurance?",
    a: "Yes. We are recognised by AXA Health, Vitality, Aviva and WPA. Cover depends on your individual policy and insurer requirements, and usually relates to eligible acupuncture treatment — not automatically to Tui Na, bone setting or herbal consultation. Please check with your insurer before treatment. Provider numbers are on our Pricing & Insurance page.",
  },
  {
    q: "Can I receive acupuncture alongside my NHS or GP treatment?",
    a: "In the vast majority of cases, yes. During your initial consultation we review your current medications and ongoing treatments to identify any clinical considerations. We will advise you to consult your GP if there is any clinical uncertainty.",
  },
  {
    q: "Do you offer consultations in Cantonese or Mandarin?",
    a: "Yes. All practitioners are fluent in Cantonese and Mandarin. If you have previous medical records or TCM case notes in Chinese, we can review these directly — no translation loss, full clinical precision.",
  },
];
---
<Base
  title="Acupuncture Wimbledon & Reading | Expert Pain Relief Clinic | Yin Yang CMC"
  description="Professional acupuncture in Wimbledon & Reading. British Acupuncture Council registered practitioners with 15+ years' experience. No referral needed."
>


<!-- ═══════════════════════════════════════════════
     §1 HERO
═══════════════════════════════════════════════ -->
<section class="page-hero" style="min-height:68vh;display:grid;place-items:center">
  <img
    class="page-hero-bg"
    src="/images/webbanner-eQwGJSc8Re6udP6z.jpg"
    alt="Yin Yang CMC acupuncture clinic"
    loading="eager"
    fetchpriority="high"
  />
  <div class="wrap" style="padding:5rem 0 3.5rem">
    <p class="eyebrow">Acupuncture · Reading &amp; Wimbledon</p>
    <h1>Acupuncture in<br>Wimbledon &amp; Reading</h1>
    <p class="lede">
      Evidence-conscious acupuncture for pain, stress, and systemic health —
      delivered by British Acupuncture Council registered practitioners.
    </p>

    <div class="hero-exp-stat">
      <span class="hero-exp-num">15+</span>
      <span class="hero-exp-label">Years'<br>Clinical Experience</span>
    </div>

    <div class="actions" style="margin-top:0">
      <a class="btn btn-gold" href="https://wa.me/447301949686" target="_blank" rel="noreferrer">Book a Consultation</a>
      <a class="btn btn-ghost" href="/clinical-services">All Clinical Services</a>
    </div>

    <div class="hero-trust-row">
      <span><span class="htc">✓</span> British Acupuncture Council Member</span>
      <span><span class="htc">✓</span> PSA Accredited Register</span>
      <span><span class="htc">✓</span> Insurance Recognised</span>
      <span><span class="htc">✓</span> No Referral Needed</span>
    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════
     §2 WHAT IS ACUPUNCTURE
═══════════════════════════════════════════════ -->
<section class="section-soft">
  <div class="wrap">
    <div class="grid-2-al" style="gap:4rem">

      <div>
        <p class="eyebrow">About the Treatment</p>
        <h2>What Is Acupuncture?</h2>
        <p>
          Acupuncture involves the precise insertion of ultra-fine sterile needles into
          specific anatomical points on the body. Needle stimulation activates nerve fibres,
          supporting the regulation of pain signals, the autonomic nervous system, and
          local tissue response.
        </p>
        <p>
          At Yin Yang CMC, every session begins with a reassessment of your presenting symptoms.
          Point selection is not fixed between appointments — it responds to your current
          clinical picture, combining traditional pulse and tongue diagnosis with modern
          musculoskeletal assessment.
        </p>

        <ul style="list-style:none;padding:0;margin:1.5rem 0 0;display:grid;gap:0.5rem">
          {[
            "Ultra-fine single-use sterile needles throughout",
            "Needle retention typically 20–30 minutes per session",
            "No GP referral required",
            "Same-week appointments at Reading and Wimbledon",
          ].map((item) => (
            <li style="display:flex;gap:0.6rem;align-items:flex-start;font-size:0.92rem">
              <span style="color:var(--gold);font-weight:700;flex-shrink:0;margin-top:0.05em">✓</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>

        <div class="actions" style="margin-top:1.8rem">
          <a class="btn btn-gold" href="https://wa.me/447301949686" target="_blank" rel="noreferrer">Book a Consultation</a>
          <a class="btn btn-outline" href="/pricing-and-insurance">Pricing &amp; Insurance</a>
        </div>
      </div>

      <div class="img-wrap" style="position:relative">
        <img
          src="/images/adobestock_88537046-low-My8DbSswqH0l0J9t.jpg"
          alt="Acupuncture treatment at Yin Yang CMC"
          style="width:100%;height:460px;object-fit:cover;border-radius:var(--r-lg)"
          loading="lazy"
        />
        <div class="cred-panel">
          <div class="cred-row"><span class="cred-check">✓</span> MBAcC · Nos. 963087 &amp; 963093</div>
          <div class="cred-row"><span class="cred-check">✓</span> ATCM Professional Member</div>
          <div class="cred-row"><span class="cred-check">✓</span> PSA Accredited Register</div>
          <div class="cred-row"><span class="cred-check">✓</span> AXA · Vitality · Aviva · WPA</div>
        </div>
      </div>

    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════
     §3 CONDITIONS IT MAY HELP WITH
═══════════════════════════════════════════════ -->
<section class="section">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">Conditions</p>
      <h2>What Acupuncture May Be Used For</h2>
      <p>
        Acupuncture is used as part of care for a range of conditions. Your practitioner
        will assess your individual circumstances at consultation — we do not suggest
        acupuncture is appropriate for every patient or presentation.
      </p>
    </div>

    <div class="grid-3" style="margin-bottom:2.5rem">
      <div style="padding:1.6rem;background:var(--cream);border-radius:var(--r-lg);border:1px solid rgba(192,152,90,0.2)">
        <p style="font-size:1.4rem;margin-bottom:0.5rem">🦴</p>
        <h3 style="font-size:1.05rem">Musculoskeletal Pain</h3>
        <p style="font-size:0.9rem;color:var(--muted)">
          Back pain, sciatica, neck and shoulder tension, knee pain, joint conditions,
          and sports injuries. Commonly used alongside Tui Na and bone setting.
        </p>
        <a class="more-link" href="/back-pain">Back Pain &amp; Sciatica</a>
      </div>
      <div style="padding:1.6rem;background:var(--cream);border-radius:var(--r-lg);border:1px solid rgba(192,152,90,0.2)">
        <p style="font-size:1.4rem;margin-bottom:0.5rem">🌸</p>
        <h3 style="font-size:1.05rem">Women's Health</h3>
        <p style="font-size:0.9rem;color:var(--muted)">
          Menstrual irregularity, perimenopause, postnatal recovery, and fertility support.
          Your practitioner will assess whether acupuncture is appropriate for your circumstances.
        </p>
        <a class="more-link" href="/contact">Enquire About Women's Health</a>
      </div>
      <div style="padding:1.6rem;background:var(--cream);border-radius:var(--r-lg);border:1px solid rgba(192,152,90,0.2)">
        <p style="font-size:1.4rem;margin-bottom:0.5rem">🧘</p>
        <h3 style="font-size:1.05rem">Stress &amp; Sleep</h3>
        <p style="font-size:0.9rem;color:var(--muted)">
          Anxiety, insomnia, fatigue, and stress-related conditions. Acupuncture may
          support autonomic nervous system regulation and sleep quality.
        </p>
        <a class="more-link" href="/contact">Enquire About Stress &amp; Sleep</a>
      </div>
    </div>

    <p style="font-size:0.78rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--muted);margin-bottom:0.75rem">Also commonly treated:</p>
    <div class="cond-grid">
      {[
        { label: "Back Pain",           href: "/back-pain" },
        { label: "Sciatica",            href: "/sciatica-treatment" },
        { label: "Shoulder Pain",       href: "/shoulder-pain" },
        { label: "Frozen Shoulder",     href: "/frozen-shoulder" },
        { label: "Sports Injuries",     href: "/sports-injuries" },
        { label: "Neck Pain",           href: "/conditions" },
        { label: "Headaches",           href: "/conditions" },
        { label: "Anxiety & Stress",    href: "/conditions" },
        { label: "Sleep Disorders",     href: "/conditions" },
        { label: "Digestive Health",    href: "/conditions" },
        { label: "Skin Conditions",     href: "/conditions" },
        { label: "Fertility Support",   href: "/contact" },
      ].map(({ label, href }) => (
        <a class="cond-chip" href={href}>{label}</a>
      ))}
    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════
     §4 HOW TREATMENT WORKS — dark
═══════════════════════════════════════════════ -->
<section class="section-dark">
  <div class="wrap">
    <div class="section-head" style="max-width:52ch">
      <p class="eyebrow eyebrow-dark">Your First Visit</p>
      <h2>How Acupuncture Treatment Works</h2>
      <p style="color:rgba(240,234,226,0.75)">From your initial booking to the end of your first session.</p>
    </div>

    <div class="journey-grid">
      <div class="journey-step">
        <div class="j-num">01</div>
        <h3>Clinical Assessment</h3>
        <p>
          Structured 60–75 minute first appointment. Full symptom history, pulse and
          tongue diagnosis, and relevant orthopaedic assessment to establish a complete
          clinical picture.
        </p>
      </div>
      <div class="journey-step">
        <div class="j-num">02</div>
        <h3>Personalised Treatment Plan</h3>
        <p>
          Your practitioner explains the proposed point protocol and treatment approach
          in plain language. Treatment is determined by your assessment — not a fixed
          package.
        </p>
      </div>
      <div class="journey-step">
        <div class="j-num">03</div>
        <h3>Needling &amp; Review</h3>
        <p>
          Needle insertion and 20–30 minute retention. Post-treatment guidance on
          what to expect and when to return based on your clinical response.
        </p>
      </div>
    </div>

    <p style="margin-top:2.5rem;text-align:center">
      <a class="btn btn-gold" href="https://wa.me/447301949686" target="_blank" rel="noreferrer">Book Your First Consultation</a>
    </p>
  </div>
</section>


<!-- ═══════════════════════════════════════════════
     §5 CLINICAL APPROACH
═══════════════════════════════════════════════ -->
<section class="section-soft">
  <div class="wrap">
    <div class="grid-2-lg" style="gap:5rem">

      <div>
        <p class="eyebrow">Our Approach</p>
        <h2>Clinical Acupuncture at Yin Yang CMC</h2>

        <div class="pull-quote">
          <p>"Two diagnostic frameworks, one clinical outcome — classical TCM theory and
          modern musculoskeletal anatomy, integrated at every session."</p>
        </div>

        <p>
          Every diagnosis at Yin Yang CMC combines pulse assessment, tongue observation, and
          orthopaedic testing with a thorough review of your medical history. Your treatment
          plan is explained in plain clinical language — not vague terminology.
        </p>

        <p>
          Point selection is reassessed at every appointment and adapted to your current
          clinical picture. This session-by-session responsiveness is how we keep treatment
          matched to your presentation, rather than repeating a fixed protocol.
        </p>

        <details class="expand-detail">
          <summary class="expand-summary">
            Read about our full diagnostic approach
            <span class="expand-icon" aria-hidden="true">+</span>
          </summary>
          <div class="expand-body">
            <h3>Diagnosis before treatment</h3>
            <p>
              We do not prescribe a treatment plan before completing a structured clinical
              assessment. Traditional pulse and tongue diagnosis is combined with modern
              orthopaedic testing to identify the root pattern — not just the presenting
              symptom.
            </p>
            <h3>Session-by-session adaptation</h3>
            <p>
              Point selection and technique are reviewed at every appointment. What was
              clinically indicated at your first session may differ from what is appropriate
              at follow-up, depending on your individual response.
            </p>
            <h3>Combined modality protocols where appropriate</h3>
            <p>
              When clinically indicated, acupuncture may be combined with Tui Na or bone
              setting within a single session — for example, acupuncture for neurological
              pain regulation alongside manual therapy for soft tissue and joint work.
              Every combination is determined by assessment, not by a package offering.
            </p>
          </div>
        </details>
      </div>

      <div style="display:grid;gap:1.5rem;align-content:start">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--border);border-radius:var(--r-lg);overflow:hidden">
          {[
            { val: "MBAcC",  label: "BAcC Registered" },
            { val: "15+",    label: "Years' Experience" },
            { val: "EN/粵",  label: "Bilingual Care" },
            { val: "4.9★",   label: "Google Reviews" },
          ].map(({ val, label }) => (
            <div style="background:var(--white);padding:1.5rem;text-align:center">
              <span style="display:block;font-family:var(--serif);font-size:2rem;color:var(--navy);line-height:1;margin-bottom:0.35rem">{val}</span>
              <span style="font-size:0.76rem;color:var(--muted);text-transform:uppercase;letter-spacing:0.08em">{label}</span>
            </div>
          ))}
        </div>

        <div style="background:var(--cream);border-radius:var(--r-lg);padding:1.4rem 1.6rem;border:1px solid rgba(192,152,90,0.2)">
          <p style="font-size:0.76rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--muted);margin-bottom:0.7rem">Related Treatments</p>
          <div style="display:grid;gap:0.4rem">
            {[
              { label: "Tui Na Therapeutic Massage", href: "/tui-na-massage" },
              { label: "Bone Setting & Orthopaedic Care", href: "/bone-setting" },
              { label: "Herbal Medicine Consultation", href: "/herbal-consultation" },
              { label: "All Clinical Services", href: "/clinical-services" },
            ].map(({ label, href }) => (
              <a
                href={href}
                style="display:flex;align-items:center;gap:0.4rem;font-size:0.9rem;font-weight:600;color:var(--teal);text-decoration:none;padding:0.3rem 0;transition:color 0.18s ease"
              >
                → {label}
              </a>
            ))}
          </div>
        </div>

        <div style="background:var(--navy);border-radius:var(--r-md);padding:1.3rem">
          <p style="font-family:var(--serif);font-size:1.02rem;font-style:italic;color:#f0ece2;line-height:1.6;margin:0">
            "Same-week appointments available at Reading and Wimbledon. New patients welcome — no referral needed."
          </p>
          <a class="btn btn-gold btn-sm" href="https://wa.me/447301949686" target="_blank" rel="noreferrer" style="margin-top:0.9rem">WhatsApp Us Now</a>
        </div>
      </div>

    </div>
  </div>
</section>


