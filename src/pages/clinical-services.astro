---
import Base from "../layouts/Base.astro";
import CTASection from "../components/CTASection.astro";
import FAQAccordion from "../components/FAQAccordion.astro";

const faqItems = [
  {
    q: "Are your practitioners registered in the UK?",
    a: "Yes, fully registered. All our practitioners hold professional degrees and are registered with recognised UK regulatory bodies including BAcC and ATCM. This guarantees we meet strict UK standards for safety, hygiene, and insurance. We also hold original registrations as Certified Chinese Medicine Practitioners in Hong Kong — dual-qualified credentials that are rare in the UK market.",
  },
  {
    q: "What languages are consultations conducted in?",
    a: "Fully conducted in English, Cantonese, or Mandarin. UK patients receive clear, jargon-free explanations. HK patients can describe symptoms in their native language and share HK medical notes directly — no translation needed. Describing the quality, location, and pattern of symptoms accurately is diagnostically critical in TCM, and that precision is much harder to achieve in a second language.",
  },
  {
    q: "How many sessions will I need to see results?",
    a: "Acute conditions (recent sports injuries, acute pain): 3–5 sessions typically show measurable improvement. Chronic conditions (long-standing back pain, hormonal imbalances, skin disorders): usually 6–10 sessions to address the root cause and stabilise the condition. Your practitioner will give you a clear treatment timeline at your first consultation — we do not prescribe a fixed number of sessions in advance.",
  },
  {
    q: "Is TCM safe alongside Western medicine?",
    a: "Yes, in the vast majority of cases. Your safety is our priority. During your initial consultation we thoroughly review your current medications and ongoing treatments to avoid any interactions. We will advise you to consult your GP if there is any clinical uncertainty.",
  },
  {
    q: "Do you offer consultations in Cantonese?",
    a: "Yes. All practitioners are fluent in Cantonese and Mandarin. Describe your symptoms exactly as you feel them — no translation loss, full clinical precision. If you have previous medical records or TCM case notes in Chinese, we can review these directly.",
  },
];
---
<Base
  title="Chinese Medicine Clinic UK | TCM Services Wimbledon & Reading | yin yang uk"
  description="Expert TCM clinical services in Wimbledon & Reading. Hong Kong-registered practitioners with Master's in TCM. Acupuncture, Tui Na, Bone Setting and Herbal Medicine. Bilingual consultations."
>

<!-- ═══════════════════════════════════════════════
     §1 HERO
═══════════════════════════════════════════════ -->
<section class="page-hero" style="min-height:72vh;display:grid;place-items:center">
  <img
    class="page-hero-bg"
    src="/images/webbanner-eQwGJSc8Re6udP6z.jpg"
    alt="Yin Yang CMC clinical environment"
    loading="eager"
    fetchpriority="high"
  />
  <div class="wrap" style="padding:5.5rem 0 4rem">
    <p class="eyebrow">Yin Yang CMC · Wimbledon &amp; Reading</p>
    <h1>TCM Clinical Services<br>in Wimbledon &amp; Reading</h1>
    <p class="lede">
      Hospital-trained practitioners. Master's qualified. HK-registered.<br>
      Back pain · Sciatica · Women's health · Sleep disorders · Sports injuries.
    </p>
    <div class="actions" style="margin-top:1.6rem">
      <a class="btn btn-gold" href="https://wa.me/447301949686" target="_blank" rel="noreferrer">Book a Consultation</a>
      <a class="btn btn-ghost" href="#specialisms">Explore Our Treatments</a>
    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════
     §2 TRUST / CREDENTIAL STRIP
═══════════════════════════════════════════════ -->
<div class="trust-strip">
  <div class="wrap trust-inner">
    <div class="trust-item">
      <div class="trust-icon">🎓</div>
      <div class="trust-text">
        <strong>Master's Qualified</strong>
        <span>Advanced TCM postgraduate degree, CUHK</span>
      </div>
    </div>
    <div class="trust-item">
      <div class="trust-icon">🏥</div>
      <div class="trust-text">
        <strong>Hospital Trained</strong>
        <span>Clinical internship at HK public hospitals</span>
      </div>
    </div>
    <div class="trust-item">
      <div class="trust-icon">🇭🇰</div>
      <div class="trust-text">
        <strong>HK Registered CMP</strong>
        <span>Chinese Medicine Council of Hong Kong</span>
      </div>
    </div>
    <div class="trust-item">
      <div class="trust-icon">💬</div>
      <div class="trust-text">
        <strong>Bilingual Care</strong>
        <span>Consultations in English &amp; Cantonese</span>
      </div>
    </div>
  </div>
</div>


<!-- ═══════════════════════════════════════════════
     §3 INTRODUCTION — Clinical Standard
═══════════════════════════════════════════════ -->
<section class="section-soft">
  <div class="wrap">
    <div class="grid-2-al" style="gap:4rem">

      <!-- Left: editorial copy -->
      <div>
        <p class="eyebrow">Our Clinical Standard</p>
        <h2>Hong Kong Clinical Standards.<br>Now Practising in the UK.</h2>
        <p>
          Yin-Yang CMC was established on a clinical standard deeply rooted in Hong Kong's
          exceptionally rigorous system of registration and hospital-based medical training.
          Our practitioners brought these regulated credentials and clinical habits to the UK,
          ensuring our medical settings maintain the same high-volume, high-accountability
          environment they practised in back home.
        </p>
        <p>
          Whether you are a long-term UK resident seeking evidence-grounded complementary care,
          or a family recently relocated from Hong Kong looking for the standard of TCM you know,
          our clinical approach is built to meet both expectations.
        </p>

        <!-- Credential checklist -->
        <ul style="list-style:none;padding:0;margin:1.5rem 0 0;display:grid;gap:0.5rem">
          {[
            "ATCM & MBAcC registered practitioners",
            "AXA Health, Vitality, Aviva and WPA recognised",
            "Master of Science in Chinese Medicine (CUHK)",
            "Hospital clinical training — not just private practice hours",
            "Bilingual consultations — no translation loss",
          ].map((item) => (
            <li style="display:flex;gap:0.6rem;align-items:flex-start;font-size:0.92rem">
              <span style="color:var(--gold);font-weight:700;flex-shrink:0;margin-top:0.05em">✓</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>

        <div class="actions" style="margin-top:1.8rem">
          <a class="btn btn-gold" href="https://wa.me/447301949686" target="_blank" rel="noreferrer">Book a Consultation</a>
          <a class="btn btn-outline" href="/contact">Contact Us</a>
        </div>
      </div>

      <!-- Right: image + credential panel -->
      <div class="img-wrap" style="position:relative">
        <img
          src="/images/img_6058-eVlfhKuykGV6M98J.jpg"
          alt="Yin Yang CMC clinic interior"
          style="width:100%;height:480px;object-fit:cover;border-radius:var(--r-lg)"
          loading="lazy"
        />
        <div class="cred-panel">
          <div class="cred-row"><span class="cred-check">✓</span> HK Registered CMPs</div>
          <div class="cred-row"><span class="cred-check">✓</span> MSc Chinese Medicine</div>
          <div class="cred-row"><span class="cred-check">✓</span> ATCM &amp; MBAcC</div>
          <div class="cred-row"><span class="cred-check">✓</span> Insurance Recognised</div>
        </div>
      </div>

    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════
     §4 FOUR CLINICAL SPECIALISMS
═══════════════════════════════════════════════ -->
<section class="section" id="specialisms">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">Core Therapies</p>
      <h2>Four Clinical Specialisms</h2>
      <p>
        Each therapy is delivered by a practitioner with dedicated training in that modality.
        Your treatment is targeted, protocol-driven, and adapted at each session based on
        your clinical response.
      </p>
    </div>

    <div class="spec-grid">

      <div class="spec-card">
        <span class="spec-num" aria-hidden="true">01</span>
        <div class="spec-icon">🪡</div>
        <h3>Acupuncture</h3>
        <p>
          Stimulates specific anatomical points to regulate pain signalling, reduce local
          inflammation, and support systemic homeostasis. Ideal for chronic tension, acute
          musculoskeletal pain, headaches, insomnia, menstrual irregularity, and post-operative
          recovery. Single-use sterile needles. Needle retention typically 20–30 minutes.
        </p>
        <a class="spec-link" href="/acupuncture">Explore Acupuncture</a>
      </div>

      <div class="spec-card">
        <span class="spec-num" aria-hidden="true">02</span>
        <div class="spec-icon">👐</div>
        <h3>Tui Na Therapeutic Massage</h3>
        <p>
          A structured manual therapy system — not a relaxation massage. Uses precise
          manipulation techniques including kneading, rolling, pressing, and joint mobilisation
          to address soft tissue dysfunction and restricted joint range of motion. The clinical
          application is closer to physiotherapy than sports massage.
        </p>
        <a class="spec-link" href="/tui-na-massage">Explore Tui Na</a>
      </div>

      <div class="spec-card">
        <span class="spec-num" aria-hidden="true">03</span>
        <div class="spec-icon">🦴</div>
        <h3>Bone Setting &amp; Orthopaedic Care</h3>
        <p>
          Zheng Gu (正骨) — a classical orthopaedic system involving manual realignment of
          joints and vertebrae. Applied within a modern biomechanical assessment framework.
          Treats disc herniation, postural kyphosis, cervical nerve impingement, and acute
          sports-related joint injuries.
        </p>
        <a class="spec-link" href="/bone-setting">Explore Bone Setting</a>
      </div>

      <div class="spec-card">
        <span class="spec-num" aria-hidden="true">04</span>
        <div class="spec-icon">🌿</div>
        <h3>Herbal Medicine &amp; Internal Consultation</h3>
        <p>
          Begins with a full internal consultation — pulse diagnosis, tongue observation, and
          detailed case history. Every prescription is individually tailored. GMP-certified
          materials sourced from verified suppliers. Covers digestive disorders, fatigue,
          hormonal imbalance, skin conditions, and anxiety with sleep disruption.
        </p>
        <a class="spec-link" href="/herbal-consultation">Explore Herbal Medicine</a>
      </div>

    </div>

    <p style="margin-top:1.5rem;font-size:0.88rem;color:var(--muted)">
      Treatments can be combined — your practitioner determines the optimal protocol at assessment, not a fixed package.
    </p>
  </div>
</section>


<!-- ═══════════════════════════════════════════════
     §5 WHY PATIENTS CHOOSE YIN YANG — dark section
═══════════════════════════════════════════════ -->
<section class="section-dark">
  <div class="wrap">
    <div class="grid-2-al" style="gap:4rem">

      <!-- Left: heading + intro -->
      <div>
        <p class="eyebrow eyebrow-dark">Our Clinical Approach</p>
        <h2 style="font-size:clamp(1.8rem,3.5vw,2.8rem)">
          Why patients<br>choose Yin Yang
        </h2>
        <p style="max-width:38ch;margin-top:0.8rem">
          Built on Hong Kong's most rigorous clinical standards — delivered in Wimbledon
          and Reading.
        </p>
        <div class="actions" style="margin-top:2rem">
          <a class="btn btn-gold" href="https://wa.me/447301949686" target="_blank" rel="noreferrer">Book a Consultation</a>
        </div>
      </div>

      <!-- Right: 2×2 benefit grid -->
      <div class="ben-grid">
        <div class="ben-item">
          <span class="ben-num">01</span>
          <h3>Regulated Clinical Standards</h3>
          <p>
            Every practitioner holds a Master of TCM with verified hospital clinical hours —
            a strictly regulated licence from the Chinese Medicine Council of Hong Kong.
          </p>
        </div>
        <div class="ben-item">
          <span class="ben-num">02</span>
          <h3>Traditional Wisdom + Modern Anatomy</h3>
          <p>
            Classical TCM diagnostics combined with modern musculoskeletal anatomy, for
            complex conditions like lumbar disc compression, sciatica, and nerve impingement.
          </p>
        </div>
        <div class="ben-item">
          <span class="ben-num">03</span>
          <h3>Seamless Bilingual Consultations</h3>
          <p>
            Describe your symptoms exactly as you feel them. Full clinical consultations in
            English and Cantonese — no translation loss, no precision lost.
          </p>
        </div>
        <div class="ben-item">
          <span class="ben-num">04</span>
          <h3>Dual-Clinic Continuity of Care</h3>
          <p>
            Same practitioners, protocols and herbal formularies across Wimbledon SW19 and
            Reading Castle Street. Seamless continuity between locations.
          </p>
        </div>
      </div>

    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════
     §6 CLINICAL APPROACH — readable editorial section
═══════════════════════════════════════════════ -->
<section class="section-soft">
  <div class="wrap">
    <div class="grid-2-lg" style="gap:5rem">

      <div>
        <p class="eyebrow">Our Approach</p>
        <h2>How We Work</h2>

        <div class="pull-quote">
          <p>"Built on Hong Kong's exceptionally rigorous system of clinical registration and
          intensive, hospital-based training — practised here in the UK."</p>
        </div>

        <h3>Diagnosis before treatment</h3>
        <p>
          Every patient interaction begins with a structured clinical assessment — combining
          traditional pulse and tongue diagnosis with a thorough review of your Western medical
          history, lifestyle factors, and presenting symptoms. We do not prescribe a treatment
          plan before completing this assessment.
        </p>

        <h3>Session-by-session adaptation</h3>
        <p>
          We do not apply a fixed protocol across multiple sessions. Your acupuncture point
          selection, manual therapy techniques, and herbal prescription are reassessed at
          every appointment and adjusted to match your current clinical picture. This
          session-by-session responsiveness is central to how TCM achieves lasting results
          rather than temporary relief.
        </p>

        <h3>Integrated protocols where appropriate</h3>
        <p>
          When clinically indicated, we combine modalities within a single session — for
          example, medical acupuncture for neurological pain regulation combined with Tui Na
          for soft tissue and joint work. Every combination is determined by your practitioner's
          assessment, not by a fixed package offering.
        </p>

        <!-- Frequency reference -->
        <div style="margin-top:2rem;border:1px solid var(--border);border-radius:var(--r-md);overflow:hidden">
          <div style="padding:0.8rem 1.2rem;background:var(--cream);border-bottom:1px solid var(--border)">
            <p style="font-size:0.78rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--muted);margin:0">Typical Treatment Frequency</p>
          </div>
          {[
            ["Acute pain or injury", "2–3× per week for 2 weeks, then reassess"],
            ["Chronic musculoskeletal", "Weekly for 4–6 weeks, then bi-weekly"],
            ["Women's health", "Weekly, timed to menstrual cycle phase"],
            ["Skin conditions", "Weekly 6–8 weeks; herbal review every 2 weeks"],
          ].map(([cond, freq], i) => (
            <div style={`display:flex;justify-content:space-between;gap:1rem;padding:0.8rem 1.2rem;font-size:0.88rem;${i < 3 ? "border-bottom:1px solid var(--border)" : ""}`}>
              <span style="font-weight:600;color:var(--navy)">{cond}</span>
              <span style="color:var(--muted);text-align:right">{freq}</span>
            </div>
          ))}
          <div style="padding:0.6rem 1.2rem;font-size:0.78rem;color:var(--muted);background:var(--cream)">
            Indicative benchmarks only. Your practitioner adjusts based on your clinical response.
          </div>
        </div>
      </div>

      <!-- Right: stats + image -->
      <div style="display:grid;gap:1.5rem;align-content:start">

        <!-- Stat column -->
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--border);border-radius:var(--r-lg);overflow:hidden">
          {[
            { val: "4.9★", label: "Google Reviews" },
            { val: "15+", label: "Years of practice" },
            { val: "2", label: "UK clinic locations" },
            { val: "EN/粵", label: "Bilingual care" },
          ].map(({ val, label }) => (
            <div style="background:var(--white);padding:1.5rem;text-align:center">
              <span style="display:block;font-family:var(--serif);font-size:2rem;color:var(--navy);line-height:1;margin-bottom:0.35rem">{val}</span>
              <span style="font-size:0.78rem;color:var(--muted);text-transform:uppercase;letter-spacing:0.08em">{label}</span>
            </div>
          ))}
        </div>

        <img
          src="/images/adobestock_88537046-low-My8DbSswqH0l0J9t.jpg"
          alt="Chinese medicine clinical treatment"
          style="width:100%;height:280px;object-fit:cover;border-radius:var(--r-lg)"
          loading="lazy"
        />

        <div style="background:var(--navy);border-radius:var(--r-md);padding:1.4rem">
          <p style="font-family:var(--serif);font-size:1.05rem;font-style:italic;color:#f0ece2;line-height:1.6;margin:0">
            "Same-week appointments available. New patients welcome — no referral needed."
          </p>
          <a class="btn btn-gold btn-sm" href="https://wa.me/447301949686" target="_blank" rel="noreferrer" style="margin-top:1rem">WhatsApp Us Now</a>
        </div>

      </div>
    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════
     §7 CONDITIONS WE TREAT
═══════════════════════════════════════════════ -->
<section class="section">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">Conditions We Treat</p>
      <h2>Where Our Expertise Makes the Most Difference</h2>
      <p>
        Our clinical focus is deliberately narrow. We specialise in high-impact areas where our
        integrated combination of acupuncture, manual therapy, and herbal medicine produces
        consistent, verifiable outcomes.
      </p>
    </div>

    <div class="grid-3" style="margin-bottom:2.5rem">
      <div style="padding:1.8rem;background:var(--cream);border-radius:var(--r-lg);border:1px solid rgba(192,152,90,0.2)">
        <p style="font-size:1.5rem;margin-bottom:0.6rem">🦴</p>
        <h3 style="font-size:1.05rem">Chronic Pain &amp; Spinal Problems</h3>
        <p style="font-size:0.9rem;color:var(--muted)">
          Lumbar disc herniation, sciatica, cervical spondylosis, and sacroiliac joint
          dysfunction. Our combined acupuncture and bone-setting protocol addresses the
          neurological pain component, structural misalignment, and muscle tension simultaneously.
        </p>
        <a class="more-link" href="/back-pain">Back Pain &amp; Sciatica</a>
      </div>
      <div style="padding:1.8rem;background:var(--cream);border-radius:var(--r-lg);border:1px solid rgba(192,152,90,0.2)">
        <p style="font-size:1.5rem;margin-bottom:0.6rem">🌸</p>
        <h3 style="font-size:1.05rem">Women's Health &amp; Hormonal Balance</h3>
        <p style="font-size:0.9rem;color:var(--muted)">
          Postnatal recovery, menstrual irregularity (including PCOS and endometriosis),
          fertility support alongside IVF cycles, perimenopause management, and postpartum
          body recomposition. Integrated acupuncture and individually prescribed herbal formulae.
        </p>
        <a class="more-link" href="/contact">Enquire about Women's Health</a>
      </div>
      <div style="padding:1.8rem;background:var(--cream);border-radius:var(--r-lg);border:1px solid rgba(192,152,90,0.2)">
        <p style="font-size:1.5rem;margin-bottom:0.6rem">🏃</p>
        <h3 style="font-size:1.05rem">Sports Injuries &amp; Recovery</h3>
        <p style="font-size:0.9rem;color:var(--muted)">
          Ligament sprains, tendinopathy, muscle tears, and RSI respond exceptionally well to
          our combined Tui Na and acupuncture rehabilitation protocol. We design
          session-by-session recovery programmes for recreational and competitive athletes.
        </p>
        <a class="more-link" href="/sports-injuries">Sports Injuries</a>
      </div>
    </div>

    <!-- Condition chips for internal linking -->
    <p style="font-size:0.8rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--muted);margin-bottom:0.8rem">Also treated at our clinics:</p>
    <div class="cond-grid">
      {[
        { label: "Back Pain",         href: "/back-pain" },
        { label: "Sciatica",          href: "/sciatica-treatment" },
        { label: "Shoulder Pain",     href: "/shoulder-pain" },
        { label: "Frozen Shoulder",   href: "/frozen-shoulder" },
        { label: "Sports Injuries",   href: "/sports-injuries" },
        { label: "Neck Pain",         href: "/conditions" },
        { label: "Headaches",         href: "/conditions" },
        { label: "Anxiety & Stress",  href: "/conditions" },
        { label: "Sleep Disorders",   href: "/conditions" },
        { label: "Digestive Health",  href: "/conditions" },
        { label: "Skin Conditions",   href: "/conditions" },
        { label: "Fertility Support", href: "/contact" },
        { label: "Fatigue",           href: "/conditions" },
        { label: "Post-natal Care",   href: "/contact" },
      ].map(({ label, href }) => (
        <a class="cond-chip" href={href}>{label}</a>
      ))}
    </div>
  </div>
</section>


