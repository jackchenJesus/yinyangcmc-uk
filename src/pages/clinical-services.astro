---
import Base from "../layouts/Base.astro";
import CTASection from "../components/CTASection.astro";
import FAQAccordion from "../components/FAQAccordion.astro";

const faqItems = [
  {
    q: "Are your practitioners registered in the UK?",
    a: "Yes. Both practitioners are registered members of the British Acupuncture Council (MBAcC), which is listed on the Professional Standards Authority's Accredited Register — providing independent assurance of professional standards in health and care. They are also registered with the Association of Traditional Chinese Medicine & Acupuncture (ATCM). The practice is recognised by AXA Health, Vitality, Aviva and WPA; cover depends on your policy and usually relates to eligible acupuncture treatment.",
  },
  {
    q: "What languages are consultations conducted in?",
    a: "Fully conducted in English, Cantonese, or Mandarin. UK patients receive clear, jargon-free explanations of their diagnosis and treatment plan. Cantonese- or Mandarin-speaking patients can describe symptoms in their first language and share previous medical notes directly — no translation loss, full clinical precision.",
  },
  {
    q: "How many sessions will I need?",
    a: "Treatment frequency varies depending on the condition, how long symptoms have been present, your general health, and your individual response to treatment. Your practitioner will discuss a recommended review period after your initial assessment and adjust the plan according to your progress. We do not prescribe a fixed number of sessions in advance.",
  },
  {
    q: "Is TCM safe alongside Western medicine?",
    a: "Yes, in the vast majority of cases. Your safety is our priority. During your initial consultation we thoroughly review your current medications and ongoing treatments to avoid any interactions. We will advise you to consult your GP if there is any clinical uncertainty.",
  },
  {
    q: "Do you accept health insurance?",
    a: "Yes. We are recognised by AXA Health, Vitality, Aviva and WPA. Cover depends on your individual policy and insurer requirements, and usually relates to eligible acupuncture treatment — not automatically to Tui Na, bone setting or herbal consultation. Please check with your insurer before treatment.",
  },
  {
    q: "Do you offer consultations in Cantonese or Mandarin?",
    a: "Yes. All practitioners are fluent in Cantonese and Mandarin. Describe your symptoms exactly as you feel them — no translation loss, full clinical precision. If you have previous medical records or TCM case notes in Chinese, we can review these directly.",
  },
];
---
<Base
  title="Chinese Medicine Clinic in Reading & Wimbledon | Yin Yang CMC"
  description="Professional Chinese Medicine in Reading & Wimbledon. British Acupuncture Council registered, 15+ years' experience. Acupuncture, Tui Na, Bone Setting and Herbal Medicine."
>


<!-- ═══════════════════════════════════════════════
     §1 HERO
═══════════════════════════════════════════════ -->
<section class="page-hero" style="min-height:72vh;display:grid;place-items:center">
  <img
    class="page-hero-bg"
    src="/images/acupuncture-back-treatment.webp"
    alt=""
    loading="eager"
    fetchpriority="high"
  />
  <div class="wrap" style="padding:5.5rem 0 4rem">
    <p class="eyebrow">Professional Chinese Medicine · Reading &amp; Wimbledon</p>
    <h1>Professional Chinese<br>Medicine in Reading<br>&amp; Wimbledon</h1>
    <p class="lede">
      Acupuncture · Tui Na · Bone Setting · Herbal Medicine<br>
      Back pain · Sports injuries · Women's health · Sleep disorders
    </p>

    <!-- 15+ Years stat — primary trust signal -->
    <div class="hero-exp-stat">
      <span class="hero-exp-num">15+</span>
      <span class="hero-exp-label">Years'<br>Clinical Experience</span>
    </div>

    <div class="actions" style="margin-top:0">
      <a class="btn btn-gold" href="https://wa.me/447301949686" target="_blank" rel="noreferrer">Book a Consultation</a>
      <a class="btn btn-ghost" href="#specialisms">Explore Treatments</a>
    </div>

    <!-- Compact trust row -->
    <div class="hero-trust-row">
      <span><span class="htc">✓</span> British Acupuncture Council Member</span>
      <span><span class="htc">✓</span> PSA Accredited Register</span>
      <span><span class="htc">✓</span> Reading &amp; Wimbledon</span>
      <span><span class="htc">✓</span> English &amp; Cantonese</span>
    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════
     §2 INTRODUCTION — UK-first positioning
═══════════════════════════════════════════════ -->
<section class="section-soft">
  <div class="wrap">
    <div class="grid-2-al" style="gap:4rem">

      <div>
        <p class="eyebrow">About Our Practice</p>
        <h2>Professional Chinese Medicine<br>in Reading &amp; Wimbledon</h2>
        <p>
          Yin Yang CMC offers structured, professional Chinese Medicine at two UK clinic
          locations — Reading town centre and Wimbledon SW19. Both practitioners are
          British Acupuncture Council members with over 15 years of clinical experience,
          recognised by major UK health insurers.
        </p>
        <p>
          Master's-qualified with extensive hospital-based clinical training in Hong Kong
          and long-term UK practice — whether you seek evidence-conscious complementary
          care alongside NHS treatment, or the level of clinical TCM you know, our approach
          is built to meet both expectations.
        </p>

        <ul style="list-style:none;padding:0;margin:1.5rem 0 0;display:grid;gap:0.5rem">
          {[
            "Clear explanation of your diagnosis and treatment plan at every session",
            "Bilingual consultations — English, Cantonese & Mandarin",
            "Recognised by major UK health insurers — no GP referral needed",
            "Same-week appointments at Reading and Wimbledon",
          ].map((item) => (
            <li style="display:flex;gap:0.6rem;align-items:flex-start;font-size:0.92rem">
              <span style="color:var(--gold);font-weight:700;flex-shrink:0;margin-top:0.05em">✓</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>

        <div class="actions" style="margin-top:1.8rem">
          <a class="btn btn-gold" href="https://wa.me/447301949686" target="_blank" rel="noreferrer">Book a Consultation</a>
          <a class="btn btn-outline" href="/contact">Contact Us</a>
        </div>
      </div>

      <div class="img-wrap" style="position:relative">
        <img
          src="/images/reading-clinic-treatment-room.webp"
          alt="Treatment room at Yin Yang CMC in Reading"
          style="width:100%;height:480px;object-fit:cover;border-radius:var(--r-lg)"
          loading="lazy"
        />
        <div class="cred-panel">
          <div class="cred-row"><span class="cred-check">✓</span> British Acupuncture Council</div>
          <div class="cred-row"><span class="cred-check">✓</span> ATCM Professional Member</div>
          <div class="cred-row"><span class="cred-check">✓</span> PSA Accredited Register</div>
          <div class="cred-row"><span class="cred-check">✓</span> Insurance Recognised</div>
        </div>
      </div>

    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════
     §3 FOUR CLINICAL SPECIALISMS
═══════════════════════════════════════════════ -->
<section class="section" id="specialisms">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">Core Therapies</p>
      <h2>Four Clinical Specialisms</h2>
      <p>
        Each therapy is delivered by a practitioner with dedicated training in that modality —
        targeted, protocol-driven, and adapted at each session based on your clinical response.
      </p>
    </div>

    <div class="spec-grid">

      <div class="spec-card">
        <span class="spec-num" aria-hidden="true">01</span>
        <div class="spec-icon">🪡</div>
        <h3>Acupuncture</h3>
        <p>
          Fine needles stimulate specific anatomical points to support pain management
          and systemic balance. Commonly used as part of care for musculoskeletal pain,
          headaches, insomnia, menstrual irregularity, and stress-related conditions.
        </p>
        <a class="spec-link" href="/acupuncture">Explore Acupuncture</a>
      </div>

      <div class="spec-card">
        <span class="spec-num" aria-hidden="true">02</span>
        <div class="spec-icon">👐</div>
        <h3>Tui Na Therapeutic Massage</h3>
        <p>
          A structured manual therapy system — kneading, pressing, and joint mobilisation
          to address soft tissue and range-of-motion concerns. Closer in application to
          physiotherapy than general sports massage.
        </p>
        <a class="spec-link" href="/tui-na-massage">Explore Tui Na</a>
      </div>

      <div class="spec-card">
        <span class="spec-num" aria-hidden="true">03</span>
        <div class="spec-icon">🦴</div>
        <h3>Bone Setting &amp; Orthopaedic Care</h3>
        <p>
          Zheng Gu (正骨) — a classical orthopaedic approach involving manual joint and
          vertebral mobilisation, applied within a modern biomechanical assessment framework.
          May be considered for spinal, postural, and joint concerns.
        </p>
        <a class="spec-link" href="/bone-setting">Explore Bone Setting</a>
      </div>

      <div class="spec-card">
        <span class="spec-num" aria-hidden="true">04</span>
        <div class="spec-icon">🌿</div>
        <h3>Chinese Herbal Medicine Consultation</h3>
        <p>
          Full internal consultation — pulse diagnosis, tongue observation, detailed case
          history — followed by an individually tailored herbal prescription.
          Often used alongside acupuncture for internal health concerns.
        </p>
        <a class="spec-link" href="/herbal-consultation">Explore Herbal Consultation</a>
      </div>

    </div>

    <p style="margin-top:1.5rem;font-size:0.88rem;color:var(--muted)">
      Treatments can be combined — your practitioner determines the optimal protocol at assessment, not a fixed package.
    </p>
  </div>
</section>


<!-- ═══════════════════════════════════════════════
     §4 WHY PATIENTS CHOOSE YIN YANG — dark
═══════════════════════════════════════════════ -->
<section class="section-dark">
  <div class="wrap">
    <div class="grid-2-al" style="gap:4rem">

      <div>
        <p class="eyebrow eyebrow-dark">Why Choose Us</p>
        <h2 style="font-size:clamp(1.8rem,3.5vw,2.8rem)">
          Why patients<br>choose Yin Yang
        </h2>
        <p style="max-width:38ch;margin-top:0.8rem">
          Professionally accredited, experienced, bilingual — clinical Chinese Medicine
          in Reading and Wimbledon.
        </p>
        <div class="actions" style="margin-top:2rem">
          <a class="btn btn-gold" href="https://wa.me/447301949686" target="_blank" rel="noreferrer">Book a Consultation</a>
        </div>
      </div>

      <div class="ben-grid">
        <div class="ben-item">
          <span class="ben-num">01</span>
          <h3>BAcC &amp; ATCM Registered</h3>
          <p>
            British Acupuncture Council members on a PSA Accredited Register. Recognised
            by major UK health insurers — AXA, Vitality, Aviva and WPA. Cover depends on your policy.
          </p>
        </div>
        <div class="ben-item">
          <span class="ben-num">02</span>
          <h3>Traditional Wisdom + Modern Anatomy</h3>
          <p>
            Classical TCM diagnostics combined with modern musculoskeletal understanding,
            for complex conditions like disc compression, sciatica, and nerve impingement.
          </p>
        </div>
        <div class="ben-item">
          <span class="ben-num">03</span>
          <h3>Clear Bilingual Communication</h3>
          <p>
            Full clinical consultations in English, Cantonese, or Mandarin. Describe your
            symptoms exactly as you feel them — no translation loss, no precision lost.
          </p>
        </div>
        <div class="ben-item">
          <span class="ben-num">04</span>
          <h3>Two Clinics — One Standard of Care</h3>
          <p>
            Same practitioners, protocols and herbal formularies across Reading Castle Street
            and Wimbledon SW19. Seamless continuity between locations.
          </p>
        </div>
      </div>

    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════
