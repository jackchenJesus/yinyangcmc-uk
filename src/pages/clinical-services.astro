<!-- ═══════════════════════════════════════════════
     §9 PATIENT JOURNEY — 3 steps
═══════════════════════════════════════════════ -->
<section class="section">
  <div class="wrap">
    <div class="section-head" style="max-width:52ch">
      <p class="eyebrow">What to Expect</p>
      <h2>Your Clinical Journey</h2>
      <p>From the moment you book to the end of your first session — here is exactly what happens.</p>
    </div>

    <div class="journey-grid">
      <div class="journey-step">
        <div class="j-num">01</div>
        <h3>Clinical Consultation</h3>
        <p>
          Comprehensive 1-on-1 assessment combining pulse and tongue diagnosis with your full
          Western medical history. We identify the root systemic pattern — not just the
          presenting symptom.
        </p>
      </div>
      <div class="journey-step">
        <div class="j-num">02</div>
