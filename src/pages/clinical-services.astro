<!-- ═══════════════════════════════════════════════
     §8 PROFESSIONAL BACKGROUND — supporting credibility
     (HK credentials as secondary evidence, lower on page)
═══════════════════════════════════════════════ -->
<section class="section">
  <div class="wrap">
    <div class="section-head" style="max-width:54ch">
      <p class="eyebrow">Our Practitioners</p>
      <h2>Professional Background &amp; Clinical Training</h2>
      <p>
        Our practitioners hold formal UK professional registrations and bring postgraduate
        clinical training — including hospital-based internship — to their UK practice.
      </p>
    </div>

    <div class="grid-2" style="gap:3rem;align-items:start">

      <!-- UK Professional Registrations -->
      <div>
        <h3 style="font-size:1.05rem;margin-bottom:1rem">UK Professional Registrations</h3>
        <ul style="padding:0;list-style:none;display:grid;gap:0.8rem;margin:0 0 1.2rem">
          {[
            { tag: "ATCM",      title: "Association of Traditional Chinese Medicine",  note: "Reg. FM0250004 & FM0250005" },
            { tag: "BAcC",      title: "British Acupuncture Council",                   note: "Reg. 963087 & 963093" },
            { tag: "Insurance", title: "Recognised by AXA Health, Vitality, Aviva & WPA", note: "" },
          ].map(({ tag, title, note }) => (
            <li style="display:grid;grid-template-columns:auto 1fr;gap:0.5rem 0.8rem;align-items:start">
