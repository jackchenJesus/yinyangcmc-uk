---
import Base from "../layouts/Base.astro";
import CTASection from "../components/CTASection.astro";
import FAQAccordion from "../components/FAQAccordion.astro";

const faqItems = [
  {
    q: "Are your practitioners registered in the UK?",
    a: "Yes. All practitioners hold professional registrations with the Association of Traditional Chinese Medicine (ATCM) and the British Acupuncture Council (BAcC) — the two main voluntary professional bodies for Chinese medicine in the UK. Our practice is recognised by AXA Health, Vitality, Aviva and WPA for insurance purposes. Chinese Medicine is not currently subject to statutory UK government regulation, but our practitioners meet the training, qualification and insurance requirements set by these professional bodies.",
  },
  {
    q: "What languages are consultations conducted in?",
    a: "Fully conducted in English, Cantonese, or Mandarin. UK patients receive clear, jargon-free explanations of their diagnosis and treatment plan. Cantonese- or Mandarin-speaking patients can describe symptoms in their first language and share previous medical notes directly — no translation loss, full clinical precision.",
  },
  {
    q: "How many sessions will I need to see results?",
    a: "Acute conditions (recent sports injuries, acute pain): 3–5 sessions typically show measurable improvement. Chronic conditions (long-standing back pain, hormonal imbalances, skin disorders): usually 6–10 sessions to address the root cause and stabilise the condition. Your practitioner will give you a clear treatment timeline at your first consultation — we do not prescribe a fixed number of sessions in advance.",
  },
  {
    q: "Is TCM safe alongside Western medicine?",
    a: "Yes, in the vast majority of cases. Your safety is our priority. During your initial consultation we thoroughly review your current medications and ongoing treatments to avoid any interactions. We will advise you to consult your GP if there is any clinical uncertainty.",
  },
  {
    q: "Do you accept health insurance?",
    a: "Yes. We are recognised by AXA Health, Vitality (Bupa), Aviva and WPA. Please check your individual policy terms, as coverage levels vary. We recommend contacting your insurer before your first appointment to confirm your entitlement.",
  },
];
---
<Base
  title="Chinese Medicine Clinic UK | TCM Services Wimbledon & Reading | yin yang uk"
  description="Professional Chinese Medicine in Wimbledon & Reading. ATCM & BAcC registered practitioners. Acupuncture, Tui Na, Bone Setting and Herbal Medicine. English, Cantonese and Mandarin consultations."
>


<!-- ═══════════════════════════════════════════════
     §1 HERO
═══════════════════════════════════════════════ -->
<section class="page-hero" style="min-height:72vh;display:grid;place-items:center">
  <img
    class="page-hero-bg"
    src="/images/webbanner-eQwGJSc8Re6udP6z.jpg"
    alt="Yin Yang CMC clinical environment"
    loading="eager"
    fetchpriority="high"
  />
  <div class="wrap" style="padding:5.5rem 0 4rem">
    <p class="eyebrow">Professional Chinese Medicine · Wimbledon &amp; Reading</p>
    <h1>Expert Chinese Medicine<br>Care in the UK</h1>
    <p class="lede">
      Back pain · Sciatica · Shoulder pain · Women's health · Sports injuries.<br>
      ATCM &amp; BAcC registered. Same-week appointments available.
    </p>
    <div class="actions" style="margin-top:1.6rem">
      <a class="btn btn-gold" href="https://wa.me/447301949686" target="_blank" rel="noreferrer">Book a Consultation</a>
      <a class="btn btn-ghost" href="#specialisms">Explore Our Treatments</a>
    </div>
    <!-- Inline trust signals — compact, secondary -->
    <div class="hero-trust-row">
      <span><span class="htc">✓</span> ATCM &amp; BAcC Registered</span>
      <span><span class="htc">✓</span> AXA, Vitality &amp; Aviva Recognised</span>
      <span><span class="htc">✓</span> Wimbledon &amp; Reading</span>
      <span><span class="htc">✓</span> English, Cantonese &amp; Mandarin</span>
    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════
     §2 INTRODUCTION — UK-first positioning
═══════════════════════════════════════════════ -->
<section class="section-soft">
  <div class="wrap">
    <div class="grid-2-al" style="gap:4rem">

      <!-- Left: editorial copy -->
      <div>
        <p class="eyebrow">About Our Practice</p>
        <h2>Professional Chinese Medicine<br>in Wimbledon &amp; Reading</h2>
        <p>
          Yin Yang CMC offers structured, professional Chinese Medicine at two UK clinic
          locations — Wimbledon SW19 and Reading town centre. Our practitioners are
          registered with ATCM and BAcC, and recognised by major UK health insurers.
        </p>
        <p>
          Whether you are seeking evidence-conscious complementary care alongside NHS
          treatment, or looking for the level of clinical TCM you experienced in
          Hong Kong, our approach is built to meet both expectations.
        </p>

        <!-- Credential checklist — UK credentials first -->
        <ul style="list-style:none;padding:0;margin:1.5rem 0 0;display:grid;gap:0.5rem">
          {[
            "ATCM & BAcC registered practitioners",
            "Recognised by AXA Health, Vitality, Aviva and WPA",
            "Bilingual consultations — English, Cantonese & Mandarin",
            "Same-week appointments — no GP referral needed",
            "Postgraduate clinical training including hospital-based internship",
          ].map((item) => (
            <li style="display:flex;gap:0.6rem;align-items:flex-start;font-size:0.92rem">
              <span style="color:var(--gold);font-weight:700;flex-shrink:0;margin-top:0.05em">✓</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>

        <div class="actions" style="margin-top:1.8rem">
          <a class="btn btn-gold" href="https://wa.me/447301949686" target="_blank" rel="noreferrer">Book a Consultation</a>
          <a class="btn btn-outline" href="/contact">Contact Us</a>
        </div>
      </div>

      <!-- Right: image + credential panel -->
      <div class="img-wrap" style="position:relative">
        <img
          src="/images/img_6058-eVlfhKuykGV6M98J.jpg"
          alt="Yin Yang CMC clinic interior"
          style="width:100%;height:480px;object-fit:cover;border-radius:var(--r-lg)"
          loading="lazy"
        />
        <div class="cred-panel">
          <div class="cred-row"><span class="cred-check">✓</span> ATCM &amp; BAcC Registered</div>
          <div class="cred-row"><span class="cred-check">✓</span> Insurance Recognised</div>
          <div class="cred-row"><span class="cred-check">✓</span> 15+ Years Clinical Practice</div>
          <div class="cred-row"><span class="cred-check">✓</span> EN / 粵 / 普 Bilingual</div>
        </div>
      </div>

    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════
     §3 FOUR CLINICAL SPECIALISMS
═══════════════════════════════════════════════ -->
<section class="section" id="specialisms">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">Core Therapies</p>
      <h2>Four Clinical Specialisms</h2>
      <p>
        Each therapy is delivered by a practitioner with dedicated training in that modality —
        targeted, protocol-driven, and adapted at each session based on your clinical response.
      </p>
    </div>

    <div class="spec-grid">

      <div class="spec-card">
        <span class="spec-num" aria-hidden="true">01</span>
        <div class="spec-icon">🪡</div>
        <h3>Acupuncture</h3>
        <p>
          Stimulates specific anatomical points to regulate pain signalling, reduce inflammation,
          and support systemic balance. Effective for chronic tension, musculoskeletal pain,
          headaches, insomnia, menstrual irregularity, and post-operative recovery.
        </p>
        <a class="spec-link" href="/acupuncture">Explore Acupuncture</a>
      </div>

      <div class="spec-card">
        <span class="spec-num" aria-hidden="true">02</span>
        <div class="spec-icon">👐</div>
        <h3>Tui Na Therapeutic Massage</h3>
        <p>
          A structured manual therapy system using kneading, rolling, pressing, and joint
          mobilisation to address soft tissue dysfunction and restricted range of motion.
          The clinical application is closer to physiotherapy than sports massage.
        </p>
        <a class="spec-link" href="/tui-na-massage">Explore Tui Na</a>
      </div>

      <div class="spec-card">
        <span class="spec-num" aria-hidden="true">03</span>
        <div class="spec-icon">🦴</div>
        <h3>Bone Setting &amp; Orthopaedic Care</h3>
        <p>
          Zheng Gu (正骨) — a classical orthopaedic system involving manual realignment of
          joints and vertebrae, applied within a modern biomechanical assessment framework.
          Treats disc herniation, postural issues, cervical nerve impingement, and joint injuries.
        </p>
        <a class="spec-link" href="/bone-setting">Explore Bone Setting</a>
      </div>

      <div class="spec-card">
        <span class="spec-num" aria-hidden="true">04</span>
        <div class="spec-icon">🌿</div>
        <h3>Herbal Medicine &amp; Internal Consultation</h3>
        <p>
          Begins with a full internal consultation — pulse diagnosis, tongue observation, and
          detailed case history. Every prescription is individually tailored using GMP-certified
          materials. Covers digestive disorders, fatigue, hormonal imbalance, skin conditions,
          and anxiety with sleep disruption.
        </p>
        <a class="spec-link" href="/herbal-consultation">Explore Herbal Medicine</a>
      </div>

    </div>

    <p style="margin-top:1.5rem;font-size:0.88rem;color:var(--muted)">
      Treatments can be combined — your practitioner determines the optimal protocol at assessment, not a fixed package.
    </p>
  </div>
</section>


<!-- ═══════════════════════════════════════════════
     §4 WHY PATIENTS CHOOSE YIN YANG — dark section
═══════════════════════════════════════════════ -->
<section class="section-dark">
  <div class="wrap">
    <div class="grid-2-al" style="gap:4rem">

      <!-- Left: heading + intro -->
      <div>
        <p class="eyebrow eyebrow-dark">Why Choose Us</p>
