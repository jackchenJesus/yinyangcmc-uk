---
import Base from "../layouts/Base.astro";
import CTASection from "../components/CTASection.astro";
---
<Base
  title="Chinese Medicine Clinic UK | TCM Services Wimbledon & Reading | yin yang uk"
  description="Expert TCM Clinical Services in Wimbledon & Reading. Hong Kong-registered practitioners. Acupuncture, Tui Na, Bone Setting and Herbal Medicine."
>

  <!-- ═══════════════════════════════════════
       HERO
  ═══════════════════════════════════════ -->
  <section class="page-hero" style="padding-bottom:5rem">
    <img
      class="page-hero-bg"
      src="/images/conditions-we-treat-OWrWp19D0BpU3xPw.webp"
      alt="TCM clinic interior"
      loading="eager"
      fetchpriority="high"
    />
    <div class="wrap">
      <p class="eyebrow">Yin Yang CMC · UK Clinics</p>
      <h1>TCM Clinical Services in Wimbledon &amp; Reading</h1>
      <p class="lede">
        Back Pain · Sciatica · Neck Pain · Women's Health · Sleep Disorders<br />
        Hong Kong-registered practitioners. Master's in TCM. Bilingual consultations.
      </p>
      <div class="hero-badges" style="justify-content:flex-start;margin-bottom:1.4rem">
        <span class="badge badge-dark">★★★★★ 4.9 Google Reviews</span>
        <span class="badge badge-dark">Hospital-Trained Practitioners</span>
        <span class="badge badge-dark">📍 Wimbledon SW19 &amp; Reading</span>
      </div>
      <div class="actions">
        <a class="btn btn-gold" href="https://wa.me/447301949686" target="_blank" rel="noreferrer">WhatsApp Us — We Reply Fast</a>
        <a class="btn btn-ghost" href="#specialisms">Our Four Specialisms</a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       TRUST BAR
  ═══════════════════════════════════════ -->
  <div class="trust-bar">
    <div class="trust-item">
      <div class="trust-icon">🎓</div>
      <div class="trust-text">
        <strong>Master's in TCM</strong>
        <span>Accredited Hong Kong university</span>
      </div>
    </div>
    <div class="trust-item">
      <div class="trust-icon">🏥</div>
      <div class="trust-text">
        <strong>Hospital-Trained</strong>
        <span>Verified clinical internship hours</span>
      </div>
    </div>
    <div class="trust-item">
      <div class="trust-icon">🇭🇰</div>
      <div class="trust-text">
        <strong>HK Registered CMPs</strong>
        <span>Chinese Medicine Council of HK</span>
      </div>
    </div>
    <div class="trust-item">
      <div class="trust-icon">💬</div>
      <div class="trust-text">
        <strong>English &amp; Cantonese</strong>
        <span>No translation loss</span>
      </div>
    </div>
  </div>

  <!-- ═══════════════════════════════════════
       WHY PATIENTS TRUST US
  ═══════════════════════════════════════ -->
  <section class="section">
    <div class="wrap">
      <div class="section-heading">
        <p class="eyebrow">Our Clinical Approach</p>
        <h2>Why patients trust us</h2>
        <p>
          Yin-Yang CMC was built on a distinct clinical standard — deeply rooted in Hong Kong's
          rigorous system of registration and hospital-based medical training.
        </p>
      </div>

      <div class="grid-2 equal" style="margin-bottom:3rem">
        <div class="feat-card">
          <div class="feat-num">01</div>
          <h3>Regulated Standards, UK-Based Clinics</h3>
          <p>
            Every member of our clinical team holds a Master of TCM degree backed by verified
            hospital clinical hours — a strictly regulated licence from the Chinese Medicine Council
            of Hong Kong. We chose to build our UK clinics around this standard because our
            patients deserve care at this elite clinical level.
          </p>
        </div>
        <div class="feat-card">
          <div class="feat-num">02</div>
          <h3>Bridging Traditional Wisdom with Modern Anatomy</h3>
          <p>
            Classical TCM theory provides a comprehensive diagnostic framework; modern
            musculoskeletal anatomy provides targeted precision. When you present with lumbar
            disc compression, your treatment maps traditional holistic balance alongside relevant
            anatomical structures — ensuring optimal long-term outcomes.
          </p>
        </div>
      </div>

      <div class="grid-2 equal">
        <div class="feat-card">
          <div class="feat-num">03</div>
          <h3>Seamless Bilingual Consultations</h3>
          <p>
            Describing chronic pain in a second language directly compromises diagnostic accuracy.
            Our clinics offer fully uncompromised consultations in English and Cantonese. You
            describe your symptoms exactly as you feel them — your practitioner understands both
            the clinical detail and the cultural context.
          </p>
        </div>
        <div class="feat-card">
          <div class="feat-num">04</div>
          <h3>Dual-Clinic Continuity of Care</h3>
          <p>
            Both our Wimbledon (SW19) and Reading (Castle Street) clinics operate under the same
            practitioner rotation, matching herbal formularies, and synchronised diagnostic
            protocols. Patients requiring multi-session treatments can seamlessly transition between
            locations without any drop in clinical continuity.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       STATS STRIP
  ═══════════════════════════════════════ -->
  <div class="stat-strip">
    <div class="wrap">
      <div class="stat-grid">
        <div class="stat-item">
          <span class="stat-val">4.9★</span>
          <span class="stat-label">Google Reviews</span>
        </div>
        <div class="stat-item">
          <span class="stat-val">UK Reg.</span>
          <span class="stat-label">Certified practitioners</span>
        </div>
        <div class="stat-item">
          <span class="stat-val">2</span>
          <span class="stat-label">UK clinic locations</span>
        </div>
        <div class="stat-item">
          <span class="stat-val">Bilingual</span>
          <span class="stat-label">EN &amp; Cantonese</span>
        </div>
      </div>
    </div>
  </div>

  <!-- ═══════════════════════════════════════
       FOUR CLINICAL SPECIALISMS
  ═══════════════════════════════════════ -->
  <section class="section-soft" id="specialisms">
    <div class="wrap">
      <div class="section-heading">
        <p class="eyebrow">Core Therapies</p>
        <h2>Our Four Clinical Specialisms</h2>
        <p>
          Each therapy is delivered by a practitioner with dedicated training in that modality —
          not a generalist offering everything. Your treatment is targeted, protocol-driven, and
          adapted at each session.
        </p>
      </div>

      <div class="grid-2 equal">
        <div class="service-card">
          <div class="service-icon">🪡</div>
          <h3>Acupuncture Treatment</h3>
          <p>
            Stimulates specific anatomical points to regulate pain signalling, reduce local
            inflammation, and support systemic homeostasis. Ideal for chronic tension, acute
            musculoskeletal pain, headaches, insomnia, menstrual irregularity, and post-operative
            recovery. Single-use sterile needles. Retention typically 20–30 minutes.
          </p>
          <a class="more-link" href="/acupuncture">Full service details</a>
        </div>

        <div class="service-card">
          <div class="service-icon">👐</div>
          <h3>Tui Na Therapeutic Massage</h3>
          <p>
            A structured manual therapy system — not a relaxation massage. Uses precise
            manipulation techniques to address soft tissue dysfunction and restricted joint range
            of motion. Clinically closer to physiotherapy than sports massage. Frequently combined
            with acupuncture in pain management protocols.
          </p>
          <a class="more-link" href="/tui-na-massage">Full service details</a>
        </div>

        <div class="service-card">
          <div class="service-icon">🦴</div>
          <h3>Bone Setting &amp; Orthopaedic Care</h3>
          <p>
            Zheng Gu (正骨) — classical orthopaedic system involving manual realignment of joints
            and vertebrae. Applied within a modern biomechanical assessment framework. Treats disc
            herniation, postural kyphosis, cervical nerve impingement, and acute sports injuries.
            Particularly sought after by patients who have not found relief through physiotherapy alone.
          </p>
          <a class="more-link" href="/bone-setting">Full service details</a>
        </div>

        <div class="service-card">
          <div class="service-icon">🌿</div>
          <h3>Herbal Medicine &amp; Internal Consultation</h3>
          <p>
            Begins with full internal consultation — pulse diagnosis, tongue observation, and
            detailed case history. No formula is prescribed without this assessment. GMP-certified
            materials, fully tailored prescriptions. Covers digestive disorders, fatigue, hormonal
            imbalance, skin conditions, and anxiety with sleep disruption.
          </p>
          <a class="more-link" href="/herbal-consultation">Full service details</a>
        </div>
      </div>

      <p style="margin-top:2rem;font-size:0.9rem;color:var(--muted);max-width:60ch">
        Treatments can be combined — your practitioner decides the optimal protocol at assessment, not a fixed package.
      </p>
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       CONDITIONS / CLINICAL FOCUS AREAS
  ═══════════════════════════════════════ -->
  <section class="section">
    <div class="wrap">
      <div class="section-heading">
        <p class="eyebrow">Conditions We Treat</p>
        <h2>Where our clinical expertise makes the most difference</h2>
        <p>
          Our clinical focus is deliberately narrow. We specialise in high-impact areas where our
          integrated combination of acupuncture, manual therapy, and herbal medicine produces
          consistent, verifiable outcomes.
        </p>
      </div>

      <div class="grid-3">
        <div class="spec-card">
          <div class="spec-icon">🦴</div>
          <h3>Chronic Pain &amp; Spinal Problems</h3>
          <p>
            Lumbar disc herniation, sciatica, cervical spondylosis, and sacroiliac joint dysfunction.
            Our combined acupuncture and bone-setting protocol addresses the neurological pain
            component, structural misalignment, and associated muscle tension simultaneously.
          </p>
          <a class="more-link" href="/back-pain">Back Pain &amp; Sciatica</a>
        </div>

        <div class="spec-card">
          <div class="spec-icon">🌸</div>
          <h3>Women's Health &amp; Hormonal Balance</h3>
          <p>
            Postnatal recovery, menstrual irregularity (including PCOS and endometriosis), fertility
            support alongside IVF cycles, perimenopause management, and postpartum recomposition.
            Treatment integrates medical acupuncture with individually prescribed herbal formulae.
          </p>
          <a class="more-link" href="/contact">Enquire about Women's Health</a>
        </div>

        <div class="spec-card">
          <div class="spec-icon">🏃</div>
          <h3>Sports Injuries &amp; Recovery</h3>
          <p>
            Ligament sprains, tendinopathy, muscle tears, and RSI respond exceptionally well to
            our combined Tui Na and acupuncture rehabilitation protocol. We design session-by-session
            rehabilitation programmes and communicate directly with your physiotherapist where appropriate.
          </p>
          <a class="more-link" href="/sports-injuries">Sports Injuries</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       TWO CLINICS
  ═══════════════════════════════════════ -->
  <section class="section-soft">
    <div class="wrap">
      <div class="section-heading">
        <p class="eyebrow">Our Clinics</p>
        <h2>Two Clinics. One Standard of Care.</h2>
        <p>
          Both Yin-Yang locations operate under the same clinical team rotation, matching herbal
          formularies, and synchronised appointment protocols.
        </p>
      </div>

      <div class="grid-2 equal">
        <div class="loc-card">
          <img
            src="/images/screenshot-2025-12-05-at-10.17.22-1VPeecyL0rBlKQh4.jpg"
            alt="Wimbledon clinic"
            loading="lazy"
          />
          <div class="loc-body">
            <p class="loc-sub">South West London · SW19</p>
            <h3>Wimbledon Clinic</h3>
            <div class="loc-row"><strong>Address</strong><span>2 Saint Mark's Place, Wimbledon, London SW19 7ND</span></div>
            <div class="loc-row"><strong>Hours</strong><span>Saturday 9:00 am – 5:00 pm</span></div>
            <div class="loc-row"><strong>Languages</strong><span>Cantonese · Mandarin · English</span></div>
            <div class="loc-row"><strong>Nearest</strong><span>Wimbledon Station (District Line &amp; National Rail)</span></div>
            <a class="btn btn-outline btn-sm" style="margin-top:1.2rem" href="/wimbledon-clinic">Directions &amp; Clinic Info</a>
          </div>
        </div>

        <div class="loc-card">
          <img
            src="/images/ed61151b-8db1-40a1-9f0f-4d9fee7567c5_edi-B2yhs2iysFxKirqN.jpg"
            alt="Reading clinic"
            loading="lazy"
          />
          <div class="loc-body">
            <p class="loc-sub">Berkshire · Castle Street</p>
            <h3>Reading Clinic</h3>
            <div class="loc-row"><strong>Address</strong><span>Reading Health Centre, 61 Castle St, Reading RG1 7SN</span></div>
            <div class="loc-row"><strong>Hours</strong><span>Mon / Wed / Fri 9:00 am – 6:00 pm</span></div>
            <div class="loc-row"><strong>Languages</strong><span>Cantonese · Mandarin · English</span></div>
            <div class="loc-row"><strong>Nearest</strong><span>Reading Station (Elizabeth Line &amp; GWR)</span></div>
            <a class="btn btn-outline btn-sm" style="margin-top:1.2rem" href="/reading-clinic">Directions &amp; Clinic Info</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       WHAT TO EXPECT
  ═══════════════════════════════════════ -->
  <section class="section">
    <div class="wrap">
      <div class="grid-2">
        <div>
          <p class="eyebrow">What to Expect</p>
          <h2>What is a consultation like?</h2>
          <p>
            New patients often arrive uncertain about what TCM assessment involves. Here is exactly
            what happens — from the moment you book to the end of your first treatment session.
          </p>
          <div class="actions" style="margin-top:1.5rem">
            <a class="btn btn-gold" href="https://wa.me/447301949686" target="_blank" rel="noreferrer">Book a Free Consultation</a>
          </div>
        </div>

        <div class="step-list">
          <div class="step-item">
            <div class="step-num">1</div>
            <div>
              <h3>Clinical Consultation</h3>
              <p>
                Comprehensive 1-on-1 assessment. Pulse and tongue diagnosis combined with your
                Western medical history, lifestyle factors, and symptoms to identify the root
                systemic pattern.
              </p>
            </div>
          </div>
          <div class="step-item">
            <div class="step-num">2</div>
            <div>
              <h3>Tailored Treatment</h3>
              <p>
                A personalised combination of modalities during your session — acupuncture for
                neurological regulation, targeted Tui Na or bone setting, or a bespoke prescription
                of GMP-certified herbal medicine.
              </p>
            </div>
          </div>
          <div class="step-item">
            <div class="step-num">3</div>
            <div>
              <h3>Protocol Review</h3>
              <p>
                Chronic conditions rarely resolve in a single session. We systematically review
                your symptomatic progress at every follow-up, refining your treatment to match
                your body's current recovery phase.
              </p>
            </div>
          </div>
          <div class="step-item">
            <div class="step-num">4</div>
            <div>
              <h3>Long-Term Resilience</h3>
              <p>
                Once acute symptoms stabilise, we transition your protocol toward preventative
                care — strengthening long-term resilience and providing lifestyle guidance to
                prevent re-injury.
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Frequency guide -->
      <div style="margin-top:3.5rem">
        <p class="eyebrow">Recommended Treatment Frequency</p>
        <div class="grid-2 equal" style="margin-top:1rem">
          <div style="display:grid;gap:0.5rem">
            {[
              ["Acute pain or injury", "2–3× per week for 2 weeks, then reassess"],
              ["Chronic musculoskeletal", "Weekly for 4–6 weeks, then bi-weekly"],
              ["Women's health", "Weekly, timed to menstrual cycle phase"],
              ["Skin conditions", "Weekly 6–8 weeks; herbal review every 2 weeks"],
            ].map(([cond, freq]) => (
              <div style="display:flex;gap:1rem;align-items:flex-start;padding:0.8rem;border-bottom:1px solid var(--line);font-size:0.93rem">
                <span style="min-width:0;flex:1;font-weight:600">{cond}</span>
                <span style="color:var(--muted);flex:1;text-align:right">{freq}</span>
              </div>
            ))}
          </div>
          <p style="color:var(--muted);font-size:0.9rem;align-self:center">
            These are indicative benchmarks based on typical clinical trajectories. Your practitioner
            will adjust frequency based on your response at each session — we do not prescribe a
            fixed number of sessions in advance.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       FAQ
  ═══════════════════════════════════════ -->
  <section class="section-soft">
    <div class="wrap">
      <div class="grid-2">
        <div>
          <p class="eyebrow">Frequently Asked Questions</p>
          <h2>Questions patients ask before their first booking</h2>
          <p style="color:var(--muted)">
            These are the questions our reception team hears most often from new patients —
            particularly those unfamiliar with how TCM works within the UK healthcare context.
          </p>
        </div>

        <div class="faq-list">
          {[
            {
              q: "Are your practitioners registered in the UK?",
              a: "Yes, fully registered. All our practitioners hold professional degrees and are registered with recognised UK regulatory bodies including BAcC and ATCM. This guarantees we meet strict UK standards for safety, hygiene, and insurance. We also hold original registrations as Certified CMPs in Hong Kong.",
            },
            {
              q: "What languages are consultations conducted in?",
              a: "Fully conducted in English, Cantonese, or Mandarin. UK patients receive clear, jargon-free explanations. HK patients can describe symptoms in their native language and share HK medical notes directly — no translation needed.",
            },
            {
              q: "How many sessions will I need to see results?",
              a: "Acute conditions (recent sports injuries, acute pain): 3–5 sessions typically show measurable improvement. Chronic conditions (long-standing back pain, hormonal imbalances, skin disorders): usually 6–10 sessions to address the root cause and stabilise the condition.",
            },
            {
              q: "Is TCM safe alongside Western medicine?",
              a: "Yes, in the vast majority of cases. Your safety is our priority. During your initial consultation we thoroughly review your current medications and ongoing treatments to avoid any interactions. We will advise you to consult your GP if there is any clinical uncertainty.",
            },
            {
              q: "Do you offer consultations in Cantonese?",
              a: "Yes. All practitioners are fluent in Cantonese and Mandarin. Describe your symptoms exactly as you feel them — no translation loss, full clinical precision.",
            },
          ].map(({ q, a }) => (
            <details class="faq-item">
              <summary>
                {q}
                <span class="faq-chevron">+</span>
              </summary>
              <p class="faq-answer">{a}</p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       CTA SECTION
  ═══════════════════════════════════════ -->
  <CTASection
    heading="Ready to Start Your Treatment?"
    sub="Same-week appointments available at our Wimbledon and Reading clinics. New patients welcome. No referral needed."
  />
</Base>

<script>
  // FAQ toggle icon
  document.querySelectorAll<HTMLDetailsElement>(".faq-item").forEach((item) => {
    item.addEventListener("toggle", () => {
      const chevron = item.querySelector(".faq-chevron");
      if (chevron) chevron.textContent = item.open ? "−" : "+";
    });
  });
</script>
