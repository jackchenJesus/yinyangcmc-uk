---
import Base from "../layouts/Base.astro";
import ContactForm from "../components/ContactForm.astro";
import { clinics, homeConditions, homeServices, practitioners, reviews, site } from "../data/site";
---
<Base title="Chinese Medicine Wimbledon & Reading | Yin-Yang Clinic | yin yang uk" description="Chinese medicine clinic in Reading and Wimbledon. British Acupuncture Council registered. Acupuncture, Tui Na, bone-setting and Chinese herbal medicine consultation. No GP referral needed.">
  <section class="hero">
    <img class="hero-bg" src="/images/acupuncture-back-treatment.webp" alt="" width="1600" height="1067" loading="eager" fetchpriority="high" />
    <div class="hero-scrim" aria-hidden="true"></div>
    <div class="hero-inner">
      <p class="eyebrow" style="color:var(--gold)">Reading &amp; Wimbledon</p>
      <h1>Chinese Medicine in Reading &amp; Wimbledon</h1>
      <p class="lead">Acupuncture · Tui Na · Bone Setting · Herbal Consultation</p>
      <div class="actions" style="justify-content:center">
        <a class="btn btn-gold" href="#booknowform">Book Now</a>
        <a class="btn btn-ghost" href="#treat">View Conditions We Treat</a>
      </div>
    </div>
    <div class="hero-facts" aria-label="Clinic at a glance">
      <div class="wrap home-facts-inner">
        <div class="home-fact">
          <strong>15+</strong>
          <span>Years' experience</span>
        </div>
        <div class="home-fact">
          <strong>2</strong>
          <span>UK clinics</span>
        </div>
        <div class="home-fact">
          <strong>BAcC</strong>
          <span>Registered members</span>
        </div>
        <div class="home-fact">
          <strong>{reviews.rating}</strong>
          <span>Google reviews</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section-soft">
    <div class="wrap grid-2-al home-intro">
      <div>
        <p class="eyebrow">Our clinic</p>
        <h2>Care for local patients<br>in Berkshire &amp; SW London</h2>
        <p class="lead">
          Two UK clinics — <a href="/locations/reading-clinic">Reading town centre</a> and <a href="/locations/wimbledon-clinic">Wimbledon SW19</a>. British Acupuncture Council registered. Recognised by AXA Health, Vitality, Aviva and WPA. <a href="/pricing-and-insurance">View insurance &amp; provider details</a>.
        </p>
        <ul class="home-intro-points">
          <li>No GP referral needed</li>
          <li>English, Cantonese &amp; Mandarin</li>
          <li>Same-week appointments</li>
        </ul>
        <div class="actions" style="margin-top:1.5rem">
          <a class="btn btn-gold" href="https://wa.me/447301949686" target="_blank" rel="noreferrer">Book a Consultation</a>
          <a class="btn btn-outline" href="#services">Clinical services</a>
        </div>
      </div>
      <div class="home-intro-photo">
        <img
          class="rounded-photo"
          src="/images/reading-clinic-treatment-room.webp"
          alt="Treatment room at Yin Yang CMC in Reading"
          width="1600"
          height="1202"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <section class="section" id="treat">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Conditions</p>
        <h2>What Can We Help With?</h2>
        <p>Explore some of the common conditions our practitioners support with acupuncture and traditional Chinese medicine.</p>
      </div>
      <div class="treat-grid">
        {homeConditions.map((c) => (
          <a class="treat-card" href={c.href}>{c.label}</a>
        ))}
      </div>
      <div class="actions" style="justify-content:center;margin-top:1.35rem">
        <a class="btn btn-outline" href="/conditions">View All Conditions</a>
      </div>
    </div>
  </section>

  <section class="section-soft" id="services">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Clinical services</p>
        <h2>How we treat</h2>
        <p>Treatment is chosen after assessment — not from a fixed package.</p>
      </div>
      <div class="home-svc-grid">
        {homeServices.map((s) => (
          <a class="home-svc-card" href={s.href}>
            <strong>{s.label}</strong>
            <span>{s.note}</span>
          </a>
        ))}
      </div>
      <div class="actions" style="justify-content:center;margin-top:1.35rem">
        <a class="btn btn-outline" href="/clinical-services">All clinical services</a>
      </div>
    </div>
  </section>

  <section class="section" id="reviews">
    <div class="wrap">
      <div class="reviews-head">
        <div class="section-head">
          <p class="eyebrow">Google reviews</p>
          <h2>What patients say</h2>
        </div>
        <a class="reviews-rating-pill" href={reviews.googleUrl} target="_blank" rel="noreferrer">
          <strong>{reviews.rating}</strong>
          <span>
            <span class="reviews-stars" aria-hidden="true">★★★★★</span>
            {reviews.count} Google reviews
          </span>
        </a>
      </div>
      <div class="review-slider" data-review-slider>
        <button class="review-nav prev" type="button" aria-label="Previous review">‹</button>
        <div class="review-track">
          {reviews.quotes.map((q) => (
            <article class="review-card">
              <span class="reviews-stars" aria-hidden="true">{"★".repeat(q.stars)}</span>
              <p>“{q.text}”</p>
              <footer>
                <div>
                  <strong>{q.name}</strong>
                  <em>{q.location}</em>
                </div>
                <span class="review-src">Google</span>
              </footer>
            </article>
          ))}
        </div>
        <button class="review-nav next" type="button" aria-label="Next review">›</button>
      </div>
      <div class="review-dots" data-review-dots></div>
    </div>
  </section>

  <section class="section-soft">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">The team</p>
        <h2>Our Practitioners</h2>
        <p>MSc-qualified. UK registered (ATCM &amp; MBAcC). Both work across <a href="/locations/reading-clinic">Reading</a> and <a href="/locations/wimbledon-clinic">Wimbledon</a>.</p>
      </div>
      <div class="home-prac-grid home-prac-teaser">
        {practitioners.map((p) => (
          <a class="prac-portrait prac-teaser" href="/our-practitioners">
            <img src={p.image} alt={`Portrait of ${p.name}`} width="800" height="882" loading="lazy" />
            <div class="prac-body">
              <h3>{p.name}</h3>
              <span class="prac-role">{p.role}</span>
              <p>{p.summary}</p>
            </div>
          </a>
        ))}
      </div>
      <div class="actions" style="justify-content:center;margin-top:1.6rem">
        <a class="btn btn-outline" href="/our-practitioners">Meet our practitioners</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Visit Us</p>
        <h2>Two Clinics. One Standard of Care.</h2>
      </div>
      <div class="home-loc-grid">
        <article class="loc-card">
          <img src="/images/reading-clinic-interior.webp" alt="Reception and hallway at the Reading clinic" width="1600" height="1010" loading="lazy" />
          <div class="loc-body">
            <span class="loc-tag">Berkshire · Castle Street</span>
            <h3>Reading</h3>
            <p class="loc-meta">{clinics.reading.address}<br>{clinics.reading.hours} · By appointment</p>
            <div class="loc-actions">
              <a class="btn btn-outline btn-sm" href="/locations/reading-clinic">Reading clinic</a>
              <a class="btn btn-gold btn-sm" href="https://wa.me/447301949686" target="_blank" rel="noreferrer">Book</a>
            </div>
          </div>
        </article>
        <article class="loc-card">
          <img src="/images/wimbledon-clinic-interior.webp" alt="Reception area at the Wimbledon clinic" width="1600" height="869" loading="lazy" />
          <div class="loc-body">
            <span class="loc-tag">South West London · SW19</span>
            <h3>Wimbledon</h3>
            <p class="loc-meta">{clinics.wimbledon.address}<br>{clinics.wimbledon.hours} · By appointment</p>
            <div class="loc-actions">
              <a class="btn btn-outline btn-sm" href="/locations/wimbledon-clinic">Wimbledon clinic</a>
              <a class="btn btn-gold btn-sm" href="https://wa.me/447301949686" target="_blank" rel="noreferrer">Book</a>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="home-heritage" aria-label="Clinic history">
    <div class="wrap heritage-inner">
      <p class="eyebrow">Established in 2014</p>
      <p>Originally founded in Hong Kong, Yin Yang Chinese Medical now brings the same experienced, patient-focused approach to our clinics in Reading and Wimbledon.</p>
      <a class="heritage-link" href="https://www.yinyangcmc.com" target="_blank" rel="noreferrer">Hong Kong clinic site</a>
    </div>
  </section>

  <section class="section" id="booknowform">
    <div class="wrap grid-2">
      <div>
        <p class="eyebrow">Book Now</p>
        <h2>Reach us anytime</h2>
        <p>We usually respond within the hour during clinic hours.</p>
        <p><strong>WhatsApp:</strong> <a href={site.whatsapp} style="color:var(--teal);font-weight:700">{site.phoneDisplay}</a></p>
        <p><strong>Email:</strong> <a href={`mailto:${site.email}`} style="color:var(--teal);font-weight:700">{site.email}</a></p>
      </div>
      <ContactForm messageRows={5} />
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "MedicalBusiness",
    name: "Yin Yang CMC",
    url: "https://yinyangcmc.uk",
    telephone: site.phoneIntl,
    email: site.email,
    areaServed: ["Reading", "Wimbledon", "Berkshire", "South West London"],
    aggregateRating: {
      "@type": "AggregateRating",
      ratingValue: reviews.rating,
      reviewCount: reviews.count,
      bestRating: "5",
    },
  })} />
  <script>
    const root = document.querySelector("[data-review-slider]");
    const track = root?.querySelector(".review-track");
    const dotsWrap = document.querySelector("[data-review-dots]");
    if (root && track instanceof HTMLElement && dotsWrap) {
      const cards = [...track.children] as HTMLElement[];
      cards.forEach((_, i) => {
        const dot = document.createElement("button");
        dot.type = "button";
        dot.setAttribute("aria-label", `Go to review ${i + 1}`);
        if (i === 0) dot.classList.add("is-active");
        dot.addEventListener("click", () => cards[i].scrollIntoView({ behavior: "smooth", inline: "start", block: "nearest" }));
        dotsWrap.append(dot);
      });
      const step = () => cards[0]?.getBoundingClientRect().width + 18;
      root.querySelector(".review-nav.prev")?.addEventListener("click", () => {
        track.scrollBy({ left: -step(), behavior: "smooth" });
      });
      root.querySelector(".review-nav.next")?.addEventListener("click", () => {
        const max = track.scrollWidth - track.clientWidth - 8;
        if (track.scrollLeft >= max) track.scrollTo({ left: 0, behavior: "smooth" });
        else track.scrollBy({ left: step(), behavior: "smooth" });
      });
      const syncDots = () => {
        const i = Math.round(track.scrollLeft / step());
        dotsWrap.querySelectorAll("button").forEach((d, n) => d.classList.toggle("is-active", n === i));
      };
      track.addEventListener("scroll", syncDots, { passive: true });
      let timer = window.setInterval(() => {
        root.querySelector<HTMLButtonElement>(".review-nav.next")?.click();
      }, 5500);
      root.addEventListener("mouseenter", () => window.clearInterval(timer));
      root.addEventListener("mouseleave", () => {
        timer = window.setInterval(() => {
          root.querySelector<HTMLButtonElement>(".review-nav.next")?.click();
        }, 5500);
      });
    }
  </script>
</Base>
