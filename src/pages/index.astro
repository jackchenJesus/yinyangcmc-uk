---
import Base from "../layouts/Base.astro";
import { clinics, site } from "../data/site";
---
<Base title="Chinese Medicine Wimbledon & Reading | Yin-Yang Clinic | yin yang uk" description="Looking for a trusted Chinese medicine Wimbledon or Chinese medicine Reading clinic? Our expert team offers expert acupuncture, bone-setting, and herbal care.">
  <section class="hero">
    <img class="bg" src="/images/webbanner-eQwGJSc8Re6udP6z.jpg" alt="" />
    <div class="hero-copy">
      <p class="eyebrow">Yin Yang CMC</p>
      <h1>Modern TCM & Wellness Centre</h1>
      <p>(include acupuncture, acupressure, massage, manipulation / bone setting)</p>
      <div class="actions" style="justify-content:center">
        <a class="btn btn-gold" href="#booknowform">Book Now</a>
        <a class="btn btn-ghost" href="/clinical-services">Clinical Services</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap cards grid-4">
      {[
        ["/images/label_acupuncture_white-sVIFuDil6Vi0omnp.png", "/acupuncture", "Acupuncture"],
        ["/images/label_ipm_white-vMTHbj4InE8W2YbM.png", "/tui-na-massage", "Tui Na & pain care"],
        ["/images/label_herbal_medicine_white-Azozow4y5JPdMMVy.png", "/herbal-consultation", "Herbal medicine"],
        ["/images/label_other_white-ilyOGIeZEF3BJ6hg.png", "/other-treatment", "Other treatments"],
      ].map(([src, href, label]) => (
        <a class="card" href={href}>
          <img src={src} alt={label} />
        </a>
      ))}
    </div>
  </section>

  <section class="section alt" id="ukclinic">
    <div class="wrap">
      <p class="eyebrow">Our Clinics</p>
      <h2>UNITED KINGDOM</h2>
      <p>Yin-Yang CMC's overseas clinics are now open in Wimbledon and Reading, dedicated to providing high-quality Chinese medicine services, especially in pain management and chronic health concerns.</p>
      <h2>HONG KONG</h2>
      <p>Yin-Yang CMC currently has clinics in To Kwa Wan and Mei Foo. All resident Chinese Medicine Practitioners (CMPs) hold registered qualifications recognised by the Chinese Medicine Council of Hong Kong, possess Bachelor's, Master's, or higher degrees in Chinese Medicine, and have undergone advanced training at public and private medical institutions or at Yin-Yang CMC itself.</p>
      <a class="btn btn-outline" href="https://www.yinyangcmc.com" target="_blank" rel="noreferrer">Hong Kong site</a>
    </div>
  </section>

  <section class="section">
    <div class="wrap grid-2">
      <div>
        <p class="eyebrow">About Yin Yang UK</p>
        <h2>15+ Years of Trusted Experience</h2>
        <p>Welcome to Yin-Yang Chinese Medicine Clinic, a trusted provider of high-quality traditional Chinese medicine (TCM) services. Established in Hong Kong in 2014, our clinic is dedicated to promoting the essence of TCM by integrating ancient wisdom with modern medical practices. With branches in Hong Kong and now in the UK, we aim to bring professional and personalized care to our patients, addressing pain management, internal medicine, and various chronic conditions.</p>
        <p>Our team of licensed practitioners, trained in Hong Kong and internationally, specializes in acupuncture, Tui Na (therapeutic massage), and herbal medicine. Whether you are seeking relief from pain, treatment for internal disorders, or holistic wellness solutions, we are here to help restore balance and harmony to your health. Let us guide you on your journey to well-being, wherever you are.</p>
      </div>
      <img src="/images/img_6058-eVlfhKuykGV6M98J.jpg" alt="Yin Yang CMC clinic" style="border-radius:18px;height:100%;object-fit:cover" />
    </div>
  </section>

  <section class="section alt">
    <div class="wrap">
      <p class="eyebrow">Your health, our priority. Expert care with a personal touch.</p>
      <h2>Our Theraptists</h2>
      <div class="cards cards-2" style="margin-top:1.5rem">
        <article class="therapist">
          <img src="/images/e--ae-a-_edited-XhbCA7G3Oou0Mlsq.jpg" alt="Shing Hui (Winton)" />
          <div>
            <h3>Shing Hui (Winton)</h3>
            <p>Chinese Medicine Practitioner</p>
            <p>Registered Chinese Medicine Practitioner in Hong Kong. Graduated from the School of Chinese Medicine, Chinese University of Hong Kong in 2010 with a Bachelor's degree in TCM and a Master of Science in Chinese Medicine. Previously a Tui Na specialist at Tung Wah Eastern Hospital (HK) and orthopaedic consultant for Yin-Yang CMC in Hong Kong. Specialises in acupuncture and Tui Na orthopedic techniques for soft tissue injuries, joint swelling, restricted movement, cervical and lumbar spine disorders, and complex pain conditions.</p>
            <p class="muted">ATCM FM0250005 · MBAcC 963087</p>
          </div>
        </article>
        <article class="therapist">
          <img src="/images/aeeppsc-c-e-a-_edited_edited-a6uAksf7EtvBGWTM.jpg" alt="Chui Ying Li (Andrea)" />
          <div>
            <h3>Chui Ying Li (Andrea)</h3>
            <p>Chinese Medicine Practitioner</p>
            <p>Registered Chinese Medicine Practitioner in Hong Kong. Graduated from the School of Chinese Medicine, Chinese University of Hong Kong in 2010 with a Bachelor's degree in TCM and a Master of Science in Chinese Medicine. Consultant practitioner at Yin-Yang CMC in Hong Kong. Specialises in dermatology and gynaecology/paediatrics, including infertility, prenatal and postnatal disorders, postpartum pelvic adjustment, and body sculpting, with additional expertise in acupuncture and Tui Na orthopedics.</p>
            <p class="muted">ATCM FM0250004 · MBAcC 963093</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap cards cards-2">
      <article class="card">
        <img src="/images/ed61151b-8db1-40a1-9f0f-4d9fee7567c5_edi-B2yhs2iysFxKirqN.jpg" alt="Reading clinic" />
        <div class="card-body">
          <h3>Reading</h3>
          <p>{clinics.reading.subtitle}</p>
          <p>{clinics.reading.address}</p>
          <p>{clinics.reading.hours}</p>
          <a class="more" href="/reading-clinic">Detail</a>
        </div>
      </article>
      <article class="card">
        <img src="/images/screenshot-2025-12-05-at-10.17.22-1VPeecyL0rBlKQh4.jpg" alt="Wimbledon clinic" />
        <div class="card-body">
          <h3>Wimbledon</h3>
          <p>{clinics.wimbledon.subtitle}</p>
          <p>{clinics.wimbledon.address}</p>
          <p>{clinics.wimbledon.hours}</p>
          <a class="more" href="/wimbledon-clinic">Detail</a>
        </div>
      </article>
    </div>
  </section>

  <section class="section alt" id="booknowform">
    <div class="wrap grid-2">
      <div>
        <h2>BOOK NOW</h2>
        <p>Reach us anytime — we usually respond within the hour.</p>
        <p><strong>WhatsApp UK Clinic:</strong> <a href={site.whatsapp}>{site.phoneDisplay}</a></p>
        <p><strong>Email:</strong> <a href={`mailto:${site.email}`}>{site.email}</a></p>
      </div>
      <form class="form" action={`mailto:${site.email}`} method="post" enctype="text/plain">
        <input name="name" placeholder="Full name" required />
        <input type="email" name="email" placeholder="Email" required />
        <select name="clinic">
          <option>Reading clinic</option>
          <option>Wimbledon clinic</option>
        </select>
        <textarea name="message" rows="5" placeholder="Message" required></textarea>
        <button class="btn btn-gold" type="submit">Submit</button>
      </form>
    </div>
  </section>
</Base>
