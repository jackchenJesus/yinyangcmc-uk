---
import Base from "../layouts/Base.astro";
import { clinics, site } from "../data/site";
---
<Base title="Chinese Medicine Wimbledon & Reading | Yin-Yang Clinic | yin yang uk" description="Looking for a trusted Chinese medicine Wimbledon or Chinese medicine Reading clinic? Our expert team offers expert acupuncture, bone-setting, and herbal care.">
  <section class="hero">
    <img class="hero-bg" src="/images/webbanner-eQwGJSc8Re6udP6z.jpg" alt="" />
    <div class="hero-inner">
      <p class="eyebrow" style="color:var(--gold)">Yin Yang CMC · Reading &amp; Wimbledon</p>
      <h1>Modern TCM &amp; Wellness Centre</h1>
      <p class="lead">Acupuncture · Tui Na · Bone setting · Herbal medicine</p>
      <div class="actions" style="justify-content:center">
        <a class="btn btn-gold" href="#booknowform">Book Now</a>
        <a class="btn btn-ghost" href="/clinical-services">Clinical Services</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap grid-4">
      {[
        ["/images/label_acupuncture_white-sVIFuDil6Vi0omnp.png", "/acupuncture", "Acupuncture"],
        ["/images/label_ipm_white-vMTHbj4InE8W2YbM.png", "/tui-na-massage", "Tui Na & pain care"],
        ["/images/label_herbal_medicine_white-Azozow4y5JPdMMVy.png", "/herbal-consultation", "Herbal medicine"],
        ["/images/label_other_white-ilyOGIeZEF3BJ6hg.png", "/other-treatment", "Other treatments"],
      ].map(([src, href, label]) => (
        <a class="home-svc" href={href}>
          <img src={src} alt={label} />
        </a>
      ))}
    </div>
  </section>

  <section class="section-soft">
    <div class="wrap grid-2-al" style="gap:4rem">
      <div>
        <div class="rating-row">
          <span class="rating-stars" aria-hidden="true">★★★★★</span>
          <span>4.9 · 15 Google reviews</span>
        </div>
        <p class="cred-line">MSc-qualified practitioners · UK registered (ATCM &amp; MBAcC) · Reading Health Centre, 61 Castle Street</p>
        <p>
          Welcome to Yin-Yang Chinese Medicine Clinic, a trusted provider of high-quality traditional Chinese medicine (TCM) services. Established in Hong Kong in 2014, our clinic is dedicated to promoting the essence of TCM by integrating ancient wisdom with modern medical practices. With branches in Hong Kong and now in the UK, we aim to bring professional and personalized care to our patients, addressing pain management, internal medicine, and various chronic conditions.
        </p>
        <p>
          Our team of licensed practitioners, trained in Hong Kong and internationally, specializes in acupuncture, Tui Na (therapeutic massage), and herbal medicine. Winton Hui focuses on acupuncture and Tui Na orthopaedic techniques for soft-tissue injuries, joint restriction, and spinal pain. Andrea Li specialises in dermatology, gynaecology and paediatrics, including postnatal recovery and fertility support.
        </p>
        <div class="actions" style="margin-top:1.4rem">
          <a class="btn btn-gold" href="https://wa.me/447301949686" target="_blank" rel="noreferrer">Book a Consultation</a>
          <a class="btn btn-outline" href="/clinical-services">Explore Services</a>
        </div>
      </div>
      <img
        class="rounded-photo"
        src="/images/img_6058-eVlfhKuykGV6M98J.jpg"
        alt="Yin Yang CMC clinic interior"
      />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Our Clinics</p>
      <h2>United Kingdom</h2>
      <p class="lead" style="max-width:68ch">
        Yin-Yang CMC's overseas clinics are now open in Wimbledon and Reading, dedicated to providing high-quality Chinese medicine services, especially in pain management and chronic health concerns.
      </p>
      <h2 style="margin-top:2.2rem">Hong Kong</h2>
      <p style="max-width:68ch">
        Yin-Yang CMC currently has clinics in To Kwa Wan and Mei Foo. All resident Chinese Medicine Practitioners (CMPs) hold registered qualifications recognised by the Chinese Medicine Council of Hong Kong, possess Bachelor's, Master's, or higher degrees in Chinese Medicine, and have undergone advanced training at public and private medical institutions or at Yin-Yang CMC itself.
      </p>
      <a class="btn btn-outline" href="https://www.yinyangcmc.com" target="_blank" rel="noreferrer">Hong Kong site</a>
    </div>
  </section>

  <section class="section-soft">
    <div class="wrap">
      <p class="eyebrow">Your health, our priority</p>
      <h2>Our Practitioners</h2>
      <div class="grid-2" style="margin-top:1.6rem">
        <article class="prac-card">
          <img src="/images/e--ae-a-_edited-XhbCA7G3Oou0Mlsq.jpg" alt="Shing Hui (Winton)" />
          <div class="prac-body">
            <h3>Shing Hui (Winton)</h3>
            <span class="prac-role">Chinese Medicine Practitioner</span>
            <p>Registered Chinese Medicine Practitioner in Hong Kong. Graduated from the School of Chinese Medicine, Chinese University of Hong Kong in 2010 with a Bachelor's degree in TCM and a Master of Science in Chinese Medicine. Previously a Tui Na specialist at Tung Wah Eastern Hospital (HK) and orthopaedic consultant for Yin-Yang CMC in Hong Kong. Specialises in acupuncture and Tui Na orthopedic techniques for soft tissue injuries, joint swelling, restricted movement, cervical and lumbar spine disorders, and complex pain conditions.</p>
            <p class="prac-reg">ATCM FM0250005 · MBAcC 963087</p>
          </div>
        </article>
        <article class="prac-card">
          <img src="/images/aeeppsc-c-e-a-_edited_edited-a6uAksf7EtvBGWTM.jpg" alt="Chui Ying Li (Andrea)" />
          <div class="prac-body">
            <h3>Chui Ying Li (Andrea)</h3>
            <span class="prac-role">Chinese Medicine Practitioner</span>
            <p>Registered Chinese Medicine Practitioner in Hong Kong. Graduated from the School of Chinese Medicine, Chinese University of Hong Kong in 2010 with a Bachelor's degree in TCM and a Master of Science in Chinese Medicine. Consultant practitioner at Yin-Yang CMC in Hong Kong. Specialises in dermatology and gynaecology/paediatrics, including infertility, prenatal and postnatal disorders, postpartum pelvic adjustment, and body sculpting, with additional expertise in acupuncture and Tui Na orthopedics.</p>
            <p class="prac-reg">ATCM FM0250004 · MBAcC 963093</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Visit Us</p>
        <h2>Two Clinics. One Standard of Care.</h2>
      </div>
      <div class="grid-2">
        <article class="loc-card">
          <img src="/images/ed61151b-8db1-40a1-9f0f-4d9fee7567c5_edi-B2yhs2iysFxKirqN.jpg" alt="Reading clinic" />
          <div class="loc-body">
            <span class="loc-tag">Berkshire · Castle Street</span>
            <h3>Reading</h3>
            <div class="loc-row"><strong>Clinic</strong><span>{clinics.reading.subtitle}</span></div>
            <div class="loc-row"><strong>Address</strong><span>{clinics.reading.address}</span></div>
            <div class="loc-row"><strong>Hours</strong><span>{clinics.reading.hours}</span></div>
            <div class="loc-actions">
              <a class="btn btn-outline btn-sm" href="/reading-clinic">Clinic details</a>
              <a class="btn btn-gold btn-sm" href="https://wa.me/447301949686" target="_blank" rel="noreferrer">Book</a>
            </div>
          </div>
        </article>
        <article class="loc-card">
          <img src="/images/screenshot-2025-12-05-at-10.17.22-1VPeecyL0rBlKQh4.jpg" alt="Wimbledon clinic" />
          <div class="loc-body">
            <span class="loc-tag">South West London · SW19</span>
            <h3>Wimbledon</h3>
            <div class="loc-row"><strong>Clinic</strong><span>{clinics.wimbledon.subtitle}</span></div>
            <div class="loc-row"><strong>Address</strong><span>{clinics.wimbledon.address}</span></div>
            <div class="loc-row"><strong>Hours</strong><span>{clinics.wimbledon.hours}</span></div>
            <div class="loc-actions">
              <a class="btn btn-outline btn-sm" href="/wimbledon-clinic">Clinic details</a>
              <a class="btn btn-gold btn-sm" href="https://wa.me/447301949686" target="_blank" rel="noreferrer">Book</a>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="section-soft" id="booknowform">
    <div class="wrap grid-2">
      <div>
        <p class="eyebrow">Book Now</p>
        <h2>Reach us anytime</h2>
        <p>We usually respond within the hour during clinic hours.</p>
        <p><strong>WhatsApp:</strong> <a href={site.whatsapp} style="color:var(--teal);font-weight:700">{site.phoneDisplay}</a></p>
        <p><strong>Email:</strong> <a href={`mailto:${site.email}`} style="color:var(--teal);font-weight:700">{site.email}</a></p>
      </div>
      <form class="form" action={`mailto:${site.email}`} method="post" enctype="text/plain">
        <input name="name" placeholder="Full name" required />
        <input type="email" name="email" placeholder="Email" required />
        <select name="clinic">
          <option>Reading clinic</option>
          <option>Wimbledon clinic</option>
        </select>
        <textarea name="message" rows="5" placeholder="Message" required></textarea>
        <button class="btn btn-gold" type="submit">Submit</button>
      </form>
    </div>
  </section>
</Base>
