---
import Base from "../layouts/Base.astro";
import { clinics, site } from "../data/site";
---
<Base title="Chinese Medicine Wimbledon & Reading | Yin-Yang Clinic | yin yang uk" description="Looking for a trusted Chinese medicine Wimbledon or Chinese medicine Reading clinic? Our expert team offers expert acupuncture, bone-setting, and herbal care.">
  <section class="hero">
    <img class="hero-bg" src="/images/webbanner-eQwGJSc8Re6udP6z.jpg" alt="" />
    <div class="hero-inner">
      <p class="eyebrow" style="color:var(--gold)">Yin Yang CMC · Reading &amp; Wimbledon</p>
      <h1>Modern TCM &amp; Wellness Centre</h1>
      <p class="lead">Acupuncture · Tui Na · Bone setting · Herbal medicine</p>
      <div class="actions" style="justify-content:center">
        <a class="btn btn-gold" href="#booknowform">Book Now</a>
        <a class="btn btn-ghost" href="/clinical-services">Clinical Services</a>
      </div>
    </div>
  </section>

  <section class="home-facts" aria-label="Clinic at a glance">
    <div class="wrap home-facts-inner">
      <div class="home-fact">
        <strong>2014</strong>
        <span>Founded in Hong Kong</span>
      </div>
      <div class="home-fact">
        <strong>2</strong>
        <span>UK clinics</span>
      </div>
      <div class="home-fact">
        <strong>MSc</strong>
        <span>Qualified practitioners</span>
      </div>
      <div class="home-fact">
        <strong>4.9</strong>
        <span>Google reviews</span>
      </div>
    </div>
  </section>

  <section class="section-soft">
    <div class="wrap grid-2-al home-intro">
      <div>
        <p class="eyebrow">Our clinic</p>
        <h2>Hong Kong roots.<br>UK care.</h2>
        <p class="lead">
          Established in 2014. Now in Reading and Wimbledon — registered Chinese medicine in a calm, modern clinic.
        </p>
        <ul class="home-intro-points">
          <li>UK registered · ATCM &amp; MBAcC</li>
          <li>English, Cantonese &amp; Mandarin</li>
          <li>By appointment at both clinics</li>
        </ul>
        <div class="actions" style="margin-top:1.5rem">
          <a class="btn btn-gold" href="https://wa.me/447301949686" target="_blank" rel="noreferrer">Book a Consultation</a>
          <a class="btn btn-outline" href="/clinical-services">Explore Services</a>
        </div>
      </div>
      <div class="home-intro-photo">
        <img
          class="rounded-photo"
          src="/images/img_6058-eVlfhKuykGV6M98J.jpg"
          alt="Treatment room at Yin Yang CMC"
        />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Our Clinics</p>
        <h2>One practice. Two countries.</h2>
      </div>
      <div class="origin-grid">
        <article class="origin-card origin-uk">
          <img src="/images/ed61151b-8db1-40a1-9f0f-4d9fee7567c5_edi_2-M3Nk8jihE1285fVW.jpg" alt="Yin Yang CMC Reading clinic" />
          <div class="origin-copy">
            <span class="loc-tag">United Kingdom</span>
            <h3>Wimbledon &amp; Reading</h3>
            <p>Chinese medicine for pain, recovery, and long-term health — same clinical standard at both UK sites.</p>
          </div>
        </article>
        <article class="origin-card origin-hk">
          <span class="origin-mark" aria-hidden="true">香港</span>
          <div class="origin-copy">
            <span class="loc-tag">Est. 2014</span>
            <h3>Hong Kong</h3>
            <p class="origin-locs">To Kwa Wan · Mei Foo</p>
            <p>Registered CMPs with recognised qualifications and advanced clinical training.</p>
          </div>
          <a class="btn btn-ghost btn-sm" href="https://www.yinyangcmc.com" target="_blank" rel="noreferrer">Hong Kong site</a>
        </article>
      </div>
    </div>
  </section>

  <section class="section-soft">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Your health, our priority</p>
        <h2>Our Practitioners</h2>
      </div>
      <div class="home-prac-grid">
        <article class="prac-portrait">
          <img src="/images/e--ae-a-_edited-XhbCA7G3Oou0Mlsq.jpg" alt="Shing Hui (Winton)" />
          <div class="prac-body">
            <h3>Shing Hui (Winton)</h3>
            <span class="prac-role">Musculoskeletal &amp; pain</span>
            <p>MSc Chinese Medicine, CUHK. Acupuncture and Tui Na for joints, spine, and soft-tissue injury.</p>
            <div class="prac-tags">
              <span>Acupuncture</span>
              <span>Tui Na</span>
              <span>Spine &amp; joints</span>
            </div>
            <p class="prac-reg">ATCM FM0250005 · MBAcC 963087</p>
          </div>
        </article>
        <article class="prac-portrait">
          <img src="/images/aeeppsc-c-e-a-_edited_edited-a6uAksf7EtvBGWTM.jpg" alt="Chui Ying Li (Andrea)" />
          <div class="prac-body">
            <h3>Chui Ying Li (Andrea)</h3>
            <span class="prac-role">Women's health &amp; dermatology</span>
            <p>MSc Chinese Medicine, CUHK. Fertility, postnatal care, paediatrics, and skin conditions.</p>
            <div class="prac-tags">
              <span>Women's health</span>
              <span>Dermatology</span>
              <span>Paediatrics</span>
            </div>
            <p class="prac-reg">ATCM FM0250004 · MBAcC 963093</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Visit Us</p>
        <h2>Two Clinics. One Standard of Care.</h2>
      </div>
      <div class="home-loc-grid">
        <article class="loc-card">
          <img src="/images/ed61151b-8db1-40a1-9f0f-4d9fee7567c5_edi-B2yhs2iysFxKirqN.jpg" alt="Reading clinic" />
          <div class="loc-body">
            <span class="loc-tag">Berkshire · Castle Street</span>
            <h3>Reading</h3>
            <p class="loc-meta">{clinics.reading.address}<br>{clinics.reading.hours} · By appointment</p>
            <div class="loc-actions">
              <a class="btn btn-outline btn-sm" href="/reading-clinic">Clinic details</a>
              <a class="btn btn-gold btn-sm" href="https://wa.me/447301949686" target="_blank" rel="noreferrer">Book</a>
            </div>
          </div>
        </article>
        <article class="loc-card">
          <img src="/images/screenshot-2025-12-05-at-10.17.22-1VPeecyL0rBlKQh4.jpg" alt="Wimbledon clinic" />
          <div class="loc-body">
            <span class="loc-tag">South West London · SW19</span>
            <h3>Wimbledon</h3>
            <p class="loc-meta">{clinics.wimbledon.address}<br>{clinics.wimbledon.hours} · By appointment</p>
            <div class="loc-actions">
              <a class="btn btn-outline btn-sm" href="/wimbledon-clinic">Clinic details</a>
              <a class="btn btn-gold btn-sm" href="https://wa.me/447301949686" target="_blank" rel="noreferrer">Book</a>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="section-soft" id="booknowform">
    <div class="wrap grid-2">
      <div>
        <p class="eyebrow">Book Now</p>
        <h2>Reach us anytime</h2>
        <p>We usually respond within the hour during clinic hours.</p>
        <p><strong>WhatsApp:</strong> <a href={site.whatsapp} style="color:var(--teal);font-weight:700">{site.phoneDisplay}</a></p>
        <p><strong>Email:</strong> <a href={`mailto:${site.email}`} style="color:var(--teal);font-weight:700">{site.email}</a></p>
      </div>
      <form class="form" action={`mailto:${site.email}`} method="post" enctype="text/plain">
        <input name="name" placeholder="Full name" required />
        <input type="email" name="email" placeholder="Email" required />
        <select name="clinic">
          <option>Reading clinic</option>
          <option>Wimbledon clinic</option>
        </select>
        <textarea name="message" rows="5" placeholder="Message" required></textarea>
        <button class="btn btn-gold" type="submit">Submit</button>
      </form>
    </div>
  </section>
</Base>
