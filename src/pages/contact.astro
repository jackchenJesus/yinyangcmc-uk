---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import CTASection from "../components/CTASection.astro";
import { clinics, site } from "../data/site";
---
<Base title="Contact TCM Clinic Wimbledon & Reading | Yin-Yang Clinic | yin yang uk" description="Need to contact TCM clinic Wimbledon or contact TCM clinic Reading? Get our phone numbers, clinic addresses, map routes, opening hours, and booking details.">
  <PageHero
    title="Contact Us"
    lede="Reach us anytime — WhatsApp, phone, or the form below. Same-week appointments at Reading and Wimbledon."
    ctaLabel="WhatsApp Us"
    ctaHref={site.whatsapp}
    ctaSecLabel="Call the clinic"
    ctaSecHref={`tel:${site.phoneIntl}`}
  />

  <section class="section">
    <div class="wrap grid-2" style="gap:2.5rem">
      <article class="loc-card">
        <img
          src="/images/reading-clinic-interior.webp"
          alt="Reception and hallway at the Reading clinic"
          width="1600"
          height="1010"
          loading="lazy"
        />
        <div class="loc-body">
          <span class="loc-tag">Berkshire · Castle Street</span>
          <h2 style="font-size:1.45rem">Reading</h2>
          <div class="loc-row"><strong>Clinic</strong><span>{clinics.reading.subtitle}</span></div>
          <div class="loc-row"><strong>Address</strong><span>{clinics.reading.address}</span></div>
          <div class="loc-row"><strong>Hours</strong><span>{clinics.reading.hours}</span></div>
          <div class="loc-actions">
            <a class="btn btn-outline btn-sm" href={clinics.reading.maps} target="_blank" rel="noreferrer">Open map</a>
            <a class="btn btn-gold btn-sm" href="/reading-clinic">Clinic details</a>
          </div>
        </div>
      </article>

      <article class="loc-card">
        <img
          src="/images/wimbledon-clinic-interior.webp"
          alt="Reception area at the Wimbledon clinic"
          width="1600"
          height="869"
          loading="lazy"
        />
        <div class="loc-body">
          <span class="loc-tag">South West London · SW19</span>
          <h2 style="font-size:1.45rem">Wimbledon</h2>
          <div class="loc-row"><strong>Clinic</strong><span>{clinics.wimbledon.subtitle}</span></div>
          <div class="loc-row"><strong>Address</strong><span>{clinics.wimbledon.address}</span></div>
          <div class="loc-row"><strong>Hours</strong><span>{clinics.wimbledon.hours}</span></div>
          <div class="loc-actions">
            <a class="btn btn-outline btn-sm" href={clinics.wimbledon.maps} target="_blank" rel="noreferrer">Open map</a>
            <a class="btn btn-gold btn-sm" href="/wimbledon-clinic">Clinic details</a>
          </div>
        </div>
      </article>
    </div>
  </section>

  <section class="section-soft">
    <div class="wrap grid-2">
      <div>
        <p class="eyebrow">Send a Message</p>
        <h2>We usually respond within the hour</h2>
        <p>WhatsApp is the fastest way to book. You can also email or use the form.</p>
        <p><strong>WhatsApp:</strong> <a href={site.whatsapp} style="color:var(--teal);font-weight:700">{site.phoneDisplay}</a></p>
        <p><strong>Email:</strong> <a href={`mailto:${site.email}`} style="color:var(--teal);font-weight:700">{site.email}</a></p>
      </div>
      <form class="form" action={`mailto:${site.email}`} method="post" enctype="text/plain">
        <input name="name" placeholder="Full name" required />
        <input type="email" name="email" placeholder="Email" required />
        <select name="clinic">
          <option>Reading clinic</option>
          <option>Wimbledon clinic</option>
        </select>
        <textarea name="message" rows="6" placeholder="Message" required></textarea>
        <button class="btn btn-gold" type="submit">Submit</button>
      </form>
    </div>
  </section>

  <CTASection
    heading="Ready to book?"
    sub="Same-week appointments at Reading and Wimbledon. New patients welcome — no referral needed."
  />
</Base>
