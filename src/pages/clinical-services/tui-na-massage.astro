---
import Base from "../../layouts/Base.astro";
import FAQAccordion from "../../components/FAQAccordion.astro";
import CTASection from "../../components/CTASection.astro";

const faqItems = [
  {
    q: "How many sessions until I see results?",
    a: "Acute conditions (under 4 weeks onset) typically show measurable improvement within 2–3 sessions. Chronic conditions (3+ months) generally require a 4–6 session course before structural change stabilises. Your practitioner will give a realistic timeline at the first appointment — not an open-ended commitment.",
  },
  {
    q: "Can Tui Na and acupuncture be done in the same session?",
    a: "Yes, and it is often clinically preferable. Acupuncture addresses the neurological pain signal; Tui Na addresses the mechanical and soft tissue component. Combined sessions may produce faster functional recovery than either modality alone. Your practitioner will advise whether a combined approach is appropriate for your presentation.",
  },
  {
    q: "Is Tui Na suitable for pregnant women or elderly patients?",
    a: "Pregnancy and advanced age are not contraindications, but they require technique modification. Our practitioners are trained in perinatal TCM. Certain techniques are avoided in the first trimester. Please disclose pregnancy when booking so the appropriate session format can be arranged.",
  },
  {
    q: "What should I bring to my first appointment?",
    a: "Bring any relevant imaging (X-ray, MRI) if you have it — helpful but not required. Wear loose-fitting clothing that allows access to the back, shoulders, and legs. Arriving 5–10 minutes early allows time to complete the intake form.",
  },
  {
    q: "Are your practitioners registered in the UK?",
    a: "Yes. Both practitioners are registered members of the British Acupuncture Council (MBAcC), listed on the Professional Standards Authority's Accredited Register, and registered with the Association of Traditional Chinese Medicine & Acupuncture (ATCM). Member nos: 963087 & 963093.",
  },
  {
    q: "Do you accept health insurance for Tui Na?",
    a: "We are recognised by AXA Health, Vitality, Aviva and WPA. Provider recognition does not mean Tui Na is automatically covered. Check your individual policy with your insurer before treatment. Provider numbers are on our Pricing & Insurance page.",
  },
];
---
<Base
  title="Tui Na Wimbledon & Reading | Therapeutic Massage Clinic | Yin Yang CMC"
  description="Professional Tui Na therapeutic massage in Wimbledon & Reading. British Acupuncture Council registered. Clinical Chinese medicine manual therapy for pain and injury."
>


<!-- ═══════════════════════════════════════════════
     §1 HERO
═══════════════════════════════════════════════ -->
<section class="page-hero" style="min-height:68vh;display:grid;place-items:center">
  <img
    class="page-hero-bg"
    src="/images/tui-na-massage-treatment.webp"
    alt=""
    loading="eager"
    fetchpriority="high"
  />
  <div class="wrap" style="padding:5rem 0 3.5rem">
    <p class="eyebrow">Tui Na Massage · Reading &amp; Wimbledon</p>
    <h1>Tui Na Therapeutic<br>Massage in Wimbledon<br>&amp; Reading</h1>
    <p class="lede">
      Structured manual therapy grounded in clinical assessment — not a relaxation
      massage. British Acupuncture Council registered practitioners.
    </p>

    <div class="hero-exp-stat">
      <span class="hero-exp-num">15+</span>
      <span class="hero-exp-label">Years'<br>Clinical Experience</span>
    </div>

    <div class="actions" style="margin-top:0">
      <a class="btn btn-gold" href="https://wa.me/447301949686" target="_blank" rel="noreferrer">Book a Consultation</a>
      <a class="btn btn-ghost" href="/clinical-services">All Clinical Services</a>
    </div>

    <div class="hero-trust-row">
      <span><span class="htc">✓</span> British Acupuncture Council Member</span>
      <span><span class="htc">✓</span> PSA Accredited Register</span>
      <span><span class="htc">✓</span> Insurance Recognised</span>
      <span><span class="htc">✓</span> No Referral Needed</span>
    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════
     §2 WHAT IS TUI NA
═══════════════════════════════════════════════ -->
<section class="section-soft">
  <div class="wrap">
    <div class="grid-2-al" style="gap:4rem">

      <div>
        <p class="eyebrow">About the Treatment</p>
        <h2>What Is Tui Na?</h2>
        <p>
          Tui Na is a hands-on Chinese medicine manual therapy with over 2,000 years of
          documented clinical use. The name means to push (推) and to grasp (拿). It applies
          precisely controlled pressure, rotation, and traction across anatomical points and
          meridian pathways to support functional movement and address soft tissue restriction.
        </p>
        <p>
          Tui Na at Yin Yang CMC is structured therapeutic work grounded in both classical
          meridian theory and modern musculoskeletal anatomy. In clinical application it is
          closer to physiotherapy than to relaxation massage, and is frequently combined with
          acupuncture in our pain management protocols.
        </p>

        <ul style="list-style:none;padding:0;margin:1.5rem 0 0;display:grid;gap:0.5rem">
          {[
            "First session: 60 minutes including full clinical assessment",
            "Follow-up sessions: 45 minutes",
            "Technique follows diagnosis, not habit or routine",
            "Same-week appointments at Reading and Wimbledon",
          ].map((item) => (
            <li style="display:flex;gap:0.6rem;align-items:flex-start;font-size:0.92rem">
              <span style="color:var(--gold);font-weight:700;flex-shrink:0;margin-top:0.05em">✓</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>

        <div class="actions" style="margin-top:1.8rem">
          <a class="btn btn-gold" href="https://wa.me/447301949686" target="_blank" rel="noreferrer">Book a Consultation</a>
          <a class="btn btn-outline" href="/pricing-and-insurance">Pricing &amp; Insurance</a>
        </div>
      </div>

      <div class="img-wrap" style="position:relative">
        <img
          src="/images/reading-clinic-treatment-room.webp"
          alt="Treatment room at Yin Yang CMC in Reading"
          style="width:100%;height:460px;object-fit:cover;border-radius:var(--r-lg)"
          loading="lazy"
        />
        <div class="cred-panel">
          <div class="cred-row"><span class="cred-check">✓</span> MBAcC · Nos. 963087 &amp; 963093</div>
          <div class="cred-row"><span class="cred-check">✓</span> ATCM Professional Member</div>
          <div class="cred-row"><span class="cred-check">✓</span> Diagnosis before treatment</div>
          <div class="cred-row"><span class="cred-check">✓</span> AXA · Vitality · Aviva · WPA</div>
        </div>
      </div>

    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════
     §3 CONDITIONS / PRESENTATIONS
═══════════════════════════════════════════════ -->
<section class="section">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">Applications</p>
      <h2>What Tui Na May Be Used For</h2>
      <p>
        Your practitioner will assess your individual presentation at consultation.
        Tui Na is frequently used alongside acupuncture or bone setting depending on
        the nature of your condition.
      </p>
    </div>

    <div class="grid-3" style="margin-bottom:2.5rem">
      <div style="padding:1.6rem;background:var(--cream);border-radius:var(--r-lg);border:1px solid rgba(192,152,90,0.2)">
        <p style="font-size:1.4rem;margin-bottom:0.5rem">🦴</p>
        <h3 style="font-size:1.05rem">Spinal &amp; Postural</h3>
        <p style="font-size:0.9rem;color:var(--muted)">
          Cervical spondylosis, lower back pain, sacroiliac joint dysfunction, and
          postural strain. Often staged alongside bone setting — soft tissue release first,
          joint mobilisation second.
        </p>
        <a class="more-link" href="/conditions/back-pain">Back Pain &amp; Sciatica</a>
      </div>
      <div style="padding:1.6rem;background:var(--cream);border-radius:var(--r-lg);border:1px solid rgba(192,152,90,0.2)">
        <p style="font-size:1.4rem;margin-bottom:0.5rem">🏃</p>
        <h3 style="font-size:1.05rem">Sports Injury &amp; Recovery</h3>
        <p style="font-size:0.9rem;color:var(--muted)">
          Post-acute tissue rehabilitation, tendinopathy, and repetitive strain. Gentle
          lymphatic techniques in the early phase; deep cross-fibre work in the
          remodelling phase.
        </p>
        <a class="more-link" href="/conditions/sports-injuries">Sports Injuries</a>
      </div>
      <div style="padding:1.6rem;background:var(--cream);border-radius:var(--r-lg);border:1px solid rgba(192,152,90,0.2)">
        <p style="font-size:1.4rem;margin-bottom:0.5rem">🧘</p>
        <h3 style="font-size:1.05rem">Stress &amp; Tension</h3>
        <p style="font-size:0.9rem;color:var(--muted)">
          Chronic stress physically contracts the posterior neck, upper back, and diaphragm.
          Tui Na techniques along the spine may support a measurable parasympathetic
          response, reducing tension and improving sleep onset.
        </p>
        <a class="more-link" href="/contact">Enquire</a>
      </div>
    </div>

    <p style="font-size:0.78rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--muted);margin-bottom:0.75rem">Commonly treated presentations:</p>
    <div class="cond-grid">
      {[
        { label: "Neck Pain",           href: "/conditions/neck-pain" },
        { label: "Shoulder Pain",       href: "/conditions/shoulder-pain" },
        { label: "Frozen Shoulder",     href: "/conditions/frozen-shoulder" },
        { label: "Back Pain",           href: "/conditions/back-pain" },
        { label: "Sciatica",            href: "/conditions/sciatica-treatment" },
        { label: "Sports Injuries",     href: "/conditions/sports-injuries" },
        { label: "Knee Pain",           href: "/conditions/knee-pain" },
        { label: "Trapezius Tension",   href: "/conditions" },
        { label: "Postural Strain",     href: "/conditions" },
        { label: "Repetitive Strain",   href: "/conditions" },
