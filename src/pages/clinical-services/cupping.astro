---
import Base from "../../layouts/Base.astro";
import FAQAccordion from "../../components/FAQAccordion.astro";
import CTASection from "../../components/CTASection.astro";

const faqItems = [
  {
    q: "Is cupping painful?",
    a: "Most patients describe a strong pulling or stretching sensation rather than pain. The suction can feel intense initially, but this typically eases within the first minute. Your practitioner adjusts cup pressure to your comfort and clinical need throughout the session.",
  },
  {
    q: "Will cupping leave marks?",
    a: "Yes. Cupping commonly leaves circular marks ranging from pink to dark red on the skin where the cups were applied. These are not bruises from impact — they reflect localised stasis and increased blood flow. Marks typically fade within 3–7 days. The darker the mark, the more stasis is present in that area.",
  },
  {
    q: "How many sessions will I need?",
    a: "For acute presentations, cupping is often used as part of a broader treatment session — 1–3 times is common. For chronic conditions or regular health maintenance, your practitioner will advise a course frequency at your initial consultation.",
  },
  {
    q: "Can cupping be combined with acupuncture?",
    a: "Yes, and it frequently is at Yin Yang CMC. Acupuncture targets the neurological component of pain and regulation; cupping addresses local blood stasis and soft tissue tension. Combined in one session, the effects are complementary rather than redundant.",
  },
  {
    q: "Is cupping suitable for everyone?",
    a: "Cupping is contraindicated over broken skin, active inflammation, varicose veins, and in patients with certain blood disorders. It is not applied to the lower back during pregnancy. Your practitioner will screen for contraindications before applying cups.",
  },
];
---
<Base
  title="Cupping Therapy Wimbledon & Reading | TCM Cupping Clinic | Yin Yang CMC"
  description="Professional cupping therapy in Wimbledon & Reading. Registered TCM practitioners using fire and vacuum cupping for pain relief, muscle tension, and circulation."
>


<!-- ═══════════════════════════════════════════════
     §1 HERO
═══════════════════════════════════════════════ -->
<section class="page-hero" style="min-height:68vh;display:grid;place-items:center">
  <img
    class="page-hero-bg"
    src="/images/generated/cupping-therapy-hero.webp"
    alt=""
    width="1536"
    height="1024"
    loading="eager"
    fetchpriority="high"
  />
  <div class="wrap" style="padding:5rem 0 3.5rem">
    <p class="eyebrow">Cupping Therapy · Reading &amp; Wimbledon</p>
    <h1>Cupping Therapy<br>in Wimbledon &amp; Reading</h1>
    <p class="lede">
      Traditional suction therapy to release muscle tension, improve circulation,
      and clear blood stasis — delivered by registered TCM practitioners.
    </p>

    <div class="hero-exp-stat">
      <span class="hero-exp-num">15+</span>
      <span class="hero-exp-label">Years'<br>Clinical Experience</span>
    </div>

    <div class="actions" style="margin-top:0">
      <a class="btn btn-gold" href="https://wa.me/447301949686" target="_blank" rel="noreferrer">Book a Consultation</a>
      <a class="btn btn-ghost" href="/clinical-services">All Clinical Services</a>
    </div>

    <div class="hero-trust-row">
      <span><span class="htc">✓</span> BAcC &amp; ATCM Registered</span>
      <span><span class="htc">✓</span> Combined with Acupuncture</span>
      <span><span class="htc">✓</span> No Referral Needed</span>
      <span><span class="htc">✓</span> Insurance Recognised</span>
    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════
     §2 WHAT IS CUPPING
═══════════════════════════════════════════════ -->
<section class="section-soft">
  <div class="wrap">
    <div class="grid-2-al" style="gap:4rem">

      <div>
        <p class="eyebrow">About the Treatment</p>
        <h2>What Is Cupping? <span style="font-size:1.2rem;color:var(--gold)">拔罐</span></h2>
        <p>
          Cupping involves placing cups — glass, silicone, or bamboo — on the surface of the
          skin and creating suction. The negative pressure draws the skin and superficial
          muscle layer upward into the cup, stimulating blood flow, loosening connective
          tissue, and encouraging the movement of stagnant Qi and blood.
        </p>
        <p>
          At Yin Yang CMC, cupping is primarily used as part of a combined treatment session.
          It is not administered as a standalone spa treatment — cup placement, retention
          time, and technique are determined by your practitioner's clinical assessment
          of your presenting condition.
        </p>

        <ul style="list-style:none;padding:0;margin:1.5rem 0 0;display:grid;gap:0.5rem">
          {[
            "Improves local blood circulation and tissue perfusion",
            "Releases muscle tension and connective tissue adhesion",
            "Clears blood stasis associated with chronic pain",
            "Often combined with acupuncture in the same session",
          ].map((item) => (
            <li style="display:flex;gap:0.6rem;align-items:flex-start;font-size:0.92rem">
              <span style="color:var(--gold);font-weight:700;flex-shrink:0;margin-top:0.05em">✓</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>

        <div class="actions" style="margin-top:1.8rem">
          <a class="btn btn-gold" href="https://wa.me/447301949686" target="_blank" rel="noreferrer">Book a Consultation</a>
          <a class="btn btn-outline" href="/clinical-services/acupuncture">About Acupuncture</a>
        </div>
      </div>

      <div style="background:var(--cream);border-radius:var(--r-lg);padding:2rem;border:1px solid rgba(192,152,90,0.2)">
        <p class="eyebrow">Treatment Types</p>
        <h3 style="font-size:1.1rem;margin-bottom:1.2rem">Cupping Methods Used</h3>
        <div style="display:grid;gap:1rem">
          {[
            { name: "Stationary Cupping", desc: "Cups placed on acupoints or affected areas and retained for 5–15 minutes. Most commonly used for back pain and respiratory conditions." },
            { name: "Sliding Cupping", desc: "Cups glide across lubricated skin along meridian pathways. Similar effect to Gua Sha — used for broad muscle tension and stiffness." },
            { name: "Flash Cupping", desc: "Rapid repeated application and removal of cups to stimulate Qi and blood movement in an area. Used for more superficial or sensitive presentations." },
          ].map(({ name, desc }) => (
            <div style="padding-bottom:1rem;border-bottom:1px solid rgba(192,152,90,0.15)">
              <h4 style="font-size:0.95rem;color:var(--navy);margin-bottom:0.3rem">{name}</h4>
              <p style="font-size:0.87rem;color:var(--muted);line-height:1.55;margin:0">{desc}</p>
            </div>
          ))}
        </div>
      </div>

    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════
     §3 CONDITIONS
═══════════════════════════════════════════════ -->
<section class="section">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">Conditions</p>
      <h2>What Cupping May Be Used For</h2>
      <p>
        Cupping is used as part of care for a range of musculoskeletal and systemic
        conditions. Your practitioner will assess whether it is appropriate for your
        individual presentation.
      </p>
    </div>

    <div class="grid-3" style="margin-bottom:2.5rem">
      <div style="padding:1.6rem;background:var(--cream);border-radius:var(--r-lg);border:1px solid rgba(192,152,90,0.2)">
        <p style="font-size:1.4rem;margin-bottom:0.5rem">🦴</p>
        <h3 style="font-size:1.05rem">Musculoskeletal Pain</h3>
        <p style="font-size:0.9rem;color:var(--muted)">
          Back pain, neck tension, shoulder stiffness, and sports injuries. Cupping
          is used to ease localised stasis and deep muscle tightness.
        </p>
        <a class="more-link" href="/conditions/back-pain">Back Pain &amp; Sciatica</a>
      </div>
      <div style="padding:1.6rem;background:var(--cream);border-radius:var(--r-lg);border:1px solid rgba(192,152,90,0.2)">
        <p style="font-size:1.4rem;margin-bottom:0.5rem">🫁</p>
        <h3 style="font-size:1.05rem">Respiratory Conditions</h3>
        <p style="font-size:0.9rem;color:var(--muted)">
          Chronic cough, bronchitis, and complementary support for people already
          managing asthma with their GP. Cupping on the upper back
          targets lung-associated acupoints in TCM practice.
        </p>
        <a class="more-link" href="/contact">Enquire</a>
      </div>
      <div style="padding:1.6rem;background:var(--cream);border-radius:var(--r-lg);border:1px solid rgba(192,152,90,0.2)">
        <p style="font-size:1.4rem;margin-bottom:0.5rem">🧘</p>
        <h3 style="font-size:1.05rem">Fatigue &amp; Recovery</h3>
        <p style="font-size:0.9rem;color:var(--muted)">
          Post-exercise recovery, persistent tiredness, and seasonal care. Cupping
          is used to support local circulation as part of a wider treatment plan.
        </p>
        <a class="more-link" href="/contact">Enquire</a>
      </div>
    </div>

    <div class="cond-grid">
      {[
        { label: "Back Pain",       href: "/conditions/back-pain" },
        { label: "Sciatica",        href: "/conditions/sciatica-treatment" },
        { label: "Shoulder Pain",   href: "/conditions/shoulder-pain" },
        { label: "Frozen Shoulder", href: "/conditions/frozen-shoulder" },
        { label: "Sports Injuries", href: "/conditions/sports-injuries" },
        { label: "Neck Pain",       href: "/conditions/neck-pain" },
        { label: "Chronic Fatigue", href: "/conditions" },
        { label: "Respiratory",     href: "/conditions" },
      ].map(({ label, href }) => (
        <a class="cond-chip" href={href}>{label}</a>
      ))}
    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════
     §4 HOW IT WORKS — dark
═══════════════════════════════════════════════ -->
<section class="section-dark">
  <div class="wrap">
    <div class="section-head" style="max-width:52ch">
      <p class="eyebrow eyebrow-dark">Your Session</p>
      <h2>How a Cupping Session Works</h2>
    </div>

    <div class="journey-grid">
      <div class="journey-step">
        <div class="j-num">01</div>
        <h3>Assessment</h3>
        <p>
          Your practitioner reviews your current symptoms and physical presentation.
          Cupping areas are selected based on your clinical pattern — not by routine
          placement or personal preference.
        </p>
      </div>
      <div class="journey-step">
        <div class="j-num">02</div>
        <h3>Application</h3>
        <p>
          Cups are placed on the target areas. Suction is created and cups are retained
          for the clinically appropriate period — typically 5–15 minutes. You will feel
          a strong drawing sensation.
        </p>
      </div>
      <div class="journey-step">
        <div class="j-num">03</div>
        <h3>Aftercare</h3>
        <p>
          Your practitioner advises on post-treatment care, including hydration, avoiding
          cold and wind on treated areas for 24 hours, and what to expect from any marks
          left on the skin.
        </p>
      </div>
    </div>

    <p style="margin-top:2.5rem;text-align:center">
      <a class="btn btn-gold" href="https://wa.me/447301949686" target="_blank" rel="noreferrer">Book Your Consultation</a>
    </p>
  </div>
</section>


<!-- ═══════════════════════════════════════════════
     §5 RELATED TREATMENTS
═══════════════════════════════════════════════ -->
<section class="section-soft">
  <div class="wrap">
    <div class="section-head" style="max-width:52ch">
      <p class="eyebrow">Related Treatments</p>
      <h2>Other TCM Therapies We Offer</h2>
    </div>
    <div class="grid-3">
      {[
        { label: "Gua Sha", href: "/clinical-services/gua-sha", desc: "Instrument-assisted scraping to promote circulation and reduce inflammation." },
        { label: "Moxibustion", href: "/clinical-services/moxibustion", desc: "Warming therapy using dried mugwort to dispel cold and support meridian flow." },
        { label: "Auricular Therapy", href: "/clinical-services/auricular-therapy", desc: "Ear seed acupressure for insomnia, pain, and systemic regulation." },
        { label: "Tian Jiu", href: "/clinical-services/tian-jiu", desc: "Seasonal herbal plaster therapy for respiratory and immune conditions." },
        { label: "Acupuncture", href: "/clinical-services/acupuncture", desc: "Precision needling for pain, stress, and systemic regulation." },
        { label: "Tui Na Massage", href: "/clinical-services/tui-na-massage", desc: "Clinical manual therapy for musculoskeletal and soft tissue conditions." },
      ].map(({ label, href, desc }) => (
        <a href={href} style="display:block;text-decoration:none;padding:1.4rem;background:var(--white);border-radius:var(--r-md);border:1px solid rgba(192,152,90,0.2)">
          <h3 style="font-size:1rem;color:var(--navy);margin-bottom:0.4rem">{label}</h3>
          <p style="font-size:0.87rem;color:var(--muted);margin:0;line-height:1.5">{desc}</p>
          <span style="font-size:0.85rem;font-weight:700;color:var(--teal);margin-top:0.6rem;display:block">Learn more →</span>
        </a>
      ))}
    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════
     §6 FAQ
═══════════════════════════════════════════════ -->
<section class="section">
  <div class="wrap">
    <div class="grid-2-lg" style="gap:5rem">
      <div>
        <p class="eyebrow">Common Questions</p>
        <h2>Questions About Cupping</h2>
        <p style="color:var(--muted)">
          What patients commonly ask before their first cupping session.
        </p>
        <div class="actions" style="margin-top:1.5rem">
          <a class="btn btn-gold" href="https://wa.me/447301949686" target="_blank" rel="noreferrer">Ask Us Directly</a>
        </div>
      </div>
      <FAQAccordion items={faqItems} />
    </div>
  </div>
</section>


<CTASection
  heading="Book Your Cupping Therapy Session"
  sub="Same-week appointments at Reading and Wimbledon. Cupping is often administered as part of an acupuncture session — your practitioner will advise."
/>

</Base>
