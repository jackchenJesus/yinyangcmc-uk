          <p style="font-size:0.84rem;color:var(--muted);margin-bottom:0.75rem">Related services:</p>
          <div style="display:grid;gap:0.3rem">
            <a href="/acupuncture" style="font-size:0.9rem;color:var(--teal);font-weight:600;text-decoration:none">→ Acupuncture</a>
            <a href="/tui-na-massage" style="font-size:0.9rem;color:var(--teal);font-weight:600;text-decoration:none">→ Tui Na Therapeutic Massage</a>
            <a href="/clinical-services" style="font-size:0.9rem;color:var(--teal);font-weight:600;text-decoration:none">→ All Clinical Services</a>
