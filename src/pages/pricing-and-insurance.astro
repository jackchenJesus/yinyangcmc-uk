---
import Base from "../layouts/Base.astro";
import FAQAccordion from "../components/FAQAccordion.astro";
import { site } from "../data/site";

const faqItems = [
  {
    q: "Is the £10 consultation fee separate from treatment?",
    a: "Yes. The consultation covers your TCM assessment and diagnosis. If treatment follows in the same session, the relevant treatment fee applies in addition.",
  },
  {
    q: "Does a GP referral affect my insurance claim?",
    a: "Some private insurers require a GP referral before authorising complementary therapy claims. Check your policy terms — we can provide any clinical documentation your insurer requires.",
  },
  {
    q: "Are herbal granules included?",
    a: "Herbal granules are charged per day of prescription, separate from consultation and treatment fees.",
  },
  {
    q: "What does the 20% first-treatment discount apply to?",
    a: "The first-treatment discount is applied at booking to your first treatment.",
  },
  {
    q: "Do I need to tell you I am using insurance?",
    a: "Yes — tell us at booking so we prepare the correct documentation.",
  },
  {
    q: "What if my insurer is not listed?",
    a: "Often yes, you can still claim. We provide receipts that meet standard cash-plan and insurer submission requirements. Check with your insurer first.",
  },
  {
    q: "Does recognition mean every treatment is covered?",
    a: "No. Provider recognition relates to the relevant practitioner and eligible acupuncture treatment. Tui Na, bone setting and herbal consultation are not automatically covered. Check your individual policy with your insurer before treatment.",
  },
];

const insurers = [
  { src: "/images/axa-health-logo.png", alt: "AXA Health" },
  { src: "/images/vitality-health-logo.webp", alt: "Vitality" },
  { src: "/images/aviva-health-logo.png", alt: "Aviva" },
  { src: "/images/wpa-logo.png", alt: "WPA" },
];
---
<Base title="Acupuncture cost Wimbledon & Reading | Price & Insurance | yin yang uk" description="Curious about acupuncture cost Wimbledon or acupuncture cost Reading? View our price list for expert acupuncture, bone-setting, Tui Na, and insurance details.">

<!-- ═══════════════════════════════════════════════
     §1 HERO
═══════════════════════════════════════════════ -->
<section class="pi-hero">
  <div class="wrap pi-hero-grid">
    <div>
      <p class="eyebrow">Pricing &amp; Insurance · Reading &amp; Wimbledon</p>
      <h1>Transparent fees.<br />No surprises.</h1>
      <p class="lede">
        General TCM consultation from £10. Acupuncture £60. Integrated Treatment £120.
        Recognised by AXA Health, Vitality, Aviva and WPA. Cover depends on your policy.
      </p>
      <div class="actions">
        <a class="btn btn-gold" href={site.whatsapp} target="_blank" rel="noreferrer">Book a Consultation</a>
        <a class="btn btn-ghost" href="#insurance">How insurance works</a>
      </div>
    </div>

    <div class="pi-hero-visual">
      <img
        src="/images/reading-clinic-treatment-room.webp"
        alt="Treatment room at Yin Yang CMC in Reading"
        width="560"
        height="400"
        loading="eager"
        fetchpriority="high"
      />
      <div class="pi-hero-panel">
        <p class="pi-hero-panel-label">Recognised UK provider</p>
        <p class="pi-hero-panel-names">AXA Health · Vitality · Aviva · WPA</p>
      </div>
    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════
     §2 TREATMENT FEES
═══════════════════════════════════════════════ -->
<section class="section" id="fees">
  <div class="wrap">
    <div class="section-head pi-fees-head">
      <p class="eyebrow">Fees</p>
      <h2>Our treatment fees</h2>
      <p>Clear session prices for acupuncture and integrated Chinese medicine at our Reading and Wimbledon clinics. No hidden charges at checkout.</p>
    </div>

    <p class="pi-offer-banner">
      <span class="pi-offer-kicker">New patients</span>
      <span class="pi-offer-copy">20% off your first treatment</span>
      <span class="pi-offer-note">Applied at booking</span>
    </p>

    <div class="pi-price-grid">
      <article class="pi-price-card">
        <span class="pi-price-icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2" />
            <rect x="9" y="3" width="6" height="4" rx="1" />
            <path d="M9 12h6M9 16h4" />
          </svg>
        </span>
        <h3>General TCM Consultation</h3>
        <p class="pi-price-val">£10</p>
        <p class="pi-price-desc">Initial assessment &amp; diagnosis</p>
      </article>

      <article class="pi-price-card">
        <span class="pi-price-icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="3.2" />
            <path d="M12 4v3.2M12 16.8V20M4 12h3.2M16.8 12H20" />
            <path d="m7.1 7.1 2.2 2.2M14.7 14.7l2.2 2.2M16.9 7.1l-2.2 2.2M9.3 14.7l-2.2 2.2" />
          </svg>
        </span>
        <h3>Acupuncture</h3>
        <p class="pi-price-val">£60</p>
        <p class="pi-price-desc">Per treatment session</p>
      </article>

      <article class="pi-price-card is-featured">
        <span class="pi-price-icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3v18M8 7h8M6 12h12M8 17h8" />
          </svg>
        </span>
        <h3>Integrated Treatment</h3>
        <p class="pi-price-val">£120</p>
        <p class="pi-price-desc">All techniques as clinically indicated</p>
      </article>
    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════
     §3 INSURANCE TRUST
═══════════════════════════════════════════════ -->
<section class="section-soft" id="insurance">
  <div class="wrap">
    <div class="section-head pi-insure-head">
      <p class="eyebrow">Private health insurance</p>
      <h2>Recognised by leading UK health insurers</h2>
      <p>
        Private health insurance cover depends on your individual policy and insurer requirements. Please check your cover directly with your insurer before treatment.
      </p>
    </div>

    <ul class="pi-insurers">
      {insurers.map((insurer) => (
        <li>
          <img src={insurer.src} alt={insurer.alt} height="32" loading="lazy" />
        </li>
      ))}
    </ul>

    <div class="pi-codes-head">
      <h3>Provider numbers</h3>
      <p>Quote these when you contact your insurer. Recognition relates to the relevant practitioner and eligible acupuncture treatment — not automatically to Tui Na, bone setting or herbal consultation.</p>
    </div>

    <ul class="pi-codes">
      <li>
        <p class="pi-code-name">AXA Health</p>
        <p class="pi-code-label">Provider</p>
        <p class="pi-code-val">CL03375</p>
      </li>
      <li>
        <p class="pi-code-name">Vitality Health</p>
        <p class="pi-code-label">Provider</p>
        <p class="pi-code-val">SP123173</p>
      </li>
      <li>
        <p class="pi-code-name">Aviva</p>
        <p class="pi-code-label">Provider</p>
        <p class="pi-code-val">600185413</p>
      </li>
      <li>
        <p class="pi-code-name">WPA</p>
        <p class="pi-code-label">Provider</p>
        <p class="pi-code-val">921550015</p>
      </li>
    </ul>
  </div>
</section>


<!-- ═══════════════════════════════════════════════
     §4 PROVIDER NUMBERS
═══════════════════════════════════════════════ -->
<section class="section" id="provider-numbers">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">Practitioners</p>
      <h2>Qualified UK practitioners</h2>
      <p>
        Both practitioners are British Acupuncture Council and ATCM registered.
        Use the insurer provider numbers above when making a claim.
      </p>
    </div>

    <div class="pi-prov-grid">
      <article class="pi-prov-card">
        <img
          src="/images/shing-hui-practitioner.webp"
          alt="Portrait of Shing Hui (Winton)"
          width="96"
          height="96"
          loading="lazy"
        />
        <div>
          <h3>Winton Hui (Shing Hui)</h3>
          <p class="pi-prov-role">British Acupuncture Council &amp; ATCM registered</p>
          <dl class="pi-reg-list">
            <div><dt>ATCM</dt><dd>FM0250005</dd></div>
            <div><dt>MBAcC</dt><dd>963087</dd></div>
          </dl>
        </div>
      </article>

      <article class="pi-prov-card">
        <img
          src="/images/chui-ying-li-practitioner.webp"
          alt="Portrait of Chui Ying Li (Andrea)"
          width="96"
          height="96"
          loading="lazy"
        />
        <div>
          <h3>Andrea Li (Chui Ying Li)</h3>
          <p class="pi-prov-role">British Acupuncture Council &amp; ATCM registered</p>
          <dl class="pi-reg-list">
            <div><dt>ATCM</dt><dd>FM0250004</dd></div>
            <div><dt>MBAcC</dt><dd>963093</dd></div>
          </dl>
        </div>
      </article>
    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════
     §5 HOW TO CLAIM
═══════════════════════════════════════════════ -->
<section class="section-soft" id="how-to-claim">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">Claims</p>
      <h2>How to claim on your insurance</h2>
      <p>Three straightforward steps — most patients set this up before their first visit.</p>
    </div>

    <ol class="pi-steps">
      <li>
        <span class="pi-step-num" aria-hidden="true">01</span>
        <h3>Check your cover</h3>
        <p>Confirm that acupuncture or complementary therapy is included in your policy and whether pre-authorisation or a GP referral is required.</p>
      </li>
      <li>
        <span class="pi-step-num" aria-hidden="true">02</span>
        <h3>Book your treatment</h3>
        <p>Tell Yin Yang CMC that you intend to claim through insurance when booking, so we can prepare the correct documentation.</p>
      </li>
      <li>
        <span class="pi-step-num" aria-hidden="true">03</span>
        <h3>Submit your claim</h3>
        <p>Use the insurer provider number listed above and the itemised receipt supplied after treatment.</p>
      </li>
    </ol>

    <p class="pi-cash-note">
      Health cash plans such as Simplyhealth and Healthshield may also cover treatment depending on your policy.
    </p>

    <div class="pi-help">
      <div>
        <h3>Not sure if you're covered?</h3>
        <p>
          Send us your insurer name before booking and we'll help you identify what information you may need to check with them.
        </p>
      </div>
      <a class="btn btn-gold" href={site.whatsapp} target="_blank" rel="noreferrer">Ask us on WhatsApp</a>
    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════
     §6 FAQ
═══════════════════════════════════════════════ -->
<section class="section" id="faq">
  <div class="wrap pi-faq">
    <div>
      <p class="eyebrow">Common questions</p>
      <h2>Pricing &amp; insurance FAQ</h2>
      <p class="muted">
        If you are unsure whether your policy covers eligible acupuncture treatment, message us before booking — we can help you check what to ask your insurer. Cover is not automatic for every clinic service.
      </p>
    </div>
    <FAQAccordion items={faqItems} />
  </div>
</section>


<!-- ═══════════════════════════════════════════════
     §7 FINAL CTA
═══════════════════════════════════════════════ -->
<section class="cta-section pi-cta">
  <div class="wrap container-narrow">
    <p class="eyebrow" style="color:var(--gold)">Book your appointment</p>
    <h2>Ready to book your first session?</h2>
    <p class="pi-cta-offer">20% off your first treatment</p>
    <p>Available at <strong>Reading Clinic</strong> · <strong>Wimbledon Clinic</strong></p>
    <div class="actions actions-c">
      <a class="btn btn-gold" href={site.whatsapp} target="_blank" rel="noreferrer">Book on WhatsApp</a>
      <a class="btn btn-ghost" href={`tel:${site.phoneIntl}`}>Call {site.phoneDisplay}</a>
    </div>
  </div>
</section>

<style>
  #fees,
  #insurance,
  #provider-numbers,
  #how-to-claim,
  #faq {
    scroll-margin-top: 96px;
  }

  /* Hero — compact two-column, not a tall banner */
  .pi-hero {
    background: var(--navy);
    color: var(--white);
    padding: 3.25rem 0 3rem;
  }
  .pi-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: 3.5rem;
    align-items: center;
  }
  .pi-hero h1 {
    color: var(--white);
    font-size: clamp(1.85rem, 4vw, 2.9rem);
    margin-bottom: 0.75rem;
  }
  .pi-hero .lede {
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.88);
    max-width: 42ch;
    line-height: 1.65;
    margin-bottom: 1.35rem;
  }
  .pi-hero-visual {
    position: relative;
    min-width: 0;
  }
  .pi-hero-visual img {
    width: 100%;
    height: 340px;
    object-fit: cover;
    object-position: center;
    border-radius: var(--r-lg);
    display: block;
  }
  .pi-hero-panel {
    position: absolute;
    left: 1rem;
    right: 1rem;
    bottom: 1rem;
    background: var(--white);
    color: var(--navy);
    border-radius: var(--r-md);
    padding: 0.85rem 1.1rem;
    box-shadow: var(--sh-sm);
  }
  .pi-hero-panel-label {
    margin: 0 0 0.15rem;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .pi-hero-panel-names {
    margin: 0;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--navy);
    line-height: 1.4;
  }

  .pi-fees-head,
  .pi-insure-head { max-width: 58ch; }

  /* First-treatment offer — understated clinic banner */
  .pi-offer-banner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.45rem 1rem;
    margin: 0 0 1.75rem;
    padding: 0.95rem 1.25rem;
    background: var(--cream);
    border: 1px solid rgba(192, 152, 90, 0.28);
    border-radius: var(--r-md);
  }
  .pi-offer-kicker {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .pi-offer-copy {
    font-family: var(--serif);
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--navy);
    line-height: 1.2;
  }
  .pi-offer-note {
    margin-left: auto;
    font-size: 0.82rem;
    color: var(--muted);
  }

  /* Pricing cards — clinic fees, not SaaS tables */
  .pi-price-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.15rem;
  }
  .pi-price-card {
    position: relative;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    box-shadow: var(--sh-xs);
    padding: 2rem 1.6rem 1.85rem;
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
  }
  .pi-price-card.is-featured {
    border-color: rgba(192, 152, 90, 0.42);
    box-shadow: var(--sh-sm);
    background: #fffdf8;
  }
  .pi-price-card.is-featured::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--gold);
    border-radius: var(--r-lg) var(--r-lg) 0 0;
  }
  .pi-price-icon {
    width: 42px;
    height: 42px;
    border-radius: var(--r-md);
    background: var(--cream);
    color: var(--gold);
    display: grid;
    place-items: center;
    margin-bottom: 1.15rem;
  }
  .pi-price-card h3 {
    font-family: var(--sans);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 0.7rem;
  }
  .pi-price-val {
    font-family: var(--serif);
    font-size: clamp(2.4rem, 4vw, 3.1rem);
    font-weight: 600;
    color: var(--navy);
    line-height: 1;
    margin: 0 0 0.7rem;
  }
  .pi-price-desc {
    margin: 0;
    font-size: 0.95rem;
    color: var(--muted);
    line-height: 1.5;
  }

  /* Insurer logo row */
  .pi-insurers {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.9rem;
  }
  .pi-insurers li {
    margin: 0;
    min-height: 88px;
    display: grid;
    place-items: center;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    padding: 1.1rem 1rem;
  }
  .pi-insurers img {
    height: 32px;
    width: auto;
    max-width: 140px;
    object-fit: contain;
    filter: grayscale(0.15);
  }

  .pi-codes-head {
    margin: 2rem 0 1rem;
    max-width: 62ch;
  }
  .pi-codes-head h3 {
    font-size: 1.2rem;
    margin: 0 0 0.4rem;
  }
  .pi-codes-head p {
    margin: 0;
    font-size: 0.92rem;
    color: var(--muted);
    line-height: 1.6;
  }
  .pi-codes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.9rem;
  }
  .pi-codes li {
    margin: 0;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    padding: 1.15rem 1.1rem 1.2rem;
    min-width: 0;
  }
  .pi-code-name {
    margin: 0 0 0.55rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .pi-code-label {
    margin: 0 0 0.15rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .pi-code-val {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--navy);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
    user-select: all;
  }

  /* Practitioner provider cards */
  .pi-prov-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.2rem;
  }
  .pi-prov-card {
    display: grid;
    grid-template-columns: 88px 1fr;
    gap: 1.15rem;
    align-items: start;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    box-shadow: var(--sh-xs);
    padding: 1.4rem 1.5rem 1.45rem;
    min-width: 0;
  }
  .pi-prov-card img {
    width: 88px;
    height: 88px;
    object-fit: cover;
    object-position: center top;
    border-radius: var(--r-md);
  }
  .pi-prov-card h3 {
    font-size: 1.2rem;
    margin: 0 0 0.2rem;
  }
  .pi-prov-role {
    margin: 0 0 0.9rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .pi-reg-list {
    margin: 0;
    display: grid;
    gap: 0.35rem;
  }
  .pi-reg-list > div {
    display: grid;
    grid-template-columns: 8.2rem minmax(0, 1fr);
    gap: 0.6rem;
    align-items: baseline;
    padding: 0.4rem 0;
    border-top: 1px solid var(--border);
    font-size: 0.9rem;
  }
  .pi-reg-list dt {
    margin: 0;
    color: var(--muted);
    font-weight: 600;
  }
  .pi-reg-list dd {
    margin: 0;
    font-weight: 700;
    color: var(--navy);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
    user-select: all;
  }

  /* Claim process */
  .pi-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.1rem;
    counter-reset: none;
  }
  .pi-steps li {
    margin: 0;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    box-shadow: var(--sh-xs);
    padding: 1.6rem 1.45rem 1.55rem;
    min-width: 0;
  }
  .pi-step-num {
    display: block;
    font-family: var(--serif);
    font-size: 1.55rem;
    font-weight: 600;
    color: var(--gold);
    line-height: 1;
    margin-bottom: 0.85rem;
  }
  .pi-steps h3 {
    font-size: 1.12rem;
    margin: 0 0 0.45rem;
  }
  .pi-steps p {
    margin: 0;
    font-size: 0.92rem;
    color: var(--muted);
    line-height: 1.6;
  }
  .pi-cash-note {
    margin: 1.35rem 0 0;
    font-size: 0.88rem;
    color: var(--muted);
    max-width: 62ch;
  }

  /* Soft conversion block */
  .pi-help {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    margin-top: 2rem;
    padding: 1.5rem 1.6rem;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
  }
  .pi-help h3 {
    font-size: 1.35rem;
    margin: 0 0 0.35rem;
  }
  .pi-help p {
    margin: 0;
    max-width: 52ch;
    font-size: 0.95rem;
    color: var(--muted);
  }
  .pi-help .btn { flex-shrink: 0; }

  .pi-faq {
    display: grid;
    grid-template-columns: 1.05fr 1.2fr;
    gap: 4.5rem;
    align-items: start;
  }
  .pi-faq :global(.faq-item summary:focus-visible) {
    outline: 2px solid var(--gold);
    outline-offset: 3px;
    border-radius: 2px;
