---
import Base from "../layouts/Base.astro";
import FAQAccordion from "../components/FAQAccordion.astro";
import { site } from "../data/site";

const faqItems = [
  {
    q: "How do consultation fees work?",
    a: "Your first consultation is £20. Follow-up internal medicine consultations are £10 each. Follow-up consultations for acupuncture or integrated pain management carry no separate consultation fee — you pay the treatment fee only.",
  },
  {
    q: "Does a GP referral affect my insurance claim?",
    a: "Some private insurers require a GP referral before authorising complementary therapy claims. Check your policy terms — we can provide any clinical documentation your insurer requires.",
  },
  {
    q: "Are herbal granules included in the consultation fee?",
    a: "No. Herbal granules are £10 per day of prescription, billed separately from consultation fees. A 30-day granule package is £270 (consultation fees are not included in that price).",
  },
  {
    q: "What payment methods do you accept?",
    a: "We accept cash and bank transfer. Ask us for bank details when you book if you plan to pay by transfer.",
  },
  {
    q: "What is included in integrated pain management?",
    a: "Integrated pain management treatment (£120 per session) includes all clinically indicated modalities in that visit — such as acupuncture, bone setting and manipulation, acupressure, cupping and Tui Na massage — as determined by your practitioner.",
  },
  {
    q: "Do I need to tell you I am using insurance?",
    a: "Yes — tell us at booking so we prepare the correct documentation.",
  },
  {
    q: "What if my insurer is not listed?",
    a: "Often yes, you can still claim. We provide receipts that meet standard cash-plan and insurer submission requirements. Check with your insurer first.",
  },
  {
    q: "Does recognition mean every treatment is covered?",
    a: "No. Provider recognition relates to the relevant practitioner and eligible acupuncture treatment. Tui Na, bone setting and herbal consultation are not automatically covered. Check your individual policy with your insurer before treatment.",
  },
];

const insurers = [
  { src: "/images/axa-health-logo.png", alt: "AXA Health" },
  { src: "/images/vitality-health-logo.webp", alt: "Vitality" },
  { src: "/images/aviva-health-logo.png", alt: "Aviva" },
  { src: "/images/wpa-logo.png", alt: "WPA" },
];
---
<Base title="Acupuncture cost Wimbledon & Reading | Price & Insurance | yin yang uk" description="Curious about acupuncture cost Wimbledon or acupuncture cost Reading? View our price list for expert acupuncture, bone-setting, Tui Na, and insurance details.">

<!-- ═══════════════════════════════════════════════
     §1 HERO
═══════════════════════════════════════════════ -->
<section class="pi-hero">
  <div class="wrap pi-hero-grid">
    <div>
      <p class="eyebrow">Pricing &amp; Insurance · Reading &amp; Wimbledon</p>
      <h1>Transparent fees.<br />No surprises.</h1>
      <p class="lede">
        First consultation £20. Acupuncture £60 per session. Integrated pain management £120 per session.
        Session packages available. Recognised by AXA Health, Vitality, Aviva and WPA — cover depends on your policy.
      </p>
      <div class="actions">
        <a class="btn btn-gold" href={site.whatsapp} target="_blank" rel="noreferrer">Book a Consultation</a>
        <a class="btn btn-ghost" href="#insurance">How insurance works</a>
      </div>
    </div>

    <div class="pi-hero-visual">
      <img
        src="/images/reading-clinic-treatment-room.webp"
        alt="Treatment room at Yin Yang CMC in Reading"
        width="560"
        height="400"
        loading="eager"
        fetchpriority="high"
      />
      <div class="pi-hero-panel">
        <p class="pi-hero-panel-label">Recognised UK provider</p>
        <p class="pi-hero-panel-names">AXA Health · Vitality · Aviva · WPA</p>
      </div>
    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════
     §2 TREATMENT FEES
═══════════════════════════════════════════════ -->
<section class="section" id="fees">
  <div class="wrap">
    <div class="section-head pi-fees-head">
      <p class="eyebrow">Fees</p>
      <h2>Price list</h2>
      <p>Clear fees for consultations, treatments and packages at our Reading and Wimbledon clinics. Treatment is always tailored to your assessment.</p>
    </div>

    <div class="pi-fee-sections">
      <article class="pi-fee-block">
        <h3>Consultation fees</h3>
        <ul class="pi-fee-rows">
          <li>
            <span class="pi-fee-label">First consultation</span>
            <span class="pi-fee-amount">£20</span>
          </li>
          <li>
            <span class="pi-fee-label">Subsequent internal medicine consultations</span>
            <span class="pi-fee-amount">£10 <span class="pi-fee-unit">each</span></span>
          </li>
          <li>
            <span class="pi-fee-label">Subsequent acupuncture / integrated pain management consultations</span>
            <span class="pi-fee-amount pi-fee-free">Free</span>
            <span class="pi-fee-hint">No consultation fee — treatment fee only</span>
          </li>
        </ul>
      </article>

      <article class="pi-fee-block">
        <h3>Treatment fees</h3>
        <ul class="pi-fee-rows">
          <li>
            <span class="pi-fee-label">Herbal granules</span>
            <span class="pi-fee-amount">£10 <span class="pi-fee-unit">/ day</span></span>
          </li>
          <li>
            <span class="pi-fee-label">Acupuncture</span>
            <span class="pi-fee-amount">£60 <span class="pi-fee-unit">/ session</span></span>
          </li>
          <li class="pi-fee-row-featured">
            <div class="pi-fee-row-main">
              <span class="pi-fee-label">Integrated pain management treatment</span>
              <span class="pi-fee-amount">£120 <span class="pi-fee-unit">/ session</span></span>
              <p class="pi-fee-detail">
                Includes all clinically indicated modalities in that session — acupuncture, bone setting &amp; manipulation, acupressure, cupping and Tui Na massage.
              </p>
            </div>
          </li>
        </ul>
      </article>

      <article class="pi-fee-block">
        <h3>Package deals</h3>
        <ul class="pi-fee-rows">
          <li>
            <span class="pi-fee-label">Herbal granules — 30 days</span>
            <span class="pi-fee-amount">£270</span>
            <span class="pi-fee-hint">Consultation fee not included</span>
          </li>
          <li class="pi-fee-row-group">
            <span class="pi-fee-label">Acupuncture</span>
            <ul class="pi-fee-subrows">
              <li><span>5 sessions</span><span class="pi-fee-amount">£285</span></li>
              <li><span>10 sessions</span><span class="pi-fee-amount">£540</span></li>
            </ul>
          </li>
          <li class="pi-fee-row-group">
            <span class="pi-fee-label">Integrated pain management</span>
            <ul class="pi-fee-subrows">
              <li><span>5 sessions</span><span class="pi-fee-amount">£570</span></li>
              <li><span>10 sessions</span><span class="pi-fee-amount">£1,080</span></li>
            </ul>
          </li>
        </ul>
      </article>
    </div>

    <p class="pi-payment">
      <strong>Payment methods:</strong> Cash or bank transfer are both accepted.
    </p>
  </div>
</section>


<!-- ═══════════════════════════════════════════════
     §3 INSURANCE TRUST
═══════════════════════════════════════════════ -->
<section class="section-soft" id="insurance">
  <div class="wrap">
    <div class="section-head pi-insure-head">
      <p class="eyebrow">Private health insurance</p>
      <h2>Recognised by leading UK health insurers</h2>
      <p>
        Private health insurance cover depends on your individual policy and insurer requirements. Please check your cover directly with your insurer before treatment.
      </p>
    </div>

    <ul class="pi-insurers">
      {insurers.map((insurer) => (
        <li>
          <img src={insurer.src} alt={insurer.alt} height="32" loading="lazy" />
        </li>
      ))}
    </ul>

    <div class="pi-codes-head">
      <h3>Provider numbers</h3>
      <p>Quote these when you contact your insurer. Recognition relates to the relevant practitioner and eligible acupuncture treatment — not automatically to Tui Na, bone setting or herbal consultation.</p>
    </div>

    <ul class="pi-codes">
      <li>
        <p class="pi-code-name">AXA Health</p>
        <p class="pi-code-label">Provider</p>
        <p class="pi-code-val">CL03375</p>
      </li>
      <li>
        <p class="pi-code-name">Vitality Health</p>
        <p class="pi-code-label">Provider</p>
        <p class="pi-code-val">SP123173</p>
      </li>
      <li>
        <p class="pi-code-name">Aviva</p>
        <p class="pi-code-label">Provider</p>
        <p class="pi-code-val">600185413</p>
      </li>
      <li>
        <p class="pi-code-name">WPA</p>
        <p class="pi-code-label">Provider</p>
        <p class="pi-code-val">921550015</p>
      </li>
    </ul>
  </div>
</section>


<!-- ═══════════════════════════════════════════════
     §4 PROVIDER NUMBERS
═══════════════════════════════════════════════ -->
<section class="section" id="provider-numbers">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">Practitioners</p>
      <h2>Qualified UK practitioners</h2>
      <p>
        Both practitioners are British Acupuncture Council and ATCM registered.
        Use the insurer provider numbers above when making a claim.
      </p>
    </div>

    <div class="pi-prov-grid">
      <article class="pi-prov-card">
        <img
          src="/images/shing-hui-practitioner.webp"
          alt="Portrait of Shing Hui (Winton)"
          width="96"
          height="96"
          loading="lazy"
        />
        <div>
          <h3>Winton Hui (Shing Hui)</h3>
          <p class="pi-prov-role">British Acupuncture Council &amp; ATCM registered</p>
          <dl class="pi-reg-list">
            <div><dt>ATCM</dt><dd>FM0250005</dd></div>
            <div><dt>MBAcC</dt><dd>963087</dd></div>
          </dl>
        </div>
      </article>

      <article class="pi-prov-card">
        <img
          src="/images/chui-ying-li-practitioner.webp"
          alt="Portrait of Chui Ying Li (Andrea)"
          width="96"
          height="96"
          loading="lazy"
        />
        <div>
          <h3>Andrea Li (Chui Ying Li)</h3>
          <p class="pi-prov-role">British Acupuncture Council &amp; ATCM registered</p>
          <dl class="pi-reg-list">
            <div><dt>ATCM</dt><dd>FM0250004</dd></div>
            <div><dt>MBAcC</dt><dd>963093</dd></div>
          </dl>
        </div>
      </article>
    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════
     §5 HOW TO CLAIM
═══════════════════════════════════════════════ -->
<section class="section-soft" id="how-to-claim">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">Claims</p>
      <h2>How to claim on your insurance</h2>
      <p>Three straightforward steps — most patients set this up before their first visit.</p>
    </div>

    <ol class="pi-steps">
      <li>
        <span class="pi-step-num" aria-hidden="true">01</span>
        <h3>Check your cover</h3>
        <p>Confirm that acupuncture or complementary therapy is included in your policy and whether pre-authorisation or a GP referral is required.</p>
      </li>
      <li>
        <span class="pi-step-num" aria-hidden="true">02</span>
        <h3>Book your treatment</h3>
        <p>Tell Yin Yang CMC that you intend to claim through insurance when booking, so we can prepare the correct documentation.</p>
      </li>
      <li>
        <span class="pi-step-num" aria-hidden="true">03</span>
        <h3>Submit your claim</h3>
        <p>Use the insurer provider number listed above and the itemised receipt supplied after treatment.</p>
      </li>
    </ol>

    <p class="pi-cash-note">
      Health cash plans such as Simplyhealth and Healthshield may also cover treatment depending on your policy.
    </p>

    <div class="pi-help">
      <div>
        <h3>Not sure if you're covered?</h3>
        <p>
          Send us your insurer name before booking and we'll help you identify what information you may need to check with them.
        </p>
      </div>
      <a class="btn btn-gold" href={site.whatsapp} target="_blank" rel="noreferrer">Ask us on WhatsApp</a>
    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════
     §6 FAQ
═══════════════════════════════════════════════ -->
<section class="section" id="faq">
  <div class="wrap pi-faq">
    <div>
      <p class="eyebrow">Common questions</p>
      <h2>Pricing &amp; insurance FAQ</h2>
      <p class="muted">
        If you are unsure whether your policy covers eligible acupuncture treatment, message us before booking — we can help you check what to ask your insurer. Cover is not automatic for every clinic service.
      </p>
    </div>
    <FAQAccordion items={faqItems} />
  </div>
</section>


<!-- ═══════════════════════════════════════════════
     §7 FINAL CTA
═══════════════════════════════════════════════ -->
<section class="cta-section pi-cta">
  <div class="wrap container-narrow">
    <p class="eyebrow" style="color:var(--gold)">Book your appointment</p>
    <h2>Ready to book your first session?</h2>
    <p>Available at <strong>Reading Clinic</strong> · <strong>Wimbledon Clinic</strong></p>
    <div class="actions actions-c">
      <a class="btn btn-gold" href={site.whatsapp} target="_blank" rel="noreferrer">Book on WhatsApp</a>
      <a class="btn btn-ghost" href={`tel:${site.phoneIntl}`}>Call {site.phoneDisplay}</a>
    </div>
  </div>
</section>

<style>
  #fees,
  #insurance,
  #provider-numbers,
  #how-to-claim,
  #faq {
    scroll-margin-top: 96px;
  }

  /* Hero — compact two-column, not a tall banner */
  .pi-hero {
    background: var(--navy);
    color: var(--white);
    padding: 3.25rem 0 3rem;
  }
  .pi-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: 3.5rem;
    align-items: center;
  }
  .pi-hero h1 {
    color: var(--white);
    font-size: clamp(1.85rem, 4vw, 2.9rem);
    margin-bottom: 0.75rem;
  }
  .pi-hero .lede {
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.88);
    max-width: 42ch;
    line-height: 1.65;
    margin-bottom: 1.35rem;
  }
  .pi-hero-visual {
    position: relative;
    min-width: 0;
  }
  .pi-hero-visual img {
    width: 100%;
    height: 340px;
    object-fit: cover;
    object-position: center;
    border-radius: var(--r-lg);
    display: block;
  }
  .pi-hero-panel {
    position: absolute;
    left: 1rem;
    right: 1rem;
    bottom: 1rem;
    background: var(--white);
    color: var(--navy);
    border-radius: var(--r-md);
    padding: 0.85rem 1.1rem;
    box-shadow: var(--sh-sm);
  }
  .pi-hero-panel-label {
    margin: 0 0 0.15rem;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .pi-hero-panel-names {
    margin: 0;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--navy);
    line-height: 1.4;
  }

  .pi-fees-head,
  .pi-insure-head { max-width: 58ch; }

  /* Price list blocks */
  .pi-fee-sections {
    display: grid;
    gap: 1.15rem;
  }
  .pi-fee-block {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    box-shadow: var(--sh-xs);
    padding: 1.5rem 1.55rem 1.45rem;
    min-width: 0;
  }
  .pi-fee-block h3 {
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--gold);
    margin: 0 0 1rem;
  }
  .pi-fee-rows {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
  }
  .pi-fee-rows > li {
    margin: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.35rem 1.25rem;
    align-items: baseline;
    padding: 0.85rem 0;
    border-top: 1px solid var(--border);
    font-size: 0.95rem;
  }
  .pi-fee-rows > li:first-child { border-top: none; padding-top: 0; }
  .pi-fee-label {
    color: var(--navy);
    font-weight: 600;
    line-height: 1.45;
    min-width: 0;
  }
  .pi-fee-amount {
    font-family: var(--serif);
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--navy);
    font-variant-numeric: tabular-nums;
    text-align: right;
    white-space: nowrap;
  }
  .pi-fee-unit {
    font-family: var(--sans);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--muted);
    letter-spacing: 0.02em;
  }
  .pi-fee-free {
    color: var(--gold);
    font-style: italic;
  }
  .pi-fee-hint {
    grid-column: 1 / -1;
    font-size: 0.85rem;
    color: var(--muted);
    line-height: 1.45;
    margin-top: -0.15rem;
  }
  /* Must beat `.pi-fee-rows > li` (higher specificity) or detail sits in column 2 on mobile */
  .pi-fee-rows > li.pi-fee-row-featured {
    grid-template-columns: 1fr;
    align-items: start;
    background: #fffdf8;
    margin: 0 -1.55rem;
    padding: 1rem 1.55rem !important;
    border-top-color: rgba(192, 152, 90, 0.28);
    border-bottom: 1px solid rgba(192, 152, 90, 0.28);
  }
  .pi-fee-row-main {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.35rem 1.25rem;
    align-items: baseline;
    grid-column: 1 / -1;
    min-width: 0;
  }
  .pi-fee-row-main .pi-fee-detail {
    grid-column: 1 / -1;
    margin: 0.55rem 0 0;
    font-size: 0.88rem;
    color: var(--muted);
    line-height: 1.55;
    max-width: 62ch;
  }
  .pi-fee-rows > li.pi-fee-row-group {
    grid-template-columns: 1fr;
    align-items: start;
    gap: 0.65rem;
  }
  .pi-fee-subrows {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.35rem;
  }
  .pi-fee-subrows li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    font-size: 0.92rem;
    color: var(--muted);
    padding-left: 0.35rem;
  }
  .pi-fee-subrows .pi-fee-amount {
    font-size: 1.05rem;
  }
  .pi-payment {
    margin: 1.5rem 0 0;
    padding: 1rem 1.2rem;
    background: var(--cream);
    border-radius: var(--r-md);
    font-size: 0.95rem;
    color: var(--navy);
    line-height: 1.5;
  }
  .pi-payment strong { font-weight: 700; }

  /* Insurer logo row */
  .pi-insurers {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.9rem;
  }
  .pi-insurers li {
    margin: 0;
    min-height: 88px;
    display: grid;
    place-items: center;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    padding: 1.1rem 1rem;
  }
  .pi-insurers img {
    height: 32px;
    width: auto;
    max-width: 140px;
    object-fit: contain;
    filter: grayscale(0.15);
  }

  .pi-codes-head {
    margin: 2rem 0 1rem;
    max-width: 62ch;
  }
  .pi-codes-head h3 {
    font-size: 1.2rem;
    margin: 0 0 0.4rem;
  }
  .pi-codes-head p {
    margin: 0;
    font-size: 0.92rem;
    color: var(--muted);
    line-height: 1.6;
  }
  .pi-codes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.9rem;
  }
  .pi-codes li {
    margin: 0;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    padding: 1.15rem 1.1rem 1.2rem;
    min-width: 0;
  }
  .pi-code-name {
    margin: 0 0 0.55rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .pi-code-label {
    margin: 0 0 0.15rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .pi-code-val {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--navy);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
    user-select: all;
  }

  /* Practitioner provider cards */
  .pi-prov-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.2rem;
  }
  .pi-prov-card {
    display: grid;
    grid-template-columns: 88px 1fr;
    gap: 1.15rem;
    align-items: start;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    box-shadow: var(--sh-xs);
    padding: 1.4rem 1.5rem 1.45rem;
    min-width: 0;
  }
  .pi-prov-card img {
    width: 88px;
    height: 88px;
    object-fit: cover;
    object-position: center top;
    border-radius: var(--r-md);
  }
  .pi-prov-card h3 {
    font-size: 1.2rem;
    margin: 0 0 0.2rem;
  }
  .pi-prov-role {
    margin: 0 0 0.9rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .pi-reg-list {
    margin: 0;
    display: grid;
    gap: 0.35rem;
  }
  .pi-reg-list > div {
    display: grid;
    grid-template-columns: 8.2rem minmax(0, 1fr);
    gap: 0.6rem;
    align-items: baseline;
    padding: 0.4rem 0;
    border-top: 1px solid var(--border);
    font-size: 0.9rem;
  }
  .pi-reg-list dt {
    margin: 0;
    color: var(--muted);
    font-weight: 600;
  }
  .pi-reg-list dd {
    margin: 0;
    font-weight: 700;
    color: var(--navy);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
    user-select: all;
  }

  /* Claim process */
  .pi-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.1rem;
    counter-reset: none;
  }
  .pi-steps li {
    margin: 0;
