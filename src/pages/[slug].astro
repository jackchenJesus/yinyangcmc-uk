---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import CTASection from "../components/CTASection.astro";
import pages from "../data/pages.json";

export function getStaticPaths() {
  const leftover = [
    "blog",
    "insights-and-advice-from-our-expert-doctors",
    "insights-from-our-doctors-at-yin-yang-uk",
    "privacy-terms-and-conditions",
  ];
  return leftover
    .filter((slug) => slug in pages)
    .map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const page = (pages as Record<string, { title: string; desc: string; headings: string[]; paras: string[] }>)[slug!];

if (!page) {
  throw new Error(`Unknown slug: ${slug}`);
}

const SKIP_HEADS = new Set([
  "Contact", "BOOK NOW", "01", "02", "03", "04", "05", "06",
  "WH", "AL", "Silo 1 — Clinical Services Pillar Page",
  "Ready to start your recovery?", "Ready to book your first session?",
  "Book via WhatsApp", "FAQ", "Frequently asked questions",
]);
const SKIP_PARA_START = [
  "Acupuncture Tui Na Massage", "All rights reserved",
  "yinyangcmcuk@gmail.com", "Privacy | Terms and Conditions",
  "Reach us anytime", "Call Us 07301",
];

const headings = page.headings.filter((h) => !SKIP_HEADS.has(h));
const paras = page.paras.filter((p) => !SKIP_PARA_START.some((s) => p.startsWith(s)));

const hero = headings[0] || page.title || "";
const lede = (headings[1] && headings[1].length > 40)
  ? headings[1]
  : paras[0]?.slice(0, 240);

const heroImages: Record<string, string> = {
  course: "/images/tcm-workshop-presentation.webp",
};

const courseImages = slug === "course"
  ? [
      "/images/tcm-workshop-presentation.webp",
      "/images/tcm-workshop-2.webp",
      "/images/tcm-workshop-3.webp",
      "/images/tcm-workshop-4.webp",
      "/images/tcm-workshop-5.webp",
    ]
  : [];
---
<Base title={page.title} description={page.desc}>
  <PageHero
    title={hero}
    lede={lede}
    bgImage={heroImages[slug!] || "/images/acupuncture-back-treatment.webp"}
    ctaSecLabel="All Services"
    ctaSecHref="/clinical-services"
  />

  <section class="section-soft">
    <div class="wrap">
      <div class="grid-2-lg" style="gap:3.5rem">
        <div class="prose">
          {paras.slice(1).map((p) => <p>{p}</p>)}
        </div>
        {heroImages[slug!] && (
          <img
            class="rounded-photo"
            src={heroImages[slug!]}
            alt="Pain relief workshop presentation"
            width="1400"
            height="1050"
            style="min-height:280px;max-height:420px"
            loading="lazy"
          />
        )}
      </div>

      {headings.slice(2, 18).length > 0 && (
        <div style="margin-top:2.5rem;padding-top:2rem;border-top:1px solid var(--border)">
          <h3>Key information</h3>
          <div class="key-chips">
            {headings.slice(2, 18).map((h) => <span class="key-chip">{h}</span>)}
          </div>
        </div>
      )}
    </div>
  </section>

  {courseImages.length > 0 && (
    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow">Workshop</p>
          <h2>Course photos</h2>
        </div>
        <div class="grid-3">
          {courseImages.map((src) => (
            <img class="rounded-photo" src={src} alt="TCM course workshop" width="1400" height="1050" style="min-height:180px;max-height:220px" loading="lazy" />
          ))}
        </div>
      </div>
    </section>
  )}

  <CTASection />
</Base>
