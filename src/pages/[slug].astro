---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import CTASection from "../components/CTASection.astro";
import pages from "../data/pages.json";
import { clinics } from "../data/site";

// Pages with dedicated Astro files — excluded from this fallback template
export function getStaticPaths() {
  const skip = new Set([
    "home",
    "contact",
    "pricing-and-insurance",
    "clinical-services",
    // Batch 1 — dedicated service pages
    "acupuncture",
    "tui-na-massage",
    "bone-setting",
    "herbal-consultation",
    // Batch 2 — other treatment sub-pages
    "other-treatment",
    "cupping",
    "gua-sha",
    "moxibustion",
    "auricular-therapy",
    "tian-jiu",
  ]);
  return Object.keys(pages)
    .filter((slug) => !skip.has(slug))
    .map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const page = (pages as Record<string, { title: string; desc: string; headings: string[]; paras: string[] }>)[slug!];

// Filter out navigation/footer/internal artefacts from scraped content
const SKIP_HEADS = new Set([
  "Contact", "BOOK NOW", "01", "02", "03", "04", "05", "06",
  "WH", "AL", "Silo 1 — Clinical Services Pillar Page",
  "Ready to start your recovery?", "Ready to book your first session?",
  "Book via WhatsApp", "FAQ", "Frequently asked questions",
]);
const SKIP_PARA_START = [
  "Acupuncture Tui Na Massage", "All rights reserved",
  "yinyangcmcuk@gmail.com", "Privacy | Terms and Conditions",
  "Reach us anytime", "Call Us 07301",
];

const headings = page.headings.filter((h) => !SKIP_HEADS.has(h));
const paras    = page.paras.filter((p) =>
  !SKIP_PARA_START.some((s) => p.startsWith(s))
);

const hero = headings[0] || page.title;
const lede = (headings[1] && headings[1].length > 40)
  ? headings[1]
  : paras[0]?.slice(0, 240);

const heroImages: Record<string, string> = {
  conditions:           "/images/conditions-we-treat-OWrWp19D0BpU3xPw.webp",
  "back-pain":          "/images/back_pain_treatment-vMLmusxJIAVKmYK5.png",
  "sciatica-treatment": "/images/sciatica-lower-back-pain-CiEnhdaob4WbteY2.png",
  "frozen-shoulder":    "/images/acupuncture_for_frozen_shoulder-LYlyaUQ7GqsYzZB5.webp",
  "shoulder-pain":      "/images/acupuncture-for-shoulder-pain-k9uul1g0Hqlp9Qaa.webp",
  "sports-injuries":    "/images/sports-injuries-orthopaedics-7F9Mh61pjr43DjEH.png",
  "reading-clinic":     "/images/ed61151b-8db1-40a1-9f0f-4d9fee7567c5_edi-B2yhs2iysFxKirqN.jpg",
  "wimbledon-clinic":   "/images/screenshot-2025-12-05-at-10.17.22-1VPeecyL0rBlKQh4.jpg",
  locations:            "/images/img_6058-eVlfhKuykGV6M98J.jpg",
  course:               "/images/lesson-1-sqDt7CzsVqOfjk8h.jpg",
};

const locationSlugs = new Set(["locations", "reading-clinic", "wimbledon-clinic"]);
const showLocations = locationSlugs.has(slug!);
const courseImages = slug === "course"
  ? [
      "/images/lesson-1-sqDt7CzsVqOfjk8h.jpg",
      "/images/lesson-2-lRbBjXWM7hxFlTSo.jpg",
      "/images/lesson-3-KEj7Q3TDqNbc5hA8.jpg",
      "/images/lesson-4-FeX7VoWsezomSvjS.jpg",
      "/images/lesson-5-uPJtsceVCgOAp9aF.jpg",
    ]
  : [];
---
<Base title={page.title} description={page.desc}>
  <PageHero
    title={hero}
    lede={lede}
    bgImage={heroImages[slug!] || "/images/webbanner-eQwGJSc8Re6udP6z.jpg"}
    ctaSecLabel="All Services"
    ctaSecHref="/clinical-services"
  />

  <section class="section-soft">
    <div class="wrap">
      <div class="grid-2-lg" style="gap:3.5rem">
        <div class="prose">
          {paras.slice(1).map((p) => <p>{p}</p>)}
        </div>
        {heroImages[slug!] && (
          <img
            class="rounded-photo"
            src={heroImages[slug!]}
            alt=""
            style="min-height:280px;max-height:420px"
            loading="lazy"
          />
        )}
      </div>

      {headings.slice(2, 18).length > 0 && (
        <div style="margin-top:2.5rem;padding-top:2rem;border-top:1px solid var(--border)">
          <h3>Key information</h3>
          <div class="key-chips">
            {headings.slice(2, 18).map((h) => <span class="key-chip">{h}</span>)}
          </div>
        </div>
      )}
    </div>
  </section>

  {courseImages.length > 0 && (
    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow">Workshop</p>
          <h2>Course photos</h2>
        </div>
        <div class="grid-3">
          {courseImages.map((src) => (
            <img class="rounded-photo" src={src} alt="Course workshop" style="min-height:180px;max-height:220px" loading="lazy" />
          ))}
        </div>
      </div>
    </section>
  )}

  {showLocations && (
    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow">Our Clinics</p>
          <h2>Reading &amp; Wimbledon</h2>
        </div>
        <div class="grid-2">
          <article class="loc-card">
            <img src="/images/ed61151b-8db1-40a1-9f0f-4d9fee7567c5_edi-B2yhs2iysFxKirqN.jpg" alt="Reading clinic" />
            <div class="loc-body">
              <span class="loc-tag">Berkshire · Castle Street</span>
              <h3>Reading</h3>
              <div class="loc-row"><strong>Address</strong><span>{clinics.reading.address}</span></div>
              <div class="loc-row"><strong>Hours</strong><span>{clinics.reading.hours}</span></div>
              <div class="loc-actions">
                <a class="btn btn-outline btn-sm" href="/reading-clinic">Clinic details</a>
                <a class="btn btn-gold btn-sm" href="https://wa.me/447301949686" target="_blank" rel="noreferrer">Book</a>
              </div>
            </div>
          </article>
          <article class="loc-card">
            <img src="/images/screenshot-2025-12-05-at-10.17.22-1VPeecyL0rBlKQh4.jpg" alt="Wimbledon clinic" />
            <div class="loc-body">
              <span class="loc-tag">South West London · SW19</span>
              <h3>Wimbledon</h3>
              <div class="loc-row"><strong>Address</strong><span>{clinics.wimbledon.address}</span></div>
              <div class="loc-row"><strong>Hours</strong><span>{clinics.wimbledon.hours}</span></div>
              <div class="loc-actions">
                <a class="btn btn-outline btn-sm" href="/wimbledon-clinic">Clinic details</a>
                <a class="btn btn-gold btn-sm" href="https://wa.me/447301949686" target="_blank" rel="noreferrer">Book</a>
              </div>
            </div>
          </article>
        </div>
      </div>
    </section>
  )}

  <CTASection />
</Base>
