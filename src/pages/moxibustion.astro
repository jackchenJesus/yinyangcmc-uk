---
import Base from "../layouts/Base.astro";
import FAQAccordion from "../components/FAQAccordion.astro";
import CTASection from "../components/CTASection.astro";

const faqItems = [
  {
    q: "What does moxibustion feel like?",
    a: "Moxibustion produces a gentle, penetrating warmth at the treatment site. Indirect moxa (held above the skin) is comfortable and most patients find it relaxing. Direct moxa uses smaller cones placed closer to the skin and generates a more intense warmth. Your practitioner will always monitor heat levels and adjust based on your feedback.",
  },
  {
    q: "Is moxibustion suitable for me if I am pregnant?",
    a: "Moxibustion at specific acupoints has been used in TCM practice during pregnancy. However, certain points are contraindicated throughout pregnancy, and others are only appropriate in specific trimesters. Please disclose your pregnancy when booking — your practitioner will assess suitability and adapt accordingly.",
  },
  {
    q: "Does moxibustion produce smoke?",
    a: "Traditional moxa produces a distinctive herbal smoke. Our clinic uses a ventilated treatment environment. Smokeless moxa charcoal sticks are also available as an alternative for patients with respiratory sensitivities — please inform us when booking.",
  },
  {
    q: "When is moxibustion not appropriate?",
    a: "Moxibustion is contraindicated in heat-pattern conditions (where the underlying TCM diagnosis involves excess heat), over inflamed or infected skin, and in patients with conditions requiring anti-coagulant medication where vasodilation may be a clinical concern. Your practitioner will assess this before treatment.",
  },
  {
    q: "Can moxibustion and acupuncture be used together?",
    a: "Yes. Needle-on-moxa (warm needle acupuncture) combines both in a single technique — a moxa cylinder is placed on the handle of an inserted needle to conduct warmth directly into the acupoint. This is often used for cold-pattern joint and muscular pain.",
  },
];
---
<Base
  title="Moxibustion Wimbledon & Reading | TCM Moxa Therapy | Yin Yang CMC"
  description="Professional moxibustion therapy in Wimbledon & Reading. Registered TCM practitioners using moxa to warm meridians, dispel cold, and support circulatory and digestive health."
>


<!-- ═══════════════════════════════════════════════
     §1 HERO
═══════════════════════════════════════════════ -->
<section class="page-hero" style="min-height:68vh;display:grid;place-items:center">
  <img
    class="page-hero-bg"
    src="/images/generated/moxibustion-therapy-hero.webp"
    alt=""
    width="1536"
    height="1024"
    loading="eager"
    fetchpriority="high"
  />
  <div class="wrap" style="padding:5rem 0 3.5rem">
    <p class="eyebrow">Moxibustion · Reading &amp; Wimbledon</p>
    <h1>Moxibustion Therapy<br>in Wimbledon &amp; Reading</h1>
    <p class="lede">
      Warming meridian therapy using dried mugwort — dispelling cold, promoting
      blood circulation, and unblocking the meridians.
    </p>

    <div class="hero-exp-stat">
      <span class="hero-exp-num">15+</span>
      <span class="hero-exp-label">Years'<br>Clinical Experience</span>
    </div>

    <div class="actions" style="margin-top:0">
      <a class="btn btn-gold" href="https://wa.me/447301949686" target="_blank" rel="noreferrer">Book a Consultation</a>
      <a class="btn btn-ghost" href="/clinical-services">All Clinical Services</a>
    </div>

    <div class="hero-trust-row">
      <span><span class="htc">✓</span> BAcC &amp; ATCM Registered</span>
      <span><span class="htc">✓</span> Clinical Assessment First</span>
      <span><span class="htc">✓</span> No Referral Needed</span>
      <span><span class="htc">✓</span> Insurance Recognised</span>
    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════
     §2 WHAT IS MOXIBUSTION
═══════════════════════════════════════════════ -->
<section class="section-soft">
  <div class="wrap">
    <div class="grid-2-al" style="gap:4rem">

      <div>
        <p class="eyebrow">About the Treatment</p>
        <h2>What Is Moxibustion? <span style="font-size:1.2rem;color:var(--gold)">艾灸</span></h2>
        <p>
          Moxibustion is a TCM thermal therapy in which dried mugwort (Artemisia vulgaris,
          or 艾葉) is burned near or on specific acupoints. The penetrating warmth
          generated by moxa is distinct from ordinary heat — its therapeutic depth
          and infrared spectrum differ from surface-level warming.
        </p>
        <p>
          In TCM, moxibustion is used primarily to warm the meridians, dispel cold,
          promote blood circulation, and unblock the meridians. It is the primary
          treatment modality for cold-pattern and deficiency-cold presentations —
          conditions where acupuncture alone may be insufficient without added warmth.
        </p>

        <ul style="list-style:none;padding:0;margin:1.5rem 0 0;display:grid;gap:0.5rem">
          {[
            "Warms the meridians and dispels pathogenic cold",
            "Promotes Qi and blood circulation",
            "Strengthens Yang and tonifies deficiency",
            "Can be combined with acupuncture as warm-needle technique",
          ].map((item) => (
            <li style="display:flex;gap:0.6rem;align-items:flex-start;font-size:0.92rem">
              <span style="color:var(--gold);font-weight:700;flex-shrink:0;margin-top:0.05em">✓</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>

        <div class="actions" style="margin-top:1.8rem">
          <a class="btn btn-gold" href="https://wa.me/447301949686" target="_blank" rel="noreferrer">Book a Consultation</a>
          <a class="btn btn-outline" href="/acupuncture">About Acupuncture</a>
        </div>
      </div>

      <div style="background:var(--cream);border-radius:var(--r-lg);padding:2rem;border:1px solid rgba(192,152,90,0.2)">
        <p class="eyebrow">Types of Moxibustion</p>
        <h3 style="font-size:1.1rem;margin-bottom:1.2rem">Methods Used at Yin Yang CMC</h3>
        <div style="display:grid;gap:1rem">
          {[
            { name: "Indirect Moxa (Moxa Stick)", desc: "A moxa stick is held 2–3 cm above the acupoint, creating a gentle circulating or pecking warmth. Comfortable and suitable for most patients — the most commonly used form." },
            { name: "Warm Needle Acupuncture", desc: "A cylinder of moxa is placed on the handle of an inserted acupuncture needle. Heat conducts directly into the acupoint via the needle shaft — a precise and effective combined technique." },
            { name: "Moxa Box", desc: "A wooden box containing burning moxa is placed over a region such as the abdomen or lower back. Provides sustained, even warmth over a larger area — useful for digestive and gynaecological conditions." },
          ].map(({ name, desc }) => (
            <div style="padding-bottom:1rem;border-bottom:1px solid rgba(192,152,90,0.15)">
              <h4 style="font-size:0.95rem;color:var(--navy);margin-bottom:0.3rem">{name}</h4>
              <p style="font-size:0.87rem;color:var(--muted);line-height:1.55;margin:0">{desc}</p>
            </div>
          ))}
        </div>
      </div>

    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════
     §3 CONDITIONS
═══════════════════════════════════════════════ -->
<section class="section">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">Conditions</p>
      <h2>What Moxibustion May Be Used For</h2>
      <p>
        Moxibustion is most appropriate for cold-pattern and deficiency presentations.
        Your practitioner will assess your TCM pattern before recommending it.
      </p>
    </div>

    <div class="grid-3" style="margin-bottom:2.5rem">
      <div style="padding:1.6rem;background:var(--cream);border-radius:var(--r-lg);border:1px solid rgba(192,152,90,0.2)">
        <p style="font-size:1.4rem;margin-bottom:0.5rem">🦴</p>
        <h3 style="font-size:1.05rem">Cold-Pattern Joint Pain</h3>
        <p style="font-size:0.9rem;color:var(--muted)">
          Joint pain worsened by cold and improved with warmth, including rheumatic
          conditions, cold lower back pain, and stiff joints. Moxa directly
          addresses the cold-stagnation pattern.
        </p>
        <a class="more-link" href="/back-pain">Back Pain</a>
      </div>
      <div style="padding:1.6rem;background:var(--cream);border-radius:var(--r-lg);border:1px solid rgba(192,152,90,0.2)">
        <p style="font-size:1.4rem;margin-bottom:0.5rem">🌸</p>
        <h3 style="font-size:1.05rem">Gynaecological Conditions</h3>
        <p style="font-size:0.9rem;color:var(--muted)">
          Cold-type menstrual pain, irregular cycles, and post-natal recovery.
          Moxa to the lower abdomen and sacral points is a central treatment
          approach in these presentations.
        </p>
        <a class="more-link" href="/contact">Enquire</a>
      </div>
      <div style="padding:1.6rem;background:var(--cream);border-radius:var(--r-lg);border:1px solid rgba(192,152,90,0.2)">
        <p style="font-size:1.4rem;margin-bottom:0.5rem">🍽️</p>
        <h3 style="font-size:1.05rem">Digestive Health</h3>
        <p style="font-size:0.9rem;color:var(--muted)">
          Cold-type digestive presentations including diarrhea, stomach pain,
          bloating, and poor appetite. Moxa to the abdomen warms the
          Spleen and Stomach in TCM terms.
        </p>
        <a class="more-link" href="/conditions">All Conditions</a>
      </div>
    </div>

    <div class="cond-grid">
      {[
        { label: "Cold-Pattern Back Pain",  href: "/back-pain" },
        { label: "Rheumatism",              href: "/conditions" },
        { label: "Frozen Shoulder",         href: "/frozen-shoulder" },
        { label: "Menstrual Irregularity",  href: "/conditions" },
        { label: "Digestive Disorders",     href: "/conditions" },
        { label: "Post-Natal Recovery",     href: "/conditions" },
        { label: "Chronic Fatigue",         href: "/conditions" },
        { label: "Seasonal Care",           href: "/conditions" },
      ].map(({ label, href }) => (
        <a class="cond-chip" href={href}>{label}</a>
      ))}
    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════
     §4 HOW IT WORKS — dark
═══════════════════════════════════════════════ -->
<section class="section-dark">
  <div class="wrap">
    <div class="section-head" style="max-width:52ch">
      <p class="eyebrow eyebrow-dark">Your Session</p>
      <h2>How a Moxibustion Session Works</h2>
    </div>

    <div class="journey-grid">
      <div class="journey-step">
        <div class="j-num">01</div>
        <h3>Pattern Diagnosis</h3>
        <p>
          Moxibustion is only appropriate for cold-pattern presentations. Your
          practitioner will assess your TCM pattern — pulse, tongue, symptom profile —
          to confirm moxa is clinically indicated before applying it.
        </p>
      </div>
      <div class="journey-step">
        <div class="j-num">02</div>
        <h3>Moxa Application</h3>
        <p>
          Moxa is applied to the selected acupoints or regions using the appropriate
          method. Your practitioner monitors heat levels throughout and adjusts distance
          or intensity based on your feedback and tissue response.
        </p>
      </div>
      <div class="journey-step">
        <div class="j-num">03</div>
        <h3>Integration &amp; Aftercare</h3>
        <p>
          Moxibustion is usually integrated into a broader treatment session. You will
          receive guidance on keeping treated areas warm and avoiding cold exposure
          after the session to preserve the therapeutic effect.
        </p>
      </div>
    </div>

    <p style="margin-top:2.5rem;text-align:center">
      <a class="btn btn-gold" href="https://wa.me/447301949686" target="_blank" rel="noreferrer">Book Your Consultation</a>
    </p>
  </div>
</section>


<!-- ═══════════════════════════════════════════════
     §5 FAQ
═══════════════════════════════════════════════ -->
<section class="section">
  <div class="wrap">
    <div class="grid-2-lg" style="gap:5rem">
      <div>
        <p class="eyebrow">Common Questions</p>
        <h2>Questions About Moxibustion</h2>
        <p style="color:var(--muted)">
          What patients commonly ask before their first moxibustion session.
        </p>
        <div class="actions" style="margin-top:1.5rem">
          <a class="btn btn-gold" href="https://wa.me/447301949686" target="_blank" rel="noreferrer">Ask Us Directly</a>
        </div>
        <div style="margin-top:2rem;padding-top:2rem;border-top:1px solid var(--border)">
          <p style="font-size:0.84rem;color:var(--muted);margin-bottom:0.75rem">Related therapies:</p>
          <div style="display:grid;gap:0.3rem">
            <a href="/tian-jiu" style="font-size:0.9rem;color:var(--teal);font-weight:600;text-decoration:none">→ Tian Jiu (Non-Thermal Moxa)</a>
            <a href="/cupping" style="font-size:0.9rem;color:var(--teal);font-weight:600;text-decoration:none">→ Cupping Therapy</a>
            <a href="/acupuncture" style="font-size:0.9rem;color:var(--teal);font-weight:600;text-decoration:none">→ Acupuncture</a>
          </div>
        </div>
      </div>
      <FAQAccordion items={faqItems} />
    </div>
  </div>
</section>


<CTASection
  heading="Book Your Moxibustion Session"
  sub="Same-week appointments at Reading and Wimbledon. Moxibustion is often combined with acupuncture — your practitioner will advise on the appropriate approach."
/>

</Base>
