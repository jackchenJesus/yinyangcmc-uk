---
import Base from "../layouts/Base.astro";
import FAQAccordion from "../components/FAQAccordion.astro";
import CTASection from "../components/CTASection.astro";

const faqItems = [
  {
    q: "Is bone setting painful?",
    a: "Patients may feel brief localised pressure during manipulation. Mild muscle soreness within 24 hours is a normal tissue response and typically resolves before the second session. Your practitioner will explain each technique before applying it.",
  },
  {
    q: "Do I need an X-ray or MRI first?",
    a: "Imaging aids diagnosis but is not a prerequisite. Our practitioners perform a clinical orthopaedic assessment at first consultation. If fracture, severe osteoporosis, or other contraindications are suspected, imaging will be recommended before any manual treatment proceeds.",
  },
  {
    q: "How many sessions are typically needed?",
    a: "Acute joint restriction often shows change within 2–4 sessions. Longer-standing spinal or postural presentations are typically reviewed over a 6–8 session cycle, alongside daily postural work. Your practitioner will give a realistic timeline at the initial assessment.",
  },
  {
    q: "Is bone setting suitable for all ages?",
    a: "Most adults are suitable candidates. Contraindications include severe osteoporosis, bone tumours, acute inflammatory arthritis flare, and unhealed fractures. All are screened thoroughly at initial assessment before any manual treatment proceeds.",
  },
  {
    q: "Are your practitioners registered in the UK?",
    a: "Yes. Both practitioners are registered members of the British Acupuncture Council (MBAcC), listed on the Professional Standards Authority's Accredited Register, and registered with the Association of Traditional Chinese Medicine & Acupuncture (ATCM). Member nos: 963087 & 963093.",
  },
  {
    q: "Do you accept health insurance?",
    a: "We are recognised by AXA Health, Vitality, Aviva and WPA. Provider recognition does not mean bone setting is automatically covered. Check your individual policy with your insurer before treatment. Provider numbers are on our Pricing & Insurance page.",
  },
];
---
<Base
  title="Bone Setting Wimbledon & Reading | Chinese Orthopaedic Care | Yin Yang CMC"
  description="Professional bone setting & orthopaedic care in Wimbledon & Reading. British Acupuncture Council registered. Zheng Gu manual joint mobilisation for spinal and joint conditions."
>


<!-- ═══════════════════════════════════════════════
     §1 HERO
═══════════════════════════════════════════════ -->
<section class="page-hero" style="min-height:68vh;display:grid;place-items:center">
  <img
    class="page-hero-bg"
    src="/images/bone-setting-treatment.webp"
    alt=""
    loading="eager"
    fetchpriority="high"
  />
  <div class="wrap" style="padding:5rem 0 3.5rem">
    <p class="eyebrow">Bone Setting · Reading &amp; Wimbledon</p>
    <h1>Bone Setting &amp;<br>Orthopaedic Care<br>in Wimbledon &amp; Reading</h1>
    <p class="lede">
      Zheng Gu — classical Chinese orthopaedic manual therapy — applied within a
      modern biomechanical assessment framework. British Acupuncture Council registered.
    </p>

    <div class="hero-exp-stat">
      <span class="hero-exp-num">15+</span>
      <span class="hero-exp-label">Years'<br>Clinical Experience</span>
    </div>

    <div class="actions" style="margin-top:0">
      <a class="btn btn-gold" href="https://wa.me/447301949686" target="_blank" rel="noreferrer">Book a Consultation</a>
      <a class="btn btn-ghost" href="/clinical-services">All Clinical Services</a>
    </div>

    <div class="hero-trust-row">
      <span><span class="htc">✓</span> British Acupuncture Council Member</span>
      <span><span class="htc">✓</span> Hospital Tui Na training</span>
      <span><span class="htc">✓</span> Insurance Recognised</span>
      <span><span class="htc">✓</span> No Referral Needed</span>
    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════
     §2 WHAT IS BONE SETTING
═══════════════════════════════════════════════ -->
<section class="section-soft">
  <div class="wrap">
    <div class="grid-2-al" style="gap:4rem">

      <div>
        <p class="eyebrow">About the Treatment</p>
        <h2>What Is Bone Setting?</h2>
        <p>
          Zheng Gu (正骨) — Chinese bone setting — is an orthopaedic manual therapy involving
          mobilisation of joints, vertebrae, and surrounding soft tissue. It uses
          a combination of traction, rotation, joint mobilisation, and soft tissue techniques
          for restricted movement and musculoskeletal pain.
        </p>
        <p>
          Bone setting is used for joint restriction, facet irritation, and myofascial
          tightness — after assessment, not as a stand-alone “put the bone back” procedure.
          At Yin Yang CMC, it is applied within a modern biomechanical assessment
          framework — contraindication screening, range of motion assessment, and spinal history
          review before any manual technique is applied.
        </p>

        <ul style="list-style:none;padding:0;margin:1.5rem 0 0;display:grid;gap:0.5rem">
          {[
            "Contraindication screening at every initial assessment",
            "Practitioner Winton trained at Tung Wah Eastern Hospital, Hong Kong",
            "May be combined with Tui Na or acupuncture in the same session",
            "Same-week appointments at Reading and Wimbledon",
          ].map((item) => (
            <li style="display:flex;gap:0.6rem;align-items:flex-start;font-size:0.92rem">
              <span style="color:var(--gold);font-weight:700;flex-shrink:0;margin-top:0.05em">✓</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>

        <div class="actions" style="margin-top:1.8rem">
          <a class="btn btn-gold" href="https://wa.me/447301949686" target="_blank" rel="noreferrer">Book a Consultation</a>
          <a class="btn btn-outline" href="/pricing-and-insurance">Pricing &amp; Insurance</a>
        </div>
      </div>

      <div class="img-wrap" style="position:relative">
        <img
          src="/images/acupuncture-abdomen-treatment.webp"
          alt="Acupuncture needles being inserted into a patient's abdomen"
          style="width:100%;height:460px;object-fit:cover;border-radius:var(--r-lg)"
          loading="lazy"
        />
        <div class="cred-panel">
          <div class="cred-row"><span class="cred-check">✓</span> MBAcC · Nos. 963087 &amp; 963093</div>
          <div class="cred-row"><span class="cred-check">✓</span> ATCM Professional Member</div>
          <div class="cred-row"><span class="cred-check">✓</span> Tung Wah Eastern Hospital trained</div>
          <div class="cred-row"><span class="cred-check">✓</span> AXA · Vitality · Aviva · WPA</div>
        </div>
      </div>

    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════
     §3 CONDITIONS / PRESENTATIONS
═══════════════════════════════════════════════ -->
<section class="section">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">Conditions</p>
      <h2>What Bone Setting May Be Used For</h2>
      <p>
        Your practitioner will assess your individual presentation before any manual
        technique is applied. Bone setting is not appropriate for all patients —
        thorough contraindication screening is standard at every initial consultation.
      </p>
    </div>

    <div class="grid-3" style="margin-bottom:2.5rem">
      <div style="padding:1.6rem;background:var(--cream);border-radius:var(--r-lg);border:1px solid rgba(192,152,90,0.2)">
        <p style="font-size:1.4rem;margin-bottom:0.5rem">🦴</p>
        <h3 style="font-size:1.05rem">Spinal Conditions</h3>
        <p style="font-size:0.9rem;color:var(--muted)">
          Lumbar and cervical disc-related presentations, facet joint restriction, and
          postural strain. Joint mobilisation and traction may be used to ease nerve-root
          irritation and compensatory muscle tension after screening.
        </p>
        <a class="more-link" href="/back-pain">Back Pain &amp; Sciatica</a>
      </div>
      <div style="padding:1.6rem;background:var(--cream);border-radius:var(--r-lg);border:1px solid rgba(192,152,90,0.2)">
        <p style="font-size:1.4rem;margin-bottom:0.5rem">🏃</p>
        <h3 style="font-size:1.05rem">Joint &amp; Sports Injuries</h3>
        <p style="font-size:0.9rem;color:var(--muted)">
          Recurrent ankle sprains, shoulder restriction, medial knee ligament strains.
          Bone setting may be used 48–72 hours after an acute injury to support joint
          mobility. Contraindications are assessed first.
        </p>
        <a class="more-link" href="/sports-injuries">Sports Injuries</a>
      </div>
      <div style="padding:1.6rem;background:var(--cream);border-radius:var(--r-lg);border:1px solid rgba(192,152,90,0.2)">
        <p style="font-size:1.4rem;margin-bottom:0.5rem">🧠</p>
        <h3 style="font-size:1.05rem">Myofascial Pain</h3>
        <p style="font-size:0.9rem;color:var(--muted)">
          Myofascial tightness restricting range of motion and creating trigger points
          that radiate distally. A dual approach — joint mobilisation and simultaneous
          soft-tissue work — is used where both layers are involved.
        </p>
        <a class="more-link" href="/shoulder-pain">Shoulder Pain</a>
      </div>
    </div>

    <p style="font-size:0.78rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--muted);margin-bottom:0.75rem">Commonly treated presentations:</p>
    <div class="cond-grid">
      {[
        { label: "Back Pain",               href: "/back-pain" },
        { label: "Sciatica",                href: "/sciatica-treatment" },
        { label: "Neck Pain",               href: "/neck-pain" },
        { label: "Shoulder Pain",           href: "/shoulder-pain" },
        { label: "Frozen Shoulder",         href: "/frozen-shoulder" },
        { label: "Sports Injuries",         href: "/sports-injuries" },
        { label: "Postural Problems",       href: "/conditions" },
        { label: "Knee Joint Pain",         href: "/knee-pain" },
        { label: "Ankle Instability",       href: "/conditions" },
      ].map(({ label, href }) => (
        <a class="cond-chip" href={href}>{label}</a>
      ))}
    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════
     §4 HOW TREATMENT WORKS — dark
═══════════════════════════════════════════════ -->
<section class="section-dark">
  <div class="wrap">
    <div class="section-head" style="max-width:52ch">
      <p class="eyebrow eyebrow-dark">Your First Visit</p>
      <h2>How Bone Setting Treatment Works</h2>
      <p style="color:rgba(240,234,226,0.75)">Assessment, screening, and explanation before any manual technique is applied.</p>
    </div>

    <div class="journey-grid">
      <div class="journey-step">
        <div class="j-num">01</div>
        <h3>Clinical Assessment</h3>
        <p>
          Symptom timeline, trigger movements, medical history review. Spinal range of
          motion, gait analysis, and postural compensation patterns assessed. Palpation
          to locate restricted segments and fascial tightness.
        </p>
      </div>
      <div class="journey-step">
        <div class="j-num">02</div>
        <h3>Contraindication Screening</h3>
        <p>
          Fractures, severe osteoporosis, tumours, and active infection are ruled out
          before any manipulation proceeds. Where imaging is indicated, it is requested
          before treatment begins.
        </p>
      </div>
      <div class="journey-step">
        <div class="j-num">03</div>
        <h3>Treatment &amp; Review</h3>
        <p>
          Manual technique selection based on your clinical findings. Progress reviewed
          at each follow-up and technique adjusted. Discharge criteria — measurable
          functional goals — agreed at the start.
        </p>
      </div>
    </div>

    <p style="margin-top:2.5rem;text-align:center">
      <a class="btn btn-gold" href="https://wa.me/447301949686" target="_blank" rel="noreferrer">Book Your First Consultation</a>
    </p>
  </div>
</section>


<!-- ═══════════════════════════════════════════════
     §5 CLINICAL APPROACH
═══════════════════════════════════════════════ -->
<section class="section-soft">
  <div class="wrap">
    <div class="grid-2-lg" style="gap:5rem">

      <div>
        <p class="eyebrow">Our Approach</p>
        <h2>Bone Setting at Yin Yang CMC</h2>

        <div class="pull-quote">
          <p>"Every technique is grounded in anatomical rationale — contraindication
          screening and clinical assessment before any manual work begins."</p>
        </div>

        <p>
          Yin Yang CMC's bone setting approach is applied within a modern biomechanical
          assessment framework. Before any manipulation, your practitioner reviews your
          spinal history, assesses range of motion, and identifies any contraindications.
        </p>

        <p>
          Bone setting may be combined with Tui Na and acupuncture in a single session
          where clinically indicated — for example, Tui Na pre-treatment to reduce muscle
          resistance before mobilisation, and acupuncture post-treatment to manage local
          inflammation response.
        </p>

        <details class="expand-detail">
          <summary class="expand-summary">
            Manual techniques used
            <span class="expand-icon" aria-hidden="true">+</span>
          </summary>
          <div class="expand-body">
            <h3>Joint mobilisation</h3>
            <p>
              Low-velocity progressive joint surface gliding — used for acute or sensitive
              presentations where high-velocity manipulation is not yet appropriate.
            </p>
            <h3>HVLA thrust</h3>
            <p>
              High-velocity, low-amplitude manipulation targeting confirmed restriction,
              used to improve joint mobility. Applied only after thorough assessment
              and screening confirm it is clinically appropriate.
            </p>
            <h3>Tendon and small-joint mobilisation</h3>
            <p>
              Fine adjustment of tendon attachment zones — wrist, ankle, and finger
              small joints. Particularly relevant for post-injury restriction where
              larger spinal manipulation is not the primary issue.
            </p>
          </div>
        </details>
      </div>

      <div style="display:grid;gap:1.5rem;align-content:start">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--border);border-radius:var(--r-lg);overflow:hidden">
          {[
            { val: "MBAcC",  label: "BAcC Registered" },
            { val: "15+",    label: "Years' Experience" },
            { val: "HK",     label: "Hospital Tui Na" },
            { val: "EN/粵",  label: "Bilingual Care" },
          ].map(({ val, label }) => (
            <div style="background:var(--white);padding:1.5rem;text-align:center">
              <span style="display:block;font-family:var(--serif);font-size:2rem;color:var(--navy);line-height:1;margin-bottom:0.35rem">{val}</span>
              <span style="font-size:0.76rem;color:var(--muted);text-transform:uppercase;letter-spacing:0.08em">{label}</span>
            </div>
          ))}
        </div>

        <div style="background:var(--cream);border-radius:var(--r-lg);padding:1.4rem 1.6rem;border:1px solid rgba(192,152,90,0.2)">
          <p style="font-size:0.76rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--muted);margin-bottom:0.7rem">Related Treatments</p>
          <div style="display:grid;gap:0.4rem">
            {[
              { label: "Tui Na Therapeutic Massage", href: "/tui-na-massage" },
              { label: "Acupuncture", href: "/acupuncture" },
              { label: "Herbal Medicine Consultation", href: "/herbal-consultation" },
              { label: "All Clinical Services", href: "/clinical-services" },
            ].map(({ label, href }) => (
              <a
                href={href}
                style="display:flex;align-items:center;gap:0.4rem;font-size:0.9rem;font-weight:600;color:var(--teal);text-decoration:none;padding:0.3rem 0"
              >
                → {label}
              </a>
            ))}
          </div>
        </div>

        <div style="background:var(--navy);border-radius:var(--r-md);padding:1.3rem">
          <p style="font-family:var(--serif);font-size:1.02rem;font-style:italic;color:#f0ece2;line-height:1.6;margin:0">
            "Sought after by patients who have not found sufficient relief through physiotherapy or chiropractic alone."
          </p>
          <a class="btn btn-gold btn-sm" href="https://wa.me/447301949686" target="_blank" rel="noreferrer" style="margin-top:0.9rem">WhatsApp Us Now</a>
        </div>
      </div>

    </div>
  </div>
</section>


