---
import Base from "../layouts/Base.astro";
import ClinicDetail from "../components/ClinicDetail.astro";
import { clinics } from "../data/site";
---
<Base
  title="TCM Reading Clinic | Chinese Medicine Clinic Castle St | yin yang uk"
  description="Looking for trusted acupuncture Reading or a TCM Reading Clinic? Our Castle St clinic offers expert acupuncture, bone-setting, Tui Na, and TCM herbal remedies."
>
  <ClinicDetail
    h1="Acupuncture & Chinese Medicine in Reading"
    lede="Yin Yang CMC operates from Reading Health Centre, 61 Castle Street. MSc-qualified practitioners with dual UK registration (ATCM & MBAcC). By appointment only."
    eyebrow="Reading Clinic · Castle Street"
    tag="Berkshire · RG1"
    clinicName="Reading Clinic"
    address={clinics.reading.address}
    hours="Mon / Wed / Fri 9:00 am – 6:00 pm"
    transport="10 min walk from Reading Station — Elizabeth Line & GWR"
    maps={clinics.reading.maps}
    image="/images/reading-clinic-interior.webp"
    imageAlt="Reception and hallway at Yin Yang CMC in Reading"
    intro="Both practitioners assess using classical TCM diagnosis together with modern anatomical understanding. Treatment is determined at consultation — not a one-size protocol."
    localNote="Back pain, sciatica, neck stiffness and frozen shoulder are among the most common presentations at Castle Street. Women's health, skin conditions, and stress-related sleep concerns are also seen here."
    gettingHere="Reading Health Centre is a 10-minute walk from Reading Station. Direct GWR services from London Paddington typically take under 30 minutes. Appointments are available Monday, Wednesday and Friday."
    otherLabel="Wimbledon clinic"
    otherHref="/wimbledon-clinic"
    ctaHeading="Book at our Reading clinic"
  />
</Base>
