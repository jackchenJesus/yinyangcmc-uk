---
import Base from "../layouts/Base.astro";
import CTASection from "../components/CTASection.astro";

const treatments = [
  {
    href: "/cupping",
    title: "Cupping Therapy",
    chinese: "拔罐",
    icon: "🫙",
    summary:
      "A suction-based therapy that stimulates blood flow, releases muscle tension, and removes stasis. Commonly combined with acupuncture for pain and musculoskeletal conditions.",
  },
  {
    href: "/gua-sha",
    title: "Gua Sha",
    chinese: "刮痧",
    icon: "🪨",
    summary:
      "Instrument-assisted scraping that promotes circulation, reduces inflammation, and tonifies deficiency. Most suitable for skin, muscle, and joint conditions.",
  },
  {
    href: "/moxibustion",
    title: "Moxibustion",
    chinese: "艾灸",
    icon: "🔥",
    summary:
      "Thermal therapy using dried mugwort to warm meridians, dispel cold, and promote blood circulation. Often used for cold-pattern conditions and digestive presentations.",
  },
  {
    href: "/auricular-therapy",
    title: "Auricular Therapy",
    chinese: "耳穴",
    icon: "👂",
    summary:
      "Ear seed acupressure that stimulates reflex points on the auricle. Used for insomnia, tinnitus, digestive issues, and pain management — simple and typically well tolerated.",
  },
  {
    href: "/tian-jiu",
    title: "Tian Jiu",
    chinese: "天灸",
    icon: "🌿",
    summary:
      "Non-thermal moxibustion using herbal plasters applied to acupoints. Used as seasonal care for respiratory, digestive, and locomotor presentations. Performed in summer and winter windows.",
  },
];
---

<Base
  title="Other Treatments | Cupping, Gua Sha, Moxibustion, Auricular Therapy & Tian Jiu | Yin Yang CMC"
  description="Explore TCM complementary therapies at Yin Yang CMC: Cupping, Gua Sha, Moxibustion, Auricular Therapy, and Tian Jiu — available at our Reading and Wimbledon clinics."
>


<!-- ═══════════════════════════════════════════════
     §1 HERO
═══════════════════════════════════════════════ -->
<section class="page-hero" style="min-height:60vh;display:grid;place-items:center">
  <img
    class="page-hero-bg"
    src="/images/generated/other-treatment-hero.webp"
    alt=""
    width="1536"
    height="1024"
    loading="eager"
    fetchpriority="high"
  />
  <div class="wrap" style="padding:5rem 0 3.5rem">
    <p class="eyebrow">Complementary Therapies · Reading &amp; Wimbledon</p>
    <h1>Other TCM<br>Treatments</h1>
    <p class="lede">
      Cupping · Gua Sha · Moxibustion · Auricular Therapy · Tian Jiu —
      delivered by British Acupuncture Council registered practitioners.
    </p>
    <div class="actions" style="margin-top:0">
      <a class="btn btn-gold" href="https://wa.me/447301949686" target="_blank" rel="noreferrer">Book a Consultation</a>
      <a class="btn btn-ghost" href="/clinical-services">All Clinical Services</a>
    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════
     §2 OVERVIEW
═══════════════════════════════════════════════ -->
<section class="section-soft">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">Complementary Therapies</p>
      <h2>Our Other Treatment Options</h2>
      <p>
        Alongside acupuncture, Tui Na, bone setting, and herbal medicine, Yin Yang CMC
        offers a range of traditional Chinese medicine external therapies. Each is applied
        according to your clinical picture — not as a fixed add-on.
      </p>
    </div>

    <div class="grid-3" style="margin-bottom:2rem">
      {treatments.slice(0, 3).map((t) => (
        <a
          href={t.href}
          style="display:block;text-decoration:none;padding:1.8rem;background:var(--white);border-radius:var(--r-lg);border:1px solid rgba(192,152,90,0.2);transition:box-shadow 0.18s ease,transform 0.18s ease"
          class="service-card-link"
        >
          <p style="font-size:2rem;margin-bottom:0.6rem">{t.icon}</p>
          <h3 style="font-size:1.08rem;color:var(--navy);margin-bottom:0.2rem">{t.title}</h3>
          <p style="font-size:0.8rem;color:var(--gold);font-weight:600;letter-spacing:0.06em;margin-bottom:0.75rem">{t.chinese}</p>
          <p style="font-size:0.9rem;color:var(--muted);line-height:1.6">{t.summary}</p>
          <span style="display:inline-block;margin-top:1rem;font-size:0.88rem;font-weight:700;color:var(--teal)">Learn more →</span>
        </a>
      ))}
    </div>

    <div class="grid-2" style="max-width:800px;margin:0 auto">
      {treatments.slice(3).map((t) => (
        <a
          href={t.href}
          style="display:block;text-decoration:none;padding:1.8rem;background:var(--white);border-radius:var(--r-lg);border:1px solid rgba(192,152,90,0.2);transition:box-shadow 0.18s ease,transform 0.18s ease"
          class="service-card-link"
        >
          <p style="font-size:2rem;margin-bottom:0.6rem">{t.icon}</p>
          <h3 style="font-size:1.08rem;color:var(--navy);margin-bottom:0.2rem">{t.title}</h3>
          <p style="font-size:0.8rem;color:var(--gold);font-weight:600;letter-spacing:0.06em;margin-bottom:0.75rem">{t.chinese}</p>
          <p style="font-size:0.9rem;color:var(--muted);line-height:1.6">{t.summary}</p>
          <span style="display:inline-block;margin-top:1rem;font-size:0.88rem;font-weight:700;color:var(--teal)">Learn more →</span>
        </a>
      ))}
    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════
     §3 HOW THESE FIT IN
═══════════════════════════════════════════════ -->
<section class="section">
  <div class="wrap">
    <div class="grid-2-lg" style="gap:4rem;align-items:center">
      <div>
        <p class="eyebrow">Clinical Context</p>
        <h2>How These Therapies Fit Into Your Treatment</h2>
        <p>
          These treatments are rarely prescribed in isolation. At Yin Yang CMC,
          complementary therapies are integrated into a holistic treatment plan based on
          your individual clinical assessment. A cupping or Gua Sha session, for example,
          may follow acupuncture within the same appointment when clinically appropriate.
        </p>
        <p>
          Tian Jiu is a seasonal therapy administered in specific windows — your
          practitioner will advise on timing and suitability. Auricular therapy may be
          given as an ongoing self-care protocol between clinic visits.
        </p>
        <div class="actions" style="margin-top:1.8rem">
          <a class="btn btn-gold" href="https://wa.me/447301949686" target="_blank" rel="noreferrer">Ask About Your Options</a>
          <a class="btn btn-outline" href="/acupuncture">Acupuncture</a>
        </div>
      </div>

      <div style="display:grid;gap:1rem">
        {[
          { label: "Acupuncture", href: "/acupuncture" },
          { label: "Tui Na Therapeutic Massage", href: "/tui-na-massage" },
          { label: "Bone Setting & Orthopaedic Care", href: "/bone-setting" },
          { label: "Herbal Medicine Consultation", href: "/herbal-consultation" },
          { label: "All Clinical Services", href: "/clinical-services" },
        ].map(({ label, href }) => (
          <a
            href={href}
            style="display:flex;align-items:center;gap:0.5rem;padding:1rem 1.2rem;background:var(--cream);border-radius:var(--r-md);border:1px solid rgba(192,152,90,0.2);font-size:0.92rem;font-weight:600;color:var(--teal);text-decoration:none;transition:background 0.18s ease"
          >
            → {label}
          </a>
        ))}
      </div>
    </div>
  </div>
</section>


<CTASection
  heading="Book Your Consultation"
  sub="Same-week appointments at our Reading and Wimbledon clinics. Your practitioner will advise which therapies are appropriate for your condition."
/>

<style>
  .service-card-link:hover {
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
    transform: translateY(-2px);
  }
</style>

</Base>
