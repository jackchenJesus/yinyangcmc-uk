# Google Search Console CLI (never commit real values)
# Copy to .env locally.

# Preferred: path to a service-account JSON key (not stored in git)
GOOGLE_APPLICATION_CREDENTIALS=

# Optional alias for the same JSON path
GSC_SERVICE_ACCOUNT_PATH=

# Optional instead of a JSON file (PEM with \n escapes). Do not commit.
GSC_CLIENT_EMAIL=
GSC_PRIVATE_KEY=

# OAuth Desktop client JSON (alternative to a service account)
GSC_OAUTH_CLIENT_PATH=
GSC_TOKEN_PATH=

# Property overrides (defaults match production)
GSC_SITE_ORIGIN=https://yinyangcmc.uk
GSC_SITEMAP_URL=https://yinyangcmc.uk/sitemap-index.xml
# GSC_SITE_URL=sc-domain:yinyangcmc.uk

# Google reviews sync (scripts/reviews-sync.mjs — see docs/reviews-sync.md)
GOOGLE_PLACES_API_KEY=
# GOOGLE_PLACES_ID=places/ChIJ...

# Optional: full carousel sync via Google Business Profile API
# GBP_ACCOUNT_ID=
# GBP_LOCATION_ID=
# GBP_TOKEN_PATH=secrets/gbp-oauth-token.json
# GBP_OAUTH_CLIENT_PATH=secrets/gbp-oauth-client.json
